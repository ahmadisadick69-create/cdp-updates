    ln(bx, yy0 - rh * (ri + 2), bx + tw, yy0 - rh * (ri + 2), 'SCHEDULE');\n  });\n  var yT = yy0 - rh * (rows + 2) + 1.6;\n  tx(bx + 1, yT, 'TOTAL MASS PER COLUMN = ' + CD.fmt(M.mass, 1) + ' kg     x ' + col.qty + ' No. = ' + CD.fmt(M.massAll, 1) + ' kg', 2.2, 'SCHEDULE', {bold: true});\n  var yAfter = yy0 - rh * (rows + 2) - 8;\n\n  /* ======================= NOTES ======================= */\n  var notes = buildNotes(P, col, M);\n  function wrap(t, w) {\n    var words = t.split(' '), out = [], cur = '';\n    words.forEach(function (wd) { if ((cur + ' ' + wd).trim().length > w) { out.push(cur); cur = wd; } else cur = (cur + ' ' + wd).trim(); });\n    if (cur) out.push(cur);\n    return out;\n  }\n  tx(bx, yAfter, 'GENERAL NOTES', 3, 'TEXT', {bold: true});\n  var ny = yAfter - 6;\n  notes.forEach(function (t, i) {\n    wrap(t, 105).forEach(function (l, j) {\n      tx(bx + (j ? 5 : 0), ny, (j ? '' : (i + 1) + '. ') + l, 2, 'TEXT');\n      ny -= 3.6;\n    });\n    ny -= 0.8;\n  });\n  // re-run notes drawing properly (noteAcc computed lazily above)\n  // north-less; sheet frame ticks\n  return {ents: ents, W: W, H: H, scale: sc, secScale: ss, sheet: sheetName, fit: fit, title: title, notes: notes};\n};\n\nfunction buildNotes(P, col, M) {\n  var aci = M.aci, mat = P.mat, N = [];\n  var S0 = M.secs[0];\n  N.push('ALL DIMENSIONS IN mm AND LEVELS IN m UNLESS NOTED. DO NOT SCALE FROM THIS DRAWING. READ WITH STRUCTURAL DESIGN AND GENERAL ARRANGEMENT DRAWINGS.');\n  if (aci) {\n    N.push(\"CONCRETE f'c = \" + mat.fck + \" MPa. REINFORCEMENT fy = \" + mat.fy + \" MPa (ASTM A615M, soft-metric bar sizes). TIES fyt = \" + mat.fyt + ' MPa.');\n    N.push('MINIMUM CLEAR COVER TO TIES ' + M.cover + ' mm. ALL BAR DIMENSIONS OUT-TO-OUT INCLUDING HOOKS A AND G (ACI 315 TABLE 1).');\n    N.push('COLUMN TIES: 135° HOOKS, ' + (col.link.hook === 135 ? 'ALTERNATE HOOK POSITION ON SUCCESSIVE TIES (ACI 315 FIG. 13). ' : '90° HOOKS ') + 'EVERY CORNER AND ALTERNATE VERTICAL BAR LATERALLY SUPPORTED; NO BAR MORE THAN 150 mm CLEAR FROM A SUPPORTED BAR. FIRST TIE NOT MORE THAN HALF SPACING ABOVE FLOOR.');\n    N.push('LAP SPLICES (COMPRESSION) = ' + M.joints.filter(function (j) { return j.k >= 0 && !j.skip; }).map(function (j) { return j.lap; }).filter(function (v, i, a) { return a.indexOf(v) === i; }).join(' / ') + ' mm PER ACI 318M. OFFSET BARS: SLOPE NOT STEEPER THAN 1:6; OFFSET < ' + P.opt.offsetLimit + ' mm BENT, OTHERWISE SEPARATE DOWELS; 3 CLOSELY SPACED TIES WITHIN 150 mm OF THE BEND (ACI 315 2.6.2/3.7.7.2).');\n    N.push('LOWER BARS TERMINATED FOR ANY REASON TO BE CUT OFF WITHIN 75 mm OF TOP OF FINISHED FLOOR (ACI 315 2.6.3). DOWELS FROM FOOTING SAME SIZE AND NUMBER AS COLUMN BARS.');\n    if (mat.seismic !== 'none') N.push('SEISMIC DETAILING (' + mat.seismic.toUpperCase() + '): HOOPS WITH 135° HOOKS, TAILS 6db (75 mm MIN); LAP SPLICES ONLY WITHIN CENTRE HALF OF CLEAR HEIGHT (HIGH RISK) - ACI 315 2.10.6/2.10.7, FIGS. 6 AND 17.');\n  } else {\n    N.push('CONCRETE ' + (CD.IST_GRADES.filter(function (g) { return g.fck === mat.fck; })[0] || {n: 'C' + mat.fck}).n + ', ' + mat.agg + ' mm AGGREGATE. REINFORCEMENT GRADE B' + mat.fy + ' (' + M.letter + ' = HIGH YIELD DEFORMED, BS 4449). BAR SHAPES TO BS 8666.');\n    N.push('NOMINAL COVER TO ALL REINFORCEMENT (LINKS) ' + M.cover + ' mm (' + mat.exposure.toUpperCase() + ', Δcdev = ' + mat.dcdev + ' mm). KICKER ' + M.kicker.up + ' mm ABOVE FLOOR, ' + M.kicker.found + ' mm BELOW GROUND UNLESS NOTED.');\n    N.push('COMPRESSION LAP = ' + M.joints.filter(function (j) { return !j.skip; }).map(function (j) { return j.lap; }).filter(function (v, i, a) { return a.indexOf(v) === i; }).join(' / ') + ' mm (IStructE TABLE 6.5). STARTERS PROJECT COMPRESSION LAP + KICKER + ' + (M.starter.tol || 0) + ' mm FOR FOUNDATION LEVEL TOLERANCE (MC1).');\n    N.push('LINK SPACING NOT GREATER THAN LEAST OF 20 x BAR Ø, LEAST COLUMN DIMENSION, 400 mm; x0.6 WITHIN LARGER COLUMN DIMENSION ABOVE AND BELOW BEAM/SLAB; AT LAPS NOT GREATER THAN 12 x BAR Ø, 0.6 x LEAST DIMENSION, 240 mm WITH AT LEAST 3 LINKS (MC1-MC5).');\n    N.push('UPPER BARS CRANKED AT 1:10 AT LAPS (LENGTH = 10 x OFFSET) WITH A LINK AT THE KNUCKLE OF THE CRANK (MC2). WHERE COLUMN SECTION CHANGES SPLICE BARS ARE USED (MC3).');\n    N.push('EVERY CORNER BAR AND ALTERNATE BAR RETAINED BY A LINK; ALL OTHER BARS WITHIN 150 mm OF A RESTRAINED BAR (FIG. 6.24). LINKS WITH 135° HOOKS.');\n  }\n  N.push('THE CONTRACTOR TO CONFIRM CAGE FIT AND CLEARANCE WITH BEAM / SLAB REINFORCEMENT BEFORE FABRICATION. THIS SHEET IS A DETAILING AID - DESIGN INFORMATION TO BE CONFIRMED BY THE ENGINEER OF RECORD.');\n  return N;\n}\nCD.buildNotes = buildNotes;\n\n})();\n\n/* ==== 25-pro.js ==== */\n/* ==========================================================================\n   \"PRO\" DRAWING STYLE  -  reproduces the detailing convention of the\n   reference drawing DETAIL_PRO.pdf (AutoCAD plot, column C1 250x250, 24 Nos):\n   single clean elevation + SECTION 1-1, no schedule on the sheet.\n   Paper units: mm.  Geometry (levels, laps, cranks) comes from CD.compute().\n   ========================================================================== */\n(function () {\n'use strict';\n\nCD.defaultStyle = function () {\n  return {\n    mode: 'pro', mono: true,\n    txtH: 2.3, titleH: 4.4, subH: 2.3, secTxtH: 0.9, secTitleH: 1.1, secPaper: 0,\n    marginTop: 24, marginBottom: 32,\n    barLine: 'link',                 // thick line drawn at link centre-line ('link') or true bar centre ('bar')\n    slabHalf: 575, breakOver: 130, breakA: 0.28, breakB: 0.74, breakDx: 104,\n    fitExact: true,\n    showArrows: true, showLinkMark: true, showJointLink: true, showKicker: true, showGL: true,\n    showSection: true, showCut: true, showDims: true, showTitle: true, showFoot: false, border: false,\n    sameMarks: true, elevText: '', secText: '',\n    wHair: 0.09, wThin: 0.13, wMed: 0.25, wThick: 0.50\n  };\n};\nCD.ensureStyle = function (P) {\n  var d = CD.defaultStyle();\n  P.style = Object.assign(d, P.style || {});\n  return P.style;\n};\n\n/* Apply the DETAIL_PRO.pdf conventions to a project / column */\nCD.applyProPreset = function (P, col) {\n  P.style = CD.defaultStyle();\n  P.sheet.size = 'A3'; P.sheet.scale = 0; P.sheet.secScale = 0;\n  col.link.uniform = true; col.link.sOverride = col.link.sOverride > 0 ? col.link.sOverride : 150; col.link.jointLinks = false;\n  col.kicker.h = 75; col.kicker.hBelow = 75;\n  col.lapOpt.mode = 'manual'; col.lapOpt.val = 900;\n  col.starter.foot = 'out';\n  col.base.glDepth = 450; if (!(col.base.belowGL > 0)) col.base.belowGL = 1500;\n  col.base.gSlab = 300; col.base.ftg.lean = 50;\n  return P;\n};\n\nCD.buildSheetPro = function (P, col, M, opt) {\n  var sty = CD.ensureStyle(P);\n  var code = P.code, aci = M.aci, circ = col.shape === 'circ', letter = M.letter;\n  var view = P.sheet.elevView || 'b';\n  var ents = [];\n  var WH = sty.wHair, WT = sty.wThin, WM = sty.wMed, WK = sty.wThick;\n  function ln(x1, y1, x2, y2, layer, w, lt) { ents.push({t: 'line', x1: x1, y1: y1, x2: x2, y2: y2, layer: layer, w: w, lt: lt || ''}); }\n  function pl(pts, closed, layer, w, lt) { ents.push({t: 'pl', pts: pts, closed: !!closed, layer: layer, w: w, lt: lt || ''}); }\n  function ci(cx, cy, r, layer, fill, w) { ents.push({t: 'ci', cx: cx, cy: cy, r: r, layer: layer, fill: !!fill, w: w}); }\n  function so(pts, layer) { ents.push({t: 'so', pts: pts, layer: layer}); }\n  function tx(x, y, str, h, layer, o) { o = o || {}; ents.push({t: 'tx', x: x, y: y, str: String(str), h: h, layer: layer || 'TEXT', ha: o.ha || 'l', va: o.va || 'b', rot: o.rot || 0, bold: !!o.bold}); }\n  function tw(str, h) { return String(str).length * h * 0.69; }\n  function rect(x1, y1, x2, y2, layer, w) { pl([[x1, y1], [x2, y1], [x2, y2], [x1, y2]], true, layer, w); }\n  function rrect(x1, y1, x2, y2, r, layer, w) {          // rounded rectangle polyline\n    var pts = [], k, a;\n    function arc(cx, cy, a0) { for (k = 0; k <= 5; k++) { a = (a0 + 90