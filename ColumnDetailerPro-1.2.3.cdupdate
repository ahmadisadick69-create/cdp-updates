2], p[3]), d30 = dist(p[3], p[0]);\n  var m = Math.max(d01, d12, d23, d30);\n  if (m <= 0) return null;\n  var tol = 0.01 * m + 1e-9;\n  if (Math.abs(d01 - d23) > tol || Math.abs(d12 - d30) > tol) return null;\n  var dg1 = dist(p[0], p[2]), dg2 = dist(p[1], p[3]);\n  if (Math.abs(dg1 - dg2) > 0.02 * m + 1e-9) return null;   // right angles\n  var ang = Math.atan2(p[1][1] - p[0][1], p[1][0] - p[0][0]) * 180 / Math.PI;\n  return {cx: (p[0][0] + p[2][0]) / 2, cy: (p[0][1] + p[2][1]) / 2, w: (d01 + d23) / 2, h: (d12 + d30) / 2, ang: ang};\n}\nfunction key2(p, t) { return Math.round(p[0] / t) + ',' + Math.round(p[1] / t); }\n\n/* join loose LINEs into 4-cycles (rectangles) */\nfunction rectsFromLines(lines) {\n  var out = [], used = {}, i, j;\n  if (!lines.length) return out;\n  var ext = 0; lines.forEach(function (l) { ext = Math.max(ext, Math.hypot(l.x2 - l.x1, l.y2 - l.y1)); });\n  var tol = Math.max(1e-6, ext * 1e-4), map = {};\n  lines.forEach(function (l, ix) {\n    [[l.x1, l.y1], [l.x2, l.y2]].forEach(function (pt) {\n      var k = key2(pt, tol); (map[k] = map[k] || []).push(ix);\n    });\n  });\n  function other(l, pt) { return dist([l.x1, l.y1], pt) < tol * 2 ? [l.x2, l.y2] : [l.x1, l.y1]; }\n  function near(pt) {\n    var res = [], dx, dy;\n    for (dx = -1; dx <= 1; dx++) for (dy = -1; dy <= 1; dy++) {\n      var k = (Math.round(pt[0] / tol) + dx) + ',' + (Math.round(pt[1] / tol) + dy);\n      (map[k] || []).forEach(function (ix) { if (res.indexOf(ix) < 0) res.push(ix); });\n    }\n    return res;\n  }\n  lines.forEach(function (l0, i0) {\n    if (used[i0]) return;\n    var L = Math.hypot(l0.x2 - l0.x1, l0.y2 - l0.y1);\n    if (L < tol * 5 || L > ext) return;\n    // walk 4 edges\n    var path = [i0], pts = [[l0.x1, l0.y1], [l0.x2, l0.y2]], cur = [l0.x2, l0.y2], ok = true, step;\n    for (step = 1; step < 4 && ok; step++) {\n      var cand = near(cur).filter(function (ix) { return path.indexOf(ix) < 0 && !used[ix]; });\n      if (!cand.length) { ok = false; break; }\n      var nx = cand[0];\n      path.push(nx);\n      cur = other(lines[nx], cur);\n      pts.push(cur);\n    }\n    if (!ok) return;\n    if (dist(cur, pts[0]) > tol * 3) return;\n    pts = pts.slice(0, 4);\n    var r = rectFromPts(pts);\n    if (r) { out.push(r); path.forEach(function (ix) { used[ix] = true; }); }\n  });\n  return out;\n}\n\n/* ---- main analysis ---- */\n/* opts: {layers:{name:true}, unit: 'auto'|1|4|5|6, minSize, maxSize, tol, labelRadius} */\nCD.importAnalyze = function (parsed, opts) {\n  opts = opts || {};\n  var ents = parsed.ents || [], layerSel = opts.layers || null;\n  var res = {cands: [], groups: [], checks: [], unit: null, unitNote: '', layers: {}, nTexts: 0, nEnts: ents.length, mmPerUnit: 1};\n  var inSel = function (e) { return !layerSel || layerSel[e.layer] !== false; };\n\n  // layer census\n  ents.forEach(function (e) {\n    var L = res.layers[e.layer] = res.layers[e.layer] || {n: 0, rect: 0, circ: 0, text: 0};\n    L.n++;\n  });\n\n  var rects = [], circles = [], texts = [], lines = [];\n  ents.forEach(function (e) {\n    if (!inSel(e)) return;\n    if (e.t === 'pl' && e.closed !== false && e.pts && (e.pts.length === 4 || e.pts.length === 5)) {\n      var pts = e.pts.map(function (p) { return [p[0], p[1]]; });\n      var closedByPts = e.pts.length === 5;\n      if (e.closed || closedByPts) {\n        var r = rectFromPts(pts);\n        if (r) { r.layer = e.layer; rects.push(r); res.layers[e.layer].rect++; }\n      }\n    } else if (e.t === 'line') lines.push(e);\n    else if (e.t === 'ci' && !e.fill) { circles.push(e); }\n    else if (e.t === 'tx' && e.str) { texts.push(e); }\n  });\n  // lines → rectangles (only layers selected)\n  rectsFromLines(lines).forEach(function (r) { r.layer = 'LINES'; rects.push(r); });\n  // layer for line-built rects: use the layer of nearest line\n  if (lines.length) {\n    rects.forEach(function (r) {\n      if (r.layer !== 'LINES') return;\n      var best = null, bd = 1e30;\n      lines.forEach(function (l) { var d = Math.hypot((l.x1 + l.x2) / 2 - r.cx, (l.y1 + l.y2) / 2 - r.cy); if (d < bd) { bd = d; best = l; } });\n      r.layer = best ? best.layer : '0';\n      res.layers[r.layer].rect++;\n    });\n  }\n  circles.forEach(function (c) { res.layers[c.layer].circ++; });\n  texts.forEach(function (t) { res.layers[t.layer].text++; });\n  res.nTexts = texts.length;\n\n  // unit\n  var u = opts.unit && opts.unit !== 'auto' ? +opts.unit : (parsed.units || 0);\n  if (!UNIT_MM[u]) {\n    // guess from median of rectangle shorter side\n    var sides = rects.map(function (r) { return Math.min(r.w, r.h); }).concat(circles.map(function (c) { return 2 * c.r; })).sort(function (a, b) { return a - b; });\n    var med = sides.length ? sides[sides.length >> 1] : 300;\n    if (med >= 100 && med <= 2500) u = 4; else if (med >= 10 && med < 100) u = 5; else if (med >= 0.1 && med < 3) u = 6; else if (med >= 3 && med < 10) u = 1; else u = 4;\n    res.unitNote = 'Unit not defined in file - guessed ' + UNIT_NAMES[u] + ' from typical size ' + CD.fmt(med, 2) + '.';\n    res.unitGuessed = true;\n  }\n  res.unit = u; res.mmPerUnit = UNIT_MM[u];\n  var k = res.mmPerUnit;\n\n  var minS = opts.minSize || 150, maxS = opts.maxSize || 1500;\n  var raw = [];\n  rects.forEach(function (r) {\n    var w = r.w * k, h = r.h * k, a = r.ang;\n    var b = Math.min(w, h), d = Math.max(w, h);\n    // orientation: along-x dimension = w if ang≈0/180, h if ≈90\n    var an = ((a % 180) + 180) % 180;\n    var rot = (Math.abs(an) < 1 || Math.abs(an - 180) < 1) ? 0 : (Math.abs(an - 90) < 1 ? 90 : an);\n    var X = rot === 90 ? h : w, Y = rot === 90 ? w : h;   // size along global X, Y\n    raw.push({shape: 'rect', cx: r.cx, cy: r.cy, bx: X, hy: Y, b: b, h: d, rotDeg: rot, odd: (rot !== 0 && rot !== 90), layer: r.layer});\n  });\n  circles.forEach(function (c) {\n    raw.push({shape: 'circ', cx: c.cx, cy: c.cy, D: 2 * c.r * k, bx: 2 * c.r * k, hy: 2 * c.r * k, b: 2 * c.r * k, h: 2 * c.r * k, rotDeg: 0, layer: c.layer});\n  });\n  // size filter\n  var tooSmall = 0, tooBig = 0;\n  raw = raw.filter(function (c) {\n    if (c.b < 50) { tooSmall++; return false; }\n    if (c.h > maxS * 4) { tooBig++; return false; }   // sheet border, grid boxes\n    return true;\n  });\n\n  // concentric circles / nested rects (e.g. column inside pedestal, or hatch boxes) -> keep outer for rect/rect, flag\n  var nested = [];\n  raw.forEach(function (a, i) {\n    raw.forEach(function (b, j) {\n      if (i === j || a.dead || b.dead) return;\n      if (Math.hypot(a.cx - b.cx, a.cy - b.cy) * k < 5 && a.shape === b.shape) {\n        var sa = a.b * a.h, sb = b.b * b.h;\n        if (Math.abs(sa - sb) / Math.max(sa, sb) < 1e-3) { b.dead = true; b.dup = true; }   // exact duplicate\n        else if (sa > sb) { b.dead = true; nested.push({inner: b, outer: a}); }\n      }\n    });\n  });\n  var dupCount = raw.filter(function (c) { return c.dup; }).length;\n  var cands = raw.filter(function (c) { return !c.dead; });\n\n  // label association: texts matching regex; nearest column within radius; each text used by nearest column only\n  var labelTexts = texts.filter(function (t) { return LABEL_RE.test(t.str.trim()); }).map(function (t) { return {s: t.str.trim().toUpperCase().replace(/[ _.]/g, '-'), x: t.x, y: t.y, used: 0, ent: t}; });\n  var other = texts.filter(function (t) { return !LABEL_RE.test(t.str.trim()); });\n  cands.forEach(function (c) {\n    var best = null, bd = 1e30, R = (opts.labelRadius || 3) * Math.max(c.bx, c.hy) / k;\n    labelTexts.forEach(function (t) {\n      var inside = Math.abs(t.x - c.cx) * k <= c.bx / 2 && Math.abs(t.y - c.cy) * k <= c.hy / 2;\n      var d = Math.hypot(t.x - c.cx, t.y - c.cy) - (inside ? 1e9 : 0);\n      if (d < bd && (inside || Math.hypot(t.x - c.cx, t.y - c.cy) <= R)) { bd = d; best = t; }\n    });\n    c.cands = [];\n    if (best) { c.label = best.s; best.used++; }\n  });\n  // text inside rectangles, e.g. \"300x300\" size tags → note\n  var sizeTags = other.filter(function (t) { return /^\\s*\\d{2,4}\\s*[xX×]\\s*\\d{2,4}\\s*$/.test(t.str); });\n  cands.forEach(function (c) {\n    sizeTags.forEach(function (t) {\n      if (Math.hypot(t.x - c.cx, t.y - c.cy) * k < Math.max(c.bx, c.hy) * 2.2) {\n        var m = t.str.match(/(\\d+)\\s*[xX×]\\s*(\\d+)/); c.tag = [+m[1], +m[2]];\n      }\n    });\n  });\n\n  // classification flags\n  var tolS = opts.tol || 5;\n  cands.forEach(function (c, i) {\n    c.id = i + 1;\n    c.flags = [];\n    var asp = c.h / c.b;\n    if (c.shape === 'rect') {\n      c.b = Math.round(c.b * 10) / 10; c.h = Math.round(c.h * 10) / 10;\n      if (asp > 4) c.flags.push('wall');\n      if (c.b < 200) c.flags.push('small');\n      if (c.odd) c.flags.push('angled');\n      else if (c.rotDeg === 90) c.rotated = true;\n      if (Math.abs(c.b % 25) > 0.6 && Math.abs(c.b % 25 - 25) > 0.6 || Math.abs(c.h % 25) > 0.6 && Math.abs(c.h % 25 - 25) > 0.6) c.flags.push('nonmodular');\n    } else {\n      c.D = Math.round(c.D * 10) / 10;\n      if (c.D < 250) c.flags.push('small');\n      if (Math.abs(c.D % 25) > 0.6 && Math.abs(c.D % 25 - 25) > 0.6) c.flags.push('nonmodular');\n    }\n    if (!c.label) c.flags.push('nolabel');\n    if (c.tag && c.shape === 'rect') {\n      var tb = Math.min(c.tag[0], c.tag[1]), th = Math.max(c.tag[0], c.tag[1]);\n      if (Math.abs(tb - c.b) > tolS || Math.abs(th - c.h) > tolS) c.flags.push('tagmismatch');\n    }\n  });\n\n  // grouping: key by label when present, else by size\n  function sizeKey(c) {\n    return c.shape === 'circ' ? 'O' + Math.round(c.D / tolS) * tolS : Math.round(c.b / tolS) * tolS + 'x' + Math.round(c.h / tolS) * tolS;\n  }\n  var gmap = {}, groups = [];\n  cands.forEach(function (c) {\n    var key = sizeKey(c);\n    var g = gmap[key];\n    if (!g) {\n      g = gmap[key] = {id: groups.length + 1, key: key, shape: c.shape, b: c.b, h: c.h, D: c.D, members: [], labels: {}, flags: {}};\n      groups.push(g);\n    }\n    g.members.push(c); c.group = g;\n    if (c.label) g.labels[c.label] = (g.labels[c.label] || 0) + 1;\n    c.flags.forEach(function (f) { g.flags[f] = (g.flags[f] || 0) + 1; });\n  });\n  // group naming\n  var auto = 0;\n  groups.forEach(function (g) {\n    var lbs = Object.keys(g.labels).sort(function (a, b) { return g.labels[b] - g.labels[a]; });\n    g.labelList = lbs;\n    g.mark = lbs.length ? lbs[0] : 'C' + (++auto + 900);\n    g.qty = g.members.length;\n    g.include = true;\n  });\n  // sort by size desc, then renumber auto marks sequentially\n  groups.sort(function (a, b) { return (b.shape === 'circ' ? b.D * b.D : b.b * b.h) - (a.shape === 'circ' ? a.D * a.D : a.b * a.h); });\n  var an = 0; groups.forEach(function (g, i) { g.id = i + 1; if (!g.labelList.length) g.mark = 'CX' + (++an); });\n\n  // checks\n  var C = res.checks;\n  function add(level, msg, ids) { C.push({level: level, msg: msg, ids: ids || []}); }\n  if (!cands.length) add('err', 'No columns found. Select the layer that holds the column outlines (closed rectangles / circles), or check units.');\n  if (res.unitNote) add('warn', res.unitNote + ' Override the unit if sizes below look wrong.');\n  if (tooSmall) add('info', tooSmall + ' very small closed shapes (<50 mm) ignored.');\n  if (tooBig) add('info', tooBig + ' very large shapes (sheet border / grid boxes) ignored.');\n  if (dupCount) add('warn', dupCount + ' duplicate outline(s) drawn on top of each other were merged (counting corrected).', []);\n  if (nested.length) add('info', nested.length + ' nested outline(s) (e.g. pedestal or hatch box inside a column) - inner shape ignored.');\n  var nl = cands.filter(function (c) { return !c.label; });\n  if (nl.length) add('warn', nl.length + ' column(s) have no label text nearby - they are grouped by size and given temporary marks (CX1…). Rename before detailing.', nl.map(function (c) { return c.id; }));\n  var wl = cands.filter(function (c) { return c.flags.indexOf('wall') >= 0; });\n  if (wl.length) add('warn', wl.length + ' shape(s) have aspect ratio > 4 : they look like walls / shear walls, not columns. Untick them if so.', wl.map(function (c) { return c.id; }));\n  var sm = cands.filter(function (c) { return c.flags.indexOf('small') >= 0; });\n  if (sm.length) add('warn', sm.length + ' column(s) smaller than the usual minimum (200 mm). Check units or whether they are posts / bolt boxes.', sm.map(function (c) { return c.id; }));\n  var nm = cands.filter(function (c) { return c.flags.indexOf('nonmodular') >= 0; });\n  if (nm.length) add('info', nm.length + ' column(s) have dimensions that are not a multiple of 25 mm (check, or ignore if intended).', nm.map(function (c) { return c.id; }));\n  var an2 = cands.filter(function (c) { return c.flags.indexOf('angled') >= 0; });\n  if (an2.length) add('info', an2.length + ' column(s) are drawn at an angle to the grid; sizes are taken along their own sides.', an2.map(function (c) { return c.id; }));\n  var rt = cands.filter(function (c) { return c.rotated; });\n  if (rt.length) add('info', rt.length + ' rectangular column(s) are turned 90° - grouped with same-size columns (b × h swapped). Section orientation on the sheet is for the group mark; confirm orientation per column.', rt.map(function (c) { return c.id; }));\n  var tm = cands.filter(function (c) { return c.flags.indexOf('tagmismatch') >= 0; });\n  if (tm.length) add('warn', tm.length + ' column(s) have a size text (e.g. 300x300) that disagrees with the drawn outline.', tm.map(function (c) { return c.id; }));\n  // same label, different sizes  /  same size, different labels\n  var byLabel = {};\n  cands.forEach(function (c) { if (c.label) { (byLabel[c.label] = byLabel[c.label] || {})[sizeKey(c)] = true; } });\n  Object.keys(byLabel).forEach(function (l) {\n    var n = Object.keys(byLabel[l]).length;\n    if (n > 1) add('err', 'Label ' + l + ' is used on ' + n + ' different sizes (' + Object.keys(byLabel[l]).join(', ') + ') - it will be split into separate marks; rename or confirm.', []);\n  });\n  groups.forEach(function (g) {\n    if (g.labelList.length > 1) add('info', 'Size ' + g.key + ' carries ' + g.labelList.length + ' labels (' + g.labelList.join(', ') + '). Choose whether to detail as one grouped mark or separately (they may differ in reinforcement).', []);\n  });\n  // unused labels / texts\n  var unused = labelTexts.filter(function (t) { return t.used === 0; });\n  if (unused.length) add('info', unused.length + ' label text(s) were not matched to a column (' + unused.slice(0, 6).map(function (t) { return t.s; }).join(', ') + (unused.length > 6 ? ' …' : '') + ').');\n  var multi = labelTexts.filter(function (t) { return t.used > 1; });\n  if (multi.length) add('warn', multi.length + ' label(s) are the nearest label of more than one column - check marks.', []);\n  var hasC = cands.some(function (c) { return c.shape === 'circ'; }), hasR = cands.some(function (c) { return c.shape === 'rect'; });\n  if (hasC && hasR) add('info', 'Plan contains both circular and rectangular columns; both are imported (circular detailed with helix / rings).');\n  var large = cands.filter(function (c) { return c.shape === 'rect' && c.h > 1200; });\n  if (large.length) add('info', large.length + ' column(s) larger than 1200 mm - consider confirming they are columns, not pedestals.', large.map(function (c) { return c.id; }));\n  // closeness – overlapping outlines\n  var ov = 0;\n  for (var i = 0; i < cands.length; i++) for (var j = i + 1; j < cands.length; j++) {\n    var a = cands[i], b = cands[j];\n    if (Math.abs(a.cx - b.cx) * k < (a.bx + b.bx) / 2 - 20 && Math.abs(a.cy - b.cy) * k < (a.hy + b.hy) / 2 - 20) ov++;\n  }\n  if (ov) add('warn', ov + ' pair(s) of column outlines overlap - possible duplicate or coupled columns.');\n  if (cands.length && !C.some(function (x) { return x.level === 'err' || x.level === 'warn'; })) add('ok', 'No problems detected: ' + cands.length + ' column(s) in ' + groups.length + ' group(s).');\n\n  res.cands = cands; res.groups = groups;\n  // plan extents\n  var xs = cands.map(function (c) { return c.cx; }), ys = cands.map(function (c) { return c.cy; });\n  res.bounds = cands.length ? {x1: Math.min.apply(null, xs), x2: Math.max.apply(null, xs), y1: Math.min.apply(null, ys), y2: Math.max.apply(null, ys)} : null;\n  return res;\n};\n\n/* default walls etc. excluded from include */\nCD.importDefaultSelection = function (res) {\n  res.cands.forEach(function (c) { c.include = c.flags.indexOf('wall') < 0; });\n  CD.importRegroup(res);\n};\nCD.importRegroup = function (res) {\n  res.groups.forEach(function (g) {\n    g.qty = g.members.filter(function (c) { return c.include !== false; }).length;\n  });\n};\n\n/* Build project columns from analysis.\n   mode: 'single'  – only the chosen candidate id (opts.pick) → 1 column, qty 1\n         'multiple'– every included column becomes its own mark (label or CX#)  qty 1 each (or qty by label)\n         'grouped' – one mark per group, qty = count (uses group.mark, editable) */\nCD.importBuild = function (P, res, mode, opts) {\n  opts = opts || {};\n  var code = P.code, made = [];\n  function mk(mark, c, qty) {\n    var col = CD.defaultColumn(code, 1);\n    col.mark = mark; col.qty = qty;\n    if (c.shape === 'circ') { col.shape = 'circ'; col.typ.D = Math.round(c.D); col.typ.n = Math.max(6, Math.round(Math.PI * c.D / 200)); }\n    else { col.shape = 'rect'; col.typ.b = Math.round(c.b); col.typ.h = Math.round(c.h); col.typ.nb = c.b >= 450 ? 4 : 3; col.typ.nh = c.h >= 450 ? 4 : 3; }\n    col.st.forEach(function (s) { s.b = col.typ.b; s.h = col.typ.h; s.D = col.typ.D; s.nb = col.typ.nb; s.nh = col.typ.nh; s.n = col.typ.n; });\n    var pr = CD.proposeBars ? CD.proposeBars(P, col.shape, col.typ) : null;\n    if (pr) {\n      col.typ.des = pr.des;\n      if (col.shape === 'circ') col.typ.n = pr.n; else { col.typ.nb = pr.nb; col.typ.nh = pr.nh; }\n      col.st.forEach(function (s) { s.des = col.typ.des; s.nb = col.typ.nb; s.nh = col.typ.nh; s.n = col.typ.n; });\n    }\n    col.fromImport = {ids: c.members ? c.members.map(function (m) { return m.id; }) : [c.id]};\n    return col;\n  }\n  var sel = res.cands.filter(function (c) { return c.include !== false; });\n  if (mode === 'single') {\n    var c = res.cands.filter(function (x) { return x.id === opts.pick; })[0] || sel[0];\n    if (c) made.push(mk(c.label || (opts.mark || 'C1'), c, 1));\n  } else if (mode === 'multiple') {\n    var used = {};\n    sel.forEach(function (c, i) {\n      var m = c.label || ('C' + (i + 1));\n      if (used[m]) { var n = 2; while (used[m + '-' + n]) n++; m = m + '-' + n; }\n      used[m] = true;\n      made.push(mk(m, c, 1));\n    });\n  } else {\n    res.groups.forEach(function (g) {\n      var mem = g.members.filter(function (c) { return c.include !== false; });\n      if (!g.include || !mem.length) return;\n      made.push(mk(g.mark, {shape: g.shape, b: g.b, h: g.h, D: g.D, members: mem}, mem.length));\n    });\n  }\n  return made;\n};\n\n/* ---- mini-plan preview SVG ---- */\nCD.importPreviewSVG = function (res, W, H, hiId) {\n  if (!res.cands.length) return '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"' + W + '\" height=\"' + H + '\"></svg>';\n  var k = res.mmPerUnit, x1 = 1e30, y1 = 1e30, x2 = -1e30, y2 = -1e30;\n  res.cands.forEach(function (c) {\n    var hw = c.bx / k / 2, hh = c.hy / k / 2;\n    x1 = Math.min(x1, c.cx - hw); x2 = Math.max(x2, c.cx + hw); y1 = Math.min(y1, c.cy - hh); y2 = Math.max(y2, c.cy + hh);\n  });\n  var pad = 0.05 * Math.max(x2 - x1, y2 - y1, 1), dx = x2 - x1 + 2 * pad, dy = y2 - y1 + 2 * pad, s = Math.min(W / dx, H / dy);\n  var pal = ['#4da3ff', '#ff7a59', '#4cd68a', '#e5c04a', '#c07aff', '#35d0d0', '#ff6fb1', '#9aa7b5'];\n  var out = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"' + W + '\" height=\"' + H + '\" viewBox=\"0 0 ' + W + ' ' + H + '\" font-family=\"Consolas,monospace\">';\n  res.cands.forEach(function (c) {\n    var g = c.group, col = pal[(g.id - 1) % pal.length], px = (c.cx - x1 + pad) * s, py = H - (c.cy - y1 + pad) * s;\n    var w = Math.max(3, c.bx / k * s), h = Math.max(3, c.hy / k * s);\n    var off = c.include === false;\n    var stroke = c.id === hiId ? '#fff' : col;\n    if (c.shape === 'circ') out += '<circle cx=\"' + px.toFixed(1) + '\" cy=\"' + py.toFixed(1) + '\" r=\"' + (w / 2).toFixed(1) + '\" fill=\"' + col + '\" fill-opacity=\"' + (off ? 0.08 : 0.35) + '\" stroke=\"' + stroke + '\" stroke-width=\"' + (c.id === hiId ? 2.5 : 1.2) + '\"/>';\n    else out += '<rect x=\"' + (px - w / 2).toFixed(1) + '\" y=\"' + (py - h / 2).toFixed(1) + '\" width=\"' + w.toFixed(1) + '\" height=\"' + h.toFixed(1) + '\" fill=\"' + col + '\" fill-opacity=\"' + (off ? 0.08 : 0.35) + '\" stroke=\"' + stroke + '\" stroke-width=\"' + (c.id === hiId ? 2.5 : 1.2) + '\"/>';\n    if (c.flags.length && c.flags.some(function (f) { return f !== 'nolabel' && f !== 'nonmodular'; })) out += '<circle cx=\"' + (px + w / 2).toFixed(1) + '\" cy=\"' + (py - h / 2).toFixed(1) + '\" r=\"3.5\" fill=\"#ff5a5a\"/>';\n    if (c.label && s * Math.max(c.bx, c.hy) / k > 16) out += '<text x=\"' + px.toFixed(1) + '\" y=\"' + (py + 3).toFixed(1) + '\" font-size=\"9\" text-anchor=\"middle\" fill=\"#fff\">' + c.label + '</text>';\n  });\n  return out + '</svg>';\n};\n\n/* ---- built-in sample plan (DXF, mm) with deliberate defects for demonstration ---- */\nCD.sampleDXF = function () {\n  var ents = [], i, j;\n  function rect(cx, cy, w, h, layer) { ents.push({t: 'pl', closed: true, layer: layer, pts: [[cx - w / 2, cy - h / 2], [cx + w / 2, cy - h / 2], [cx + w / 2, cy + h / 2], [cx - w / 2, cy + h / 2]]}); }\n  function txt(x, y, s, h, layer) { ents.push({t: 'tx', x: x, y: y, h: h || 150, str: s, layer: layer || 'TEXT', ha: 'l', va: 'b', rot: 0}); }\n  var xs = [0, 5000, 10000, 15000], ys = [0, 4500, 9000];\n  for (i = 0; i < xs.length; i++) for (j = 0; j < ys.length; j++) {\n    var corner = (i === 0 || i === 3) && (j === 0 || j === 2);\n    var lab = corner ? 'C1' : ((i === 0 || i === 3 || j === 0 || j === 2) ? 'C2' : 'C3');\n    var sz = lab === 'C1' ? [300, 300] : (lab === 'C2' ? [300, 450] : [400, 400]);\n    rect(xs[i], ys[j], sz[0], sz[1], 'S-COLS');\n    txt(xs[i] + 260, ys[j] + 260, lab, 130);\n  }\n  // extras / defects\n  ents.push({t: 'ci', cx: 20000, cy: 0, r: 250, layer: 'S-COLS', fill: false});\n  txt(20300, 260, 'C4', 130);\n  rect(20000, 4500, 275, 300, 'S-COLS'); txt(20260, 4760, 'C5', 130);          // non-modular\n  rect(20000, 9000, 300, 300, 'S-COLS');                                        // unlabeled\n  rect(7500, 13500, 4000, 200, 'S-COLS'); txt(7500, 13700, 'SW1', 130);         // wall\n  rect(0, 0, 300, 300, 'S-COLS');                                               // duplicate on top\n  rect(5000, 4500, 200, 200, 'S-COLS');                                         // nested inner\n  rect(24000, 0, 300, 300, 'S-COLS'); txt(24260, 260, 'C1', 130);                // same label ok\n  rect(24000, 4500, 350, 350, 'S-COLS'); txt(24300, 4800, 'C1', 130);           // C1 other size\n  rect(0, 14000, 600, 600, 'S-GRID');                                           // junk on another layer\n  return CD.writeDXF(ents, {scale: 1});\n};\n\n})();\n\n/* ==== 40-ui.js ==== */\n/* ==========================================================================\n   UI : splash, start screen, CAD workspace, forms, import dialog, exports\n   ========================================================================== */\n(function () {\n'use strict';\n\nvar $ = function (s, r) { return (r || document).querySelector(s); };\nvar $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };\nfunction esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;'); }\n\nvar S = {P: null, M: null, sheet: null, vb: null, hidden: {}, stale: true, lt: 'project', rt: 'checks', measure: null, ov: '', grid: true, startCode: 'IST', timer: null};\nCD.S = S;\n\n/* ------------------------------------------------------------ storage ---- */\nfunction lsGet(k) { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } }\nfunction lsSet(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { /* storage unavailable */ } }\nfunction pushRecent() {\n  if (!S.P) return;\n  var r = (lsGet('cdp.recent') || []).filter(function (x) { return x.name !== S.P.meta.job; });\n  r.unshift({name: S.P.meta.job, code: S.P.code, t: Date.now(), n: S.P.cols.length, data: S.P});\n  lsSet('cdp.recent', r.slice(0, 6));\n}\n\n/* ------------------------------------------------------------- helpers --- */\nfunction toast(msg, ms) { var t = $('#toast'); t.textContent = msg; t.style.display = 'block'; clearTimeout(toast.h); toast.h = setTimeout(function () { t.style.display = 'none'; }, ms || 2600); }\nfunction log(msg, cls) { var h = $('#hist'); if (!h) return; var d = document.createElement('div'); if (cls) d.className = cls; d.textContent = msg; h.appendChild(d); h.scrollTop = h.scrollHeight; }\nfunction col() { return S.P.cols[S.P.active] || S.P.cols[0]; }\nfunction isACI() { return S.P.code === 'ACI'; }\nfunction download(name, data, type) {\n  var b = data instanceof Blob ? data : new Blob([data], {type: type || 'text/plain'});\n  var a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = name; document.body.appendChild(a); a.click();\n  setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);\n}\nfunction fname(ext) { return (S.P.meta.job || 'project').replace(/[^\\w\\-]+/g, '_') + '_' + col().mark + ext; }\n\n/* -------------------------------------------------------- path binding --- */\nfunction resolve(path) {\n  var parts = path.split('.'), root = parts.shift(), o = root === 'P' ? S.P : col();\n  for (var i = 0; i < parts.length - 1; i++) o = o[parts[i]];\n  return {o: o, k: parts[parts.length - 1]};\n}\nfunction getP(path) { var r = resolve(path); return r.o[r.k]; }\nfunction setP(path, v) { var r = resolve(path); r.o[r.k] = v; }\n\n/* --------------------------------------------------------- form fields --- */\nfunction fld(path, label, o) {\n  o = o || {};\n  var v = getP(path), dis = o.dis ? ' disabled' : '', re = o.re ? ' data-re=\"1\"' : '', full = o.full ? ' full' : '';\n  if (o.t === 'c') return '<label class=\"f c' + full + '\"><input type=\"checkbox\" data-p=\"' + path + '\"' + (v ? ' checked' : '') + dis + re + '><span>' + label + '</span></label>';\n  if (o.t === 's') {\n    var ops = o.o.map(function (x) {\n      var val = Array.isArray(x) ? x[0] : x, lb = Array.isArray(x) ? x[1] : x;\n      return '<option value=\"' + esc(val) + '\"' + (String(val) === String(v) ? ' selected' : '') + '>' + esc(lb) + '</option>';\n    }).join('');\n    return '<label class=\"f' + full + '\"><span>' + label + '</span><div><select data-p=\"' + path + '\" data-k=\"' + (o.num ? 'n' : 's') + '\"' + dis + re + '>' + ops + '</select></div></label>';\n  }\n  if (o.t === 't') return '<label class=\"f' + full + '\"><span>' + label + '</span><div><input type=\"text\" data-p=\"' + path + '\" data-k=\"s\" value=\"' + esc(v) + '\"' + dis + re + '></div></label>';\n  return '<label class=\"f' + full + '\"><span>' + label + '</span><div><input type=\"number\" data-p=\"' + path + '\" data-k=\"n\" value=\"' + (v == null ? '' : v) + '\" step=\"' + (o.step || 'any') + '\"' + (o.min != null ? ' min=\"' + o.min + '\"' : '') + (o.max != null ? ' max=\"' + o.max + '\"' : '') + dis + re + '>' + (o.u ? '<i>' + o.u + '</i>' : '') + '</div></label>';\n}\nfunction grp(title, body, right) { return '<div class=\"grp\"><h5><span>' + title + '</span><span>' + (right || '') + '</span></h5><div>' + body + '</div></div>'; }\nfunction barOpts(lo, hi) {\n  var aci = isACI(), L = S.P.mat.letter || 'T';\n  return CD.barList(S.P.code).filter(function (d) { return aci ? true : (d >= lo && d <= hi); }).map(function (d) { return [d, aci ? '#' + d : L + d]; });\n}\nfunction barOptsAci(minNo, maxNo) { return CD.barList('ACI').filter(function (n) { return n >= minNo && n <= maxNo; }).map(function (n) { return [n, '#' + n]; }); }\nfunction mainBars() { return isACI() ? barOptsAci(13, 57) : barOpts(12, 50); }\nfunction linkBars() { return isACI() ? barOptsAci(10, 16) : barOpts(6, 16); }\nfunction ftgBars() { return isACI() ? barOptsAci(10, 25) : barOpts(10, 32); }\n\n/* ============================================================ LEFT PANES == */\nvar LTABS = [['project', 'Project'], ['column', 'Column'], ['storeys', 'Storeys'], ['found', 'Foundation'], ['detail', 'Detailing'], ['style', 'Style']];\nfunction paneProject() {\n  var P = S.P, aci = isACI(), h = '';\n  h += grp('Project', fld('P.meta.job', 'Project title', {t: 't', full: 1}) + fld('P.meta.client', 'Client', {t: 't'}) + fld('P.meta.location', 'Location', {t: 't'}) +\n    fld('P.meta.drawingNo', 'Drawing No.', {t: 't'}) + fld('P.meta.rev', 'Revision', {t: 't'}) + fld('P.meta.drawnBy', 'Drawn by', {t: 't'}) + fld('P.meta.checkedBy', 'Checked by', {t: 't'}) + fld('P.meta.date', 'Date', {t: 't'}));\n  h += grp('Detailing code', fld('P.code', 'Code', {t: 's', o: [['IST', 'IStructE SMDSC (EC2, BS 8666)'], ['ACI', 'ACI 315-99 (ACI 318M)']], full: 1, re: 1}) +\n    '<div class=\"note\">Changing the code resets bar sizes, cover and kicker to that code\\'s defaults.</div>');\n  if (!aci) {\n    h += grp('Materials — IStructE / EC2',\n      fld('P.mat.fck', 'Concrete grade', {t: 's', num: 1, o: CD.IST_GRADES.map(function (g) { return [g.fck, g.n]; })}) +\n      fld('P.mat.letter', 'Bar letter (grade)', {t: 's', o: [['T', 'T — B500B/C'], ['H', 'H — high yield'], ['Y', 'Y — high yield (alt.)']], re: 1}) +\n      fld('P.mat.fy', 'Bar fyk', {u: 'MPa'}) + fld('P.mat.fyt', 'Link fyk', {u: 'MPa'}) +\n      fld('P.mat.exposure', 'Exposure', {t: 's', o: [['internal', 'Internal (30 + Δc)'], ['external', 'External (35 + Δc)']]}) +\n      fld('P.mat.dcdev', 'Δcdev', {t: 's', num: 1, o: [[5, '5 mm'], [10, '10 mm']]}) +\n      fld('P.mat.agg', 'Max. aggregate', {u: 'mm'}) + fld('P.mat.ned', 'Axial load NEd', {u: 'kN'}) +\n      '<div class=\"note\">NEd is only used for the minimum bar area check (0.10·NEd/fyd).</div>');\n  } else {\n    h += grp('Materials — ACI 318M',\n      fld('P.mat.fck', \"f'c\", {t: 's', num: 1, o: CD.ACI_FC.map(function (v) { return [v, v + ' MPa']; })}) +\n      fld('P.mat.fy', 'Bar fy', {u: 'MPa'}) + fld('P.mat.fyt', 'Tie fyt', {u: 'MPa'}) +\n      fld('P.mat.seismic', 'Seismic detailing', {t: 's', o: [['none', 'None (ordinary)'], ['moderate', 'Moderate (intermediate)'], ['high', 'High (special)']]}) +\n      fld('P.mat.agg', 'Max. aggregate', {u: 'mm'}));\n  }\n  h += grp('Drawing sheet',\n    fld('P.sheet.size', 'Sheet size', {t: 's', o: [['auto', 'Auto (smallest fitting)']].concat(Object.keys(CD.SHEETS).filter(function (k) { return k !== 'A4'; }))}) +\n    fld('P.sheet.scale', 'Elevation scale', {t: 's', num: 1, o: [[0, 'Auto']].concat(CD.SCALES.map(function (s) { return [s, '1:' + s]; }))}) +\n    fld('P.sheet.secScale', 'Section scale', {t: 's', num: 1, o: [[0, 'Auto'], [10, '1:10'], [20, '1:20'], [25, '1:25'], [30, '1:30']]}) +\n    fld('P.sheet.elevView', 'Elevation view', {t: 's', o: [['b', 'Looking along h (b-face)'], ['h', 'Looking along b (h-face)']]}) +\n    fld('P.opt.offsetLimit', aci ? 'Offset limit (ACI: bent < limit)' : 'Offset limit', {u: 'mm'}) +\n    fld('P.opt.showLinks', 'Show links in elevation', {t: 'c', full: 1}));\n  return h;\n}\nfunction paneColumn() {\n  var c = col(), P = S.P, aci = isACI(), circ = c.shape === 'circ', h = '', T = c.typ;\n  h += grp('Column mark', fld('c.mark', 'Mark', {t: 't'}) + fld('c.qty', 'Number of columns', {min: 1, step: 1}) +\n    fld('c.shape', 'Section shape', {t: 's', o: [['rect', 'Rectangular'], ['circ', 'Circular']], re: 1}) +\n    fld('c.pos', 'Position (top bars)', {t: 's', o: [['internal', 'Internal'], ['edge', 'Edge'], ['corner', 'Corner']]}));\n  var tipS = c.vary ? '<div class=\"note\">Different section per storey is ON — edit sizes/bars in the STOREYS tab. Values below are the typical section.</div>' : '';\n  var body = '';\n  if (circ) body += fld('c.typ.D', 'Diameter D', {u: 'mm', step: 25}) + fld('c.typ.n', 'Number of bars', {min: 6, step: 1}); else body += fld('c.typ.b', 'Width b', {u: 'mm', step: 25}) + fld('c.typ.h', 'Depth h', {u: 'mm', step: 25}) + fld('c.typ.nb', 'Bars along b (per face)', {min: 2, step: 1}) + fld('c.typ.nh', 'Bars along h (per face)', {min: 2, step: 1});\n  body += fld('c.typ.des', 'Main bar', {t: 's', num: 1, o: mainBars()}) + fld('c.typ.linkDes', aci ? 'Tie bar' : 'Link bar', {t: 's', num: 1, o: linkBars()});\n  var Ac = circ ? Math.PI * T.D * T.D / 4 : T.b * T.h, N = circ ? T.n : 2 * (T.nb + T.nh) - 4, As = N * CD.bar(P.code, T.des).area;\n  body += '<div class=\"info\">' + N + ' bars · As = ' + CD.fmt(As, 0) + ' mm² · ρ = ' + CD.fmt(100 * As / Ac, 2) + ' %</div>';\n  body += fld('c.vary', 'Different section at each storey', {t: 'c', full: 1, re: 1}) + tipS +\n    '<button class=\"btn\" data-act=\"applyTyp\" style=\"grid-column:1/3;justify-content:center\">Apply typical to all storeys</button>' +\n    '<button class=\"btn\" data-act=\"propose\" style=\"grid-column:1/3;justify-content:center\">Auto-propose bars for this size</button>';\n  h += grp('Typical section', body);\n  h += grp('Column marks in project', '<div style=\"grid-column:1/3;display:flex;gap:6px;flex-wrap:wrap\"><button class=\"btn sm\" data-act=\"addCol\">+ New column</button><button class=\"btn sm\" data-act=\"dupCol\">⧉ Duplicate</button><button class=\"btn sm\" data-act=\"delCol\">✕ Delete</button><button class=\"btn sm\" data-act=\"copyAll\" title=\"Copy cover, link, kicker, lap settings to all other columns\">Copy settings to others</button></div>');\n  return h;\n}\nfunction paneStoreys() {\n  var c = col(), h = '', n = c.st.length, aci = isACI(), circ = c.shape === 'circ';\n  h += grp('Storeys', fld('c.nSt', 'Number of storeys', {min: 1, max: 40, step: 1, re: 1}) + fld('c.defH', 'Default storey height', {u: 'mm', step: 50}) +\n    fld('c.base.gfName', 'Ground floor name', {t: 't'}) + fld('c.base.ffl', 'Ground floor level (FFL)', {u: 'm'}) +\n    '<button class=\"btn\" data-act=\"applyH\" style=\"grid-column:1/3;justify-content:center\">Set all storey heights = default</button>');\n  var dis = !c.vary;\n  c.st.forEach(function (s, i) {\n    var p = 'c.st.' + i + '.', body = '';\n    body += fld(p + 'name', 'Level name', {t: 't'}) + fld(p + 'H', 'Storey height', {u: 'mm', step: 50}) + fld(p + 'elevOverride', 'Level tag text (optional)', {t: 't', full: 1});\n    body += '<div class=\"note\">Column section for this storey ' + (dis ? '(locked — enable “different section at each storey”)' : '') + '</div>';\n    if (circ) body += fld(p + 'D', 'D', {u: 'mm', step: 25, dis: dis}) + fld(p + 'n', 'No. bars', {step: 1, dis: dis});\n    else body += fld(p + 'b', 'b', {u: 'mm', step: 25, dis: dis}) + fld(p + 'h', 'h', {u: 'mm', step: 25, dis: dis}) + fld(p + 'nb', 'Bars on b', {step: 1, dis: dis}) + fld(p + 'nh', 'Bars on h', {step: 1, dis: dis});\n    body += fld(p + 'des', 'Main bar', {t: 's', num: 1, o: mainBars(), dis: dis}) + fld(p + 'linkDes', aci ? 'Tie' : 'Link', {t: 's', num: 1, o: linkBars(), dis: dis});\n    body += '<div class=\"note\">Beam / slab at top of this storey</div>' + fld(p + 'bw', 'Beam width', {u: 'mm'}) + fld(p + 'bd', 'Beam depth', {u: 'mm'}) + fld(p + 'slab', 'Slab thickness', {u: 'mm'}) + fld(p + 'beamTop', 'Beam top bars', {t: 't'}) + fld(p + 'beamBot', 'Beam bottom bars', {t: 't'});\n    var lbl = (i + 1) + ' · ' + esc(s.name || '') + ' <small style=\"color:var(--mu)\">H ' + s.H + (circ ? ' · Ø' + s.D : ' · ' + s.b + '×' + s.h) + '</small>';\n    h += '<details class=\"acc\"' + (i === 0 ? ' open' : '') + '><summary><span>' + lbl + '</span><span>▾</span></summary><div class=\"grp\" style=\"margin-top:0\"><div>' + body + '</div></div></details>';\n  });\n  return h;\n}\nfunction paneFound() {\n  var c = col(), aci = isACI(), h = '', comb = c.base.ftg.type === 'combined';\n  h += grp('Below ground', fld('c.base.glDepth', 'Ground floor level → ground level (G.L)', {u: 'mm', step: 25}) + fld('c.base.belowGL', 'Ground level → footing top', {u: 'mm', step: 25}) + fld('c.base.gSlab', 'Ground-floor slab / plinth thickness', {u: 'mm', step: 25}) + '<div class=\"note\">Footing top = G.F.L − (first + second value). Slab thickness 0 = no slab zone drawn at G.F.L.</div>' +\n    fld('c.cover.ftg', 'Footing cover (bottom)', {u: 'mm'}));\n  var f = '';\n  f += fld('c.base.ftg.type', 'Footing type', {t: 's', o: [['single', 'Single pad (B1 / B2)'], ['combined', 'Combined pad (B1 T1 B2 T2)']], full: 1, re: 1});\n  f += fld('c.base.ftg.B', comb ? 'Width (across)' : 'Width B', {u: 'mm', step: 50}) + fld('c.base.ftg.L', comb ? 'Footing width Y' : 'Length L', {u: 'mm', step: 50});\n  if (comb) f += fld('c.base.ftg.Lcomb', 'Combined length', {u: 'mm', step: 50});\n  f += fld('c.base.ftg.T', 'Footing depth T', {u: 'mm', step: 25}) + fld('c.base.ftg.ex', 'Column eccentricity', {u: 'mm'});\n  f += fld('c.base.ftg.lean', 'Lean concrete thickness', {u: 'mm', step: 25}) + fld('c.base.ftg.leanProj', 'Lean projection', {u: 'mm', step: 25});\n  h += grp('Footing & lean concrete', f);\n  var L = '';\n  ['B1', 'B2'].concat(comb ? ['T1', 'T2'] : []).forEach(function (k) {\n    L += fld('c.base.lay.' + k + '.n', k + ' — number', {step: 1}) + fld('c.base.lay.' + k + '.des', k + ' — bar', {t: 's', num: 1, o: ftgBars()});\n  });\n  h += grp('Footing reinforcement', L + '<div class=\"note\">B = bottom layers, T = top layers (combined footing).</div>');\n  var g = fld('c.base.gb.on', 'Provide ground beam at ground floor', {t: 'c', full: 1, re: 1});\n  if (c.base.gb.on) g += fld('c.base.gb.bw', 'Beam width', {u: 'mm'}) + fld('c.base.gb.bd', 'Beam depth', {u: 'mm'}) + fld('c.base.gb.topN', 'Top bars — no.', {step: 1}) + fld('c.base.gb.topDes', 'Top bars — size', {t: 's', num: 1, o: mainBars()}) + fld('c.base.gb.botN', 'Bottom bars — no.', {step: 1}) + fld('c.base.gb.botDes', 'Bottom bars — size', {t: 's', num: 1, o: mainBars()});\n  h += grp('Ground beam (optional)', g);\n  return h;\n}\nfunction paneDetail() {\n  var c = col(), aci = isACI(), circ = c.shape === 'circ', h = '';\n  h += grp('Cover', fld('c.cover.auto', 'Cover from code (auto)', {t: 'c', full: 1, re: 1}) + (c.cover.auto ? '<div class=\"info\">' + (S.M ? 'Nominal cover to links = ' + S.M.cover + ' mm' : 'Cover set by code/exposure') + '</div>' : fld('c.cover.col', 'Cover to links / ties', {u: 'mm'})));\n  var k = fld('c.kicker.loc', 'Kicker', {t: 's', o: [['top', 'Kicker at top of floor'], ['soffit', 'None (construct to soffit)']], full: 1}) +\n    fld('c.kicker.h', 'Kicker height above floor', {u: 'mm', step: 5}) + fld('c.kicker.hBelow', 'Kicker height at footing', {u: 'mm', step: 5});\n  h += grp('Kicker', k);\n  var l = fld('c.lapOpt.mode', 'Lap length', {t: 's', o: [['auto', 'From code'], ['manual', 'Manual']], re: 1});\n  l += fld('c.lapOpt.val', 'Manual lap', {u: 'mm', dis: c.lapOpt.mode !== 'manual'});\n  if (aci) l += fld('c.lapOpt.type', 'Lap type', {t: 's', o: [['comp', 'Compression (0.071 fy db)'], ['tensA', 'Tension Class A'], ['tensB', 'Tension Class B']], full: 1});\n  else l += fld('c.lapOpt.a6', 'α6 (lap % lapped)', {t: 's', num: 1, o: [[1, '1.0 (≤25 %)'], [1.15, '1.15 (33 %)'], [1.4, '1.4 (50 %)'], [1.5, '1.5 (>50 %, Table 6.5)']]});\n  l += fld('c.crankOpt.mode', aci ? 'Offset length' : 'Crank length', {t: 's', o: [['auto', aci ? 'Auto (1:6)' : 'Auto (1:10)'], ['manual', 'Manual']], re: 1}) + fld('c.crankOpt.val', 'Manual length', {u: 'mm', dis: c.crankOpt.mode !== 'manual'});\n  h += grp('Lap & ' + (aci ? 'offset' : 'crank'), l + '<div class=\"note\">Crank length is calculated from the code (' + (aci ? 'slope ≤ 1:6' : '1:10') + ') unless set to manual.</div>');\n  var s = fld('c.starter.mode', 'Starter-bar development', {t: 's', o: [['auto', 'From code'], ['manual', 'Manual']], re: 1}) + fld('c.starter.dev', 'Manual vertical length', {u: 'mm', dis: c.starter.mode !== 'manual'}) +\n    fld('c.starter.leg', 'Horizontal foot', {u: 'mm', step: 25}) + fld('c.starter.foot', 'Starter foot direction', {t: 's', o: [['in', 'Inward (towards centre)'], ['out', 'Outward (DETAIL_PRO)']]}) + fld('c.footingStarterTol', 'Starter tolerance', {u: 'mm'}) + fld('c.starter.locate', 'Locating links in footing', {t: 'c', full: 1});\n  h += grp('Starter bars', s);\n  var lk = fld('c.link.hook', 'Hook angle', {t: 's', num: 1, o: [[135, '135°'], [90, '90°']]}) + fld('c.link.sOverride', 'Link spacing (0 = auto)', {u: 'mm', step: 25}) + fld('c.link.uniform', 'Same spacing over full height (no closer spacing at laps)', {t: 'c', full: 1}) +\n    fld('c.link.jointLinks', 'Link at beam/slab soffit joint', {t: 'c', full: 1}) + (circ ? fld('c.link.circ', 'Circular links', {t: 's', o: [['helix', 'Helical spiral'], ['rings', 'Separate rings']], full: 1}) : fld('c.link.crossTies', 'Cross-ties / restraint links', {t: 'c', full: 1}));\n  h += grp(aci ? 'Ties' : 'Links', lk);\n  h += grp('Top of column', fld('c.top.mode', 'Top bars', {t: 's', o: [['auto', 'Auto (turn if slab too thin)'], ['bend', 'Always turn into slab'], ['straight', 'Straight to cover']], full: 1}));\n  return h;\n}\nfunction paneStyle() {\n  var P = S.P, st = CD.ensureStyle(P), h = '';\n  h += grp('Drawing style',\n    fld('P.style.mode', 'Style', {t: 's', o: [['pro', 'DETAIL_PRO (reference style)'], ['std', 'Standard (coloured, annotated)']], full: 1, re: 1}) +\n    '<div class=\"act\"><button class=\"btn\" data-act=\"proPreset\">Apply DETAIL_PRO preset</button> <button class=\"btn\" data-act=\"proExample\">Load DETAIL_PRO example</button></div>' +\n    '<div class=\"note\">The preset sets: A3 sheet, uniform links, kickers 75, manual lap 900, outward starters, G.L 450 below G.F.L, 300 ground slab, 50 lean, black-and-white output.</div>');\n  if (st.mode !== 'pro') return h;\n  h += grp('Output',\n    fld('P.style.mono', 'Black & white output (SVG / PNG / print)', {t: 'c', full: 1}) +\n    fld('P.style.border', 'Sheet border', {t: 'c', full: 1}) +\n    fld('P.style.fitExact', 'Fit exactly to sheet (non-standard scale)', {t: 'c', full: 1}) +\n    fld('P.style.elevText', 'Elevation scale label (blank = true scale)', {t: 't'}) + fld('P.style.secText', 'Section scale label (blank = true)', {t: 't'}));\n  h += grp('Marks & symbols',\n    fld('P.style.sameMarks', 'One mark per bar type on every lift (01 bars, 02 links)', {t: 'c', full: 1}) +\n    fld('P.style.barLine', 'Bar line drawn at', {t: 's', o: [['link', 'Link centre-line'], ['bar', 'True bar centre']]}) +\n    fld('P.style.showArrows', 'Arrows along bars', {t: 'c'}) + fld('P.style.showLinkMark', 'Typical link mark', {t: 'c'}) +\n    fld('P.style.showJointLink', 'Links at slab / beam zones', {t: 'c'}) + fld('P.style.showKicker', 'Kicker lines', {t: 'c'}) +\n    fld('P.style.showGL', 'Ground level + hatch', {t: 'c'}) + fld('P.style.showCut', 'Section cut markers', {t: 'c'}) +\n    fld('P.style.showSection', 'Section view', {t: 'c'}) + fld('P.style.showDims', 'Level dimensions', {t: 'c'}) +\n    fld('P.style.showTitle', 'Title block text', {t: 'c'}) + fld('P.style.showFoot', 'Footing plan note', {t: 'c'}));\n  h += grp('Text heights (paper mm)',\n    fld('P.style.txtH', 'Callouts / levels', {step: 0.1}) + fld('P.style.titleH', 'Title', {step: 0.1}) + fld('P.style.subH', 'Scale text', {step: 0.1}) +\n    fld('P.style.secTxtH', 'Section tags / dims', {step: 0.05}) + fld('P.style.secTitleH', 'Section title', {step: 0.05}));\n  h += grp('Layout (paper mm)',\n    fld('P.style.marginTop', 'Top margin', {step: 1}) + fld('P.style.marginBottom', 'Bottom margin (title band)', {step: 1}) +\n    fld('P.style.slabHalf', 'Slab zone half-length (real mm)', {step: 25}) + fld('P.style.breakDx', 'Break symbol width (real mm)', {step: 4}) +\n    fld('P.style.breakOver', 'Slab edge overshoot (real mm)', {step: 10}));\n  h += grp('Line weights (mm)',\n    fld('P.style.wHair', 'Hair', {step: 0.01}) + fld('P.style.wThin', 'Thin', {step: 0.01}) + fld('P.style.wMed', 'Medium', {step: 0.01}) + fld('P.style.wThick', 'Thick (bars)', {step: 0.01}));\n  return h;\n}\nvar LPANE = {style: paneStyle, project: paneProject, column: paneColumn, storeys: paneStoreys, found: paneFound, detail: paneDetail};\n\nfunction drawLeft(keepScroll) {\n  var tabs = $('#ltabs'), pane = $('#lpane'), sc = keepScroll ? pane.scrollTop : 0;\n  tabs.innerHTML = LTABS.map(function (t) { return '<button data-t=\"' + t[0] + '\"' + (S.lt === t[0] ? ' class=\"on\"' : '') + '>' + t[1] + '</button>'; }).join('');\n  pane.innerHTML = LPANE[S.lt]();\n  pane.scrollTop = sc;\n}\n\n/* ============================================================ RIGHT PANES = */\nvar RTABS = [['checks', 'Checks'], ['sched', 'Schedule'], ['qty', 'Quantities'], ['layers', 'Layers'], ['notes', 'Notes']];\nfunction nIssues() { if (!S.M) return 0; return S.M.checks.filter(function (c) { return c.level === 'err' || c.level === 'warn'; }).length; }\nfunction paneChecks() {\n  var M = S.M; if (!M) return '<div class=\"note\">Press START DETAILING.</div>';\n  var order = {err: 0, warn: 1, info: 2, ok: 3};\n  return M.checks.slice().sort(function (a, b) { return order[a.level] - order[b.level]; }).map(function (c) {\n    return '<div class=\"sev ' + c.level + '\"><b>' + ({err: '✖', warn: '▲', info: 'ℹ', ok: '✔'}[c.level]) + '</b><div>' + esc(c.msg || c.text) + (c.ref ? '<span class=\"r\">' + esc(c.ref) + '</span>' : '') + '</div></div>';\n  }).join('') || '<div class=\"note\">No messages.</div>';\n}\nfunction paneSched() {\n  var M = S.M; if (!M) return '<div class=\"note\">Press START DETAILING.</div>';\n  var h = '<table class=\"t\"><tr><th>Mark</th><th>Bar</th><th class=\"n\">No.</th><th>Sh.</th><th class=\"n\">A</th><th class=\"n\">B</th><th class=\"n\">C</th><th class=\"n\">Length</th><th class=\"n\">kg</th><th>Location</th></tr>';\n  M.bars.forEach(function (b) {\n    var d = b.dims || {};\n    h += '<tr><td><b>' + b.mark + '</b></td><td>' + esc(b.text) + '</td><td class=\"n\">' + b.no + '</td><td>' + esc(b.shape) + '</td><td class=\"n\">' + (d.A != null ? d.A : '') + '</td><td class=\"n\">' + (d.B != null ? d.B : '') + '</td><td class=\"n\">' + (d.C != null ? d.C : '') + '</td><td class=\"n\">' + b.len + '</td><td class=\"n\">' + CD.fmt(b.massTot, 1) + '</td><td>' + esc((b.locs || []).join('; ')) + '</td></tr>';\n  });\n  h += '<tr><td colspan=\"8\"><b>Total per column</b></td><td class=\"n\"><b>' + CD.fmt(M.mass, 1) + '</b></td><td></td></tr>';\n  h += '<tr><td colspan=\"8\"><b>× ' + col().qty + ' No.</b></td><td class=\"n\"><b>' + CD.fmt(M.massAll, 1) + '</b></td><td></td></tr></table>';\n  return h + '<p class=\"note\" style=\"margin-top:8px\">Cutting lengths are rounded up to 25 mm' + (isACI() ? ' (ACI: lengths per ACI 315 bend allowances)' : ' (BS 8666 shapes)') + '.</p>';\n}\nfunction paneQty() {\n  var M = S.M; if (!M) return '<div class=\"note\">Press START DETAILING.</div>';\n  var c = col(), vol = M.volCol + M.volFtg + M.volLean;\n  var h = '<div class=\"kpi\"><div><small>STEEL / COLUMN</small><b>' + CD.fmt(M.mass, 1) + ' kg</b></div><div><small>STEEL × ' + c.qty + '</small><b>' + CD.fmt(M.massAll, 1) + ' kg</b></div>' +\n    '<div><small>CONC. COLUMN</small><b>' + CD.fmt(M.volCol, 3) + ' m³</b></div><div><small>CONC. FOOTING</small><b>' + CD.fmt(M.volFtg, 3) + ' m³</b></div>' +\n    '<div><small>LEAN</small><b>' + CD.fmt(M.volLean, 3) + ' m³</b></div><div><small>STEEL / CONCRETE</small><b>' + CD.fmt(M.mass / Math.max(1e-9, M.volCol + M.volFtg), 0) + ' kg/m³</b></div></div>';\n  var by = {}, tot = 0;\n  M.bars.forEach(function (b) { var k = b.text.replace(/\\s.*$/, '').replace(/^\\d+/, ''); by[k] = (by[k] || 0) + b.massTot; tot += b.massTot; });\n  h += '<table class=\"t\"><tr><th>Bar size</th><th class=\"n\">kg / column</th><th class=\"n\">kg × ' + c.qty + '</th></tr>' + Object.keys(by).sort().map(function (k) { return '<tr><td>' + esc(k) + '</td><td class=\"n\">' + CD.fmt(by[k], 1) + '</td><td class=\"n\">' + CD.fmt(by[k] * c.qty, 1) + '</td></tr>'; }).join('') + '</table>';\n  h += '<h4 style=\"margin:16px 0 6px;font-size:11px;letter-spacing:.14em;color:var(--mu)\">ALL COLUMNS IN PROJECT</h4><table class=\"t\"><tr><th>Mark</th><th class=\"n\">Qty</th><th class=\"n\">Steel kg</th><th class=\"n\">Total kg</th></tr>';\n  var gt = 0;\n  S.P.cols.forEach(function (cc) {\n    try { var m = CD.compute(S.P, cc); gt += m.massAll; h += '<tr><td>' + esc(cc.mark) + '</td><td class=\"n\">' + cc.qty + '</td><td class=\"n\">' + CD.fmt(m.mass, 1) + '</td><td class=\"n\">' + CD.fmt(m.massAll, 1) + '</td></tr>'; } catch (e) { h += '<tr><td>' + esc(cc.mark) + '</td><td colspan=\"3\">error</td></tr>'; }\n  });\n  return h + '<tr><td colspan=\"3\"><b>Total</b></td><td class=\"n\"><b>' + CD.fmt(gt, 1) + '</b></td></tr></table>';\n}\nfunction paneLayers() {\n  var theme = S.P.sheet.theme;\n  return CD.LAYERS.map(function (L) {\n    return '<label class=\"lyr\"><input type=\"checkbox\" data-layer=\"' + L.n + '\"' + (S.hidden[L.n] ? '' : ' checked') + '><span class=\"sw\" style=\"background:' + (theme === 'light' ? L.lt : L.dk) + '\"></span>' + L.n + '<small>' + L.desc + '</small></label>';\n  }).join('');\n}\nfunction paneNotes() {\n  if (!S.M) return '<div class=\"note\">Press START DETAILING.</div>';\n  var n = CD.buildNotes(S.P, col(), S.M);\n  return '<ol class=\"notes\">' + n.map(function (t) { return '<li>' + esc(t.replace(/^\\s*\\d+\\.\\s*/, '')) + '</li>'; }).join('') + '</ol>';\n}\nvar RPANE = {checks: paneChecks, sched: paneSched, qty: paneQty, layers: paneLayers, notes: paneNotes};\nfunction drawRight() {\n  var n = nIssues();\n  $('#rtabs').innerHTML = RTABS.map(function (t) { return '<button data-t=\"' + t[0] + '\"' + (S.rt === t[0] ? ' class=\"on\"' : '') + '>' + t[1] + (t[0] === 'checks' && n ? '<span class=\"n\">' + n + '</span>' : '') + '</button>'; }).join('');\n  $('#rpane').innerHTML = RPANE[S.rt]();\n}\n\n/* ============================================================== DRAWING === */\nfunction renderSheet(fit) {\n  var c = col();\n  try {\n    S.M = CD.compute(S.P, c);\n    S.sheet = CD.buildSheet(S.P, c, S.M, {});\n  } catch (e) { log('ERROR: ' + e.message, 'e'); toast('Calculation error: ' + e.message); console.error(e); return; }\n  S.stale = false; S.ov = '';\n  $('#empty').classList.add('hide');\n  drawSVG(fit || !S.vb);\n  drawRight(); statusBar(); staleBtn();\n}\nfunction drawSVG(fit) {\n  var v = $('#view'), sh = S.sheet; if (!sh) return;\n  var theme = S.P.sheet.theme, inner = CD.svgInner(sh.ents, {theme: theme, mode: 'screen', H: sh.H, hidden: S.hidden});\n  var grid = S.grid ? '<defs><pattern id=\"gp\" width=\"10\" height=\"10\" patternUnits=\"userSpaceOnUse\"><circle cx=\"0\" cy=\"0\" r=\".18\" fill=\"' + (theme === 'light' ? '#9fb0c0' : '#33465a') + '\"/></pattern></defs><rect x=\"0\" y=\"0\" width=\"' + sh.W + '\" height=\"' + sh.H + '\" fill=\"url(#gp)\"/>' : '';\n  var svg = v.querySelector('svg');\n  if (!svg) { svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg'); svg.setAttribute('font-family', \"Consolas,'DejaVu Sans Mono','Courier New',monospace\"); v.insertBefore(svg, v.firstChild); }\n  svg.innerHTML = '<rect x=\"0\" y=\"0\" width=\"' + sh.W + '\" height=\"' + sh.H + '\" fill=\"' + (theme === 'light' ? '#ffffff' : '#10161d') + '\"/>' + grid + inner + '<g id=\"ov\">' + S.ov + '</g>';\n  if (fit || !S.vb) zoomExt(); else applyVB();\n}\nfunction viewSize() { var v = $('#view'); return {w: Math.max(50, v.clientWidth), h: Math.max(50, v.clientHeight)}; }\nfunction zoomExt() {\n  if (!S.sheet) return;\n  var vs = viewSize(), W = S.sheet.W, H = S.sheet.H, w = Math.max(W * 1.04, H * 1.04 * vs.w / vs.h);\n  S.vb = {cx: W / 2, cy: H / 2, w: w}; applyVB();\n}\nfunction applyVB() {\n  var svg = $('#view svg'); if (!svg || !S.vb) return;\n  var vs = viewSize(), w = S.vb.w, h = w * vs.h / vs.w;\n  svg.setAttribute('viewBox', (S.vb.cx - w / 2) + ' ' + (S.vb.cy - h / 2) + ' ' + w + ' ' + h);\n  var z = $('#hud'); if (z) z.dataset.zoom = (vs.w / w).toFixed(2);\n}\nfunction toSheet(ev) {\n  var v = $('#view'), r = v.getBoundingClientRect(), vs = viewSize(), w = S.vb.w, h = w * vs.h / vs.w;\n  var x = S.vb.cx - w / 2 + (ev.clientX - r.left) / vs.w * w, y = S.vb.cy - h / 2 + (ev.clientY - r.top) / vs.h * h;\n  return {x: x, y: S.sheet.H - y, sx: x, sy: y};\n}\nfunction zoomAt(f, ev) {\n  if (!S.vb) return;\n  var vs = viewSize(), r = $('#view').getBoundingClientRect();\n  var px = ev ? (ev.clientX - r.left) / vs.w : 0.5, py = ev ? (ev.clientY - r.top) / vs.h : 0.5;\n  var w0 = S.vb.w, h0 = w0 * vs.h / vs.w, w1 = Math.max(5, Math.min(w0 * f, 20000)), h1 = w1 * vs.h / vs.w;\n  var x0 = S.vb.cx - w0 / 2 + px * w0, y0 = S.vb.cy - h0 / 2 + py * h0;\n  S.vb = {cx: x0 - px * w1 + w1 / 2, cy: y0 - py * h1 + h1 / 2, w: w1}; applyVB();\n}\nfunction setupViewer() {\n  var v = $('#view'), drag = null, moved = 0;\n  v.addEventListener('wheel', function (e) { e.preventDefault(); zoomAt(e.deltaY < 0 ? 1 / 1.18 : 1.18, e); }, {passive: false});\n  v.addEventListener('pointerdown', function (e) {\n    if (e.target.closest('#vtools')) return;\n    drag = {x: e.clientX, y: e.clientY}; moved = 0; v.setPointerCapture(e.pointerId);\n  });\n  v.addEventListener('pointermove', function (e) {\n    var r = v.getBoundingClientRect(), cx = $('#chx'), cy = $('#chy');\n    cx.classList.remove('hide'); cy.classList.remove('hide'); cx.style.top = (e.clientY - r.top) + 'px'; cy.style.left = (e.clientX - r.left) + 'px';\n    if (S.sheet && S.vb) {\n      var p = toSheet(e);\n      $('#hud').textContent = 'X ' + p.x.toFixed(1) + '  Y ' + p.y.toFixed(1) + ' mm (sheet)   |   model ' + (p.x * S.sheet.scale).toFixed(0) + ', ' + (p.y * S.sheet.scale).toFixed(0) + ' mm   |   1:' + S.sheet.scale;\n    }\n    if (drag && S.vb) {\n      var vs = viewSize(), dx = e.clientX - drag.x, dy = e.clientY - drag.y;\n      moved += Math.abs(dx) + Math.abs(dy);\n      S.vb.cx -= dx * S.vb.w / vs.w; S.vb.cy -= dy * S.vb.w / vs.w; drag.x = e.clientX; drag.y = e.clientY; applyVB();\n    }\n  });\n  v.addEventListener('pointerleave', function () { $('#chx').classList.add('hide'); $('#chy').classList.add('hide'); });\n  v.addEventListener('pointerup', function (e) {\n    var wasClick = moved < 4; drag = null;\n    if (wasClick && S.measure && S.sheet && !e.target.closest('#vtools')) measureClick(toSheet(e));\n  });\n  v.addEventListener('dblclick', function () { zoomExt(); });\n  $('#zE').onclick = zoomExt; $('#zI').onclick = function () { zoomAt(1 / 1.3); }; $('#zO').onclick = function () { zoomAt(1.3); };\n  $('#zD').onclick = function () { startMeasure(); };\n  $('#zG').onclick = function () { S.grid = !S.grid; drawSVG(false); };\n  window.addEventListener('resize', function () { if (S.vb) applyVB(); });\n}\nfunction startMeasure() { if (!S.sheet) return toast('Draw the sheet first'); S.measure = {pts: []}; S.ov = ''; drawSVG(false); log('DIST  Specify first point:'); toast('Click two points to measure'); }\nfunction measureClick(p) {\n  var m = S.measure; m.pts.push(p);\n  if (m.pts.length === 1) { log('DIST  Specify second point:'); S.ov = '<circle cx=\"' + p.sx + '\" cy=\"' + p.sy + '\" r=\"1.2\" fill=\"#ffb020\"/>'; drawSVG(false); return; }\n  var a = m.pts[0], b = m.pts[1], d = Math.hypot(b.x - a.x, b.y - a.y);\n  log('Distance = ' + d.toFixed(2) + ' mm on sheet  =  ' + (d * S.sheet.scale).toFixed(0) + ' mm at 1:1   (dX ' + (Math.abs(b.x - a.x) * S.sheet.scale).toFixed(0) + ', dY ' + (Math.abs(b.y - a.y) * S.sheet.scale).toFixed(0) + ')', 'o');\n  S.ov = '<line x1=\"' + a.sx + '\" y1=\"' + a.sy + '\" x2=\"' + b.sx + '\" y2=\"' + b.sy + '\" stroke=\"#ffb020\" stroke-width=\"1.5\" vector-effect=\"non-scaling-stroke\" stroke-dasharray=\"4 3\"/>';\n  S.measure = null; drawSVG(false);\n}\n\n/* ============================================================ WORKSPACE === */\nfunction statusBar() {\n  var s = $('#status'), sh = S.sheet, M = S.M, c = col();\n  var e = M ? M.checks.filter(function (x) { return x.level === 'err'; }).length : 0, w = M ? M.checks.filter(function (x) { return x.level === 'warn'; }).length : 0;\n  s.innerHTML = '<span>Code <b>' + (isACI() ? 'ACI 315-99' : 'IStructE SMDSC') + '</b></span><span>Column <b>' + esc(c.mark) + '</b> × ' + c.qty + '</span>' +\n    (sh ? '<span>Sheet <b>' + sh.sheet + '</b></span><span>Scale <b>1:' + sh.scale + '</b>' + (sh.fit ? '' : ' <b style=\"color:var(--bad)\">(does not fit!)</b>') + '</span>' : '') +\n    '<span>Errors <b style=\"color:' + (e ? 'var(--bad)' : 'var(--ok)') + '\">' + e + '</b>  Warnings <b style=\"color:' + (w ? 'var(--warn)' : 'var(--ok)') + '\">' + w + '</b></span>' + (M ? '<span>Steel <b>' + CD.fmt(M.mass, 1) + ' kg</b>/col</span>' : '') +\n    '<span style=\"margin-left:auto\">' + (S.stale ? '<b style=\"color:var(--ac)\">● input changed — press START DETAILING</b>' : '● up to date') + '</span>';\n}\nfunction staleBtn() { $('#goBtn').classList.toggle('stale', S.stale && !$('#autoChk').checked); }\nfunction drawColBar() {\n  var P = S.P;\n  $('#colbar').innerHTML = P.cols.map(function (c, i) { return '<div class=\"ct' + (i === P.active ? ' on' : '') + '\" data-i=\"' + i + '\">' + esc(c.mark) + '<small>' + (c.shape === 'circ' ? 'Ø' + c.typ.D : c.typ.b + '×' + c.typ.h) + ' · ' + c.qty + ' Nos</small></div>'; }).join('') + '<div class=\"add\" data-act=\"addCol\">＋ column</div>';\n}\nfunction refreshAll(keepScroll) {\n  $('#projName').textContent = S.P.meta.job + '  ·  ' + S.P.cols.length + ' column mark' + (S.P.cols.length > 1 ? 's' : '');\n  $('#codeBadge').textContent = isACI() ? 'ACI 315-99' : 'IStructE';\n  document.documentElement.dataset.theme = S.P.sheet.theme;\n  drawColBar(); drawLeft(keepScroll); drawRight(); statusBar(); staleBtn();\n}\nfunction enterWorkspace(detail) {\n  $('#start').classList.add('hide'); $('#app').classList.remove('hide');\n  S.vb = null; S.sheet = null; S.M = null; S.stale = true; S.hidden = {};\n  var old = $('#view svg'); if (old) old.remove(); $('#empty').classList.remove('hide');\n  S.lt = 'project'; refreshAll();\n  setTimeout(function () { if (detail !== false) goDetail(true); }, 30);\n  autosave(); pushRecent();\n}\nfunction goDetail(fit) { renderSheet(fit); }\nfunction autosave() { if (S.P) lsSet('cdp.autosave', S.P); }\nfunction scheduleRender() {\n  S.stale = true; statusBar(); staleBtn();\n  if ($('#autoChk').checked) { clearTimeout(S.timer); S.timer = setTimeout(function () { renderSheet(false); }, 160); }\n}\nfunction onEdit(re, path) {\n  var c = col();\n  if (path === 'c.nSt') CD.resizeStoreys(c, S.P.code);\n  if (!c.vary) CD.applyTypical(c);\n  if (c.shape === 'circ' && c.typ.n < 6) c.typ.n = 6;\n  autosave();\n  if (re) { drawLeft(true); drawColBar(); }\n  if (path && /^c\\.(mark|qty)/.test(path)) drawColBar();\n  scheduleRender();\n}\nfunction bindEvents() {\n  // form edits (delegated)\n  function commit(t, final) {\n    var path = t.dataset.p; if (!path) return;\n    var v;\n    if (t.type === 'checkbox') v = t.checked; else if (t.dataset.k === 'n') { v = parseFloat(t.value); if (isNaN(v)) { if (!final) return; v = 0; } } else v = t.value;\n    if (path === 'P.code') {\n      if (v === S.P.code) return;\n      CD.setCode(S.P, v); S.stale = true; refreshAll(); scheduleRender(); autosave(); return;\n    }\n    if (path === 'P.mat.fck' && !isACI()) { var g = CD.IST_GRADES.filter(function (x) { return x.fck === v; })[0]; if (g) S.P.mat.fcu = g.fcu; }\n    setP(path, v);\n    if (path === 'P.mat.letter') { S.P.mat.letter = v; }\n    if (path === 'P.sheet.theme') document.documentElement.dataset.theme = v;\n    onEdit(!!t.dataset.re && final, path);\n  }\n  document.addEventListener('input', function (e) { var t = e.target; if (t.dataset && t.dataset.p && t.type !== 'checkbox' && t.tagName !== 'SELECT') commit(t, false); });\n  document.addEventListener('change', function (e) { var t = e.target; if (t.dataset && t.dataset.p) commit(t, true); if (t.dataset && t.dataset.layer) { S.hidden[t.dataset.layer] = !t.checked; drawSVG(false); } });\n  document.addEventListener('click', function (e) {\n    var t = e.target.closest('[data-t],[data-act],[data-i],[data-m],[data-c]'); if (!t) return;\n    if (t.dataset.act) return act(t.dataset.act);\n    if (t.closest('#ltabs')) { S.lt = t.dataset.t; drawLeft(); }\n    else if (t.closest('#rtabs')) { S.rt = t.dataset.t; drawRight(); }\n    else if (t.closest('#colbar') && t.dataset.i != null) { S.P.active = +t.dataset.i; refreshAll(); renderSheet(true); }\n  });\n  $('#goBtn').onclick = function () { renderSheet(true); log('Detailing complete: column ' + col().mark + ' — ' + S.M.bars.length + ' bar marks, ' + CD.fmt(S.M.mass, 1) + ' kg per column.', 'o'); };\n  $('#autoChk').onchange = function () { staleBtn(); if (this.checked && S.stale) renderSheet(false); };\n  $('#bHome').onclick = function () { showStart(); };\n  $('#bImport').onclick = function () { openImport('grouped', false); };\n  $('#bOpen').onclick = function () { $('#fileOpen').click(); };\n  $('#bSave').onclick = saveProject;\n  $('#bDxf').onclick = function () { exportDXF(false); };\n  $('#bDxfM').onclick = function () { exportDXF(true); };\n  $('#bSvg').onclick = exportSVG; $('#bPng').onclick = exportPNG; $('#bPrint').onclick = doPrint; $('#bCsv').onclick = exportCSV;\n  $('#bTheme').onclick = function () { S.P.sheet.theme = S.P.sheet.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = S.P.sheet.theme; if (S.sheet) drawSVG(false); drawRight(); autosave(); };\n  $('#fileOpen').onchange = function () { var f = this.files[0]; if (f) f.text().then(loadProjectText); this.value = ''; };\n  // command line\n  var hist = [], hi = 0, ci = $('#cmdline');\n  ci.addEventListener('keydown', function (e) {\n    if (e.key === 'Enter') { var t = ci.value.trim(); if (t) { hist.push(t); hi = hist.length; log('> ' + t); command(t); } ci.value = ''; }\n    else if (e.key === 'ArrowUp') { if (hi > 0) ci.value = hist[--hi]; e.preventDefault(); }\n    else if (e.key === 'ArrowDown') { ci.value = hi < hist.length - 1 ? hist[++hi] : ''; hi = Math.min(hi, hist.length); }\n    else if (e.key === 'Escape') { S.measure = null; ci.value = ''; }\n    e.stopPropagation();\n  });\n  document.addEventListener('keydown', function (e) {\n    if (!$('#app') || $('#app').classList.contains('hide')) return;\n    var tag = (e.target.tagName || '').toLowerCase();\n    if (tag === 'input' || tag === 'select' || tag === 'textarea') return;\n    if (e.key === 'F5' || (e.key === 'Enter' && e.ctrlKey)) { e.preventDefault(); renderSheet(true); }\n    else if (e.ctrlKey && e.key.toLowerCase() === 's') { e.preventDefault(); saveProject(); }\n    else if (e.key.length === 1 && !e.ctrlKey && !e.metaKey) { ci.focus(); }\n  });\n  // dock resize\n  [['left', 'lw', 1], ['right', 'rw', -1]].forEach(function (d) {\n    var el = $('#' + d[0]), sp = document.createElement('div'); sp.className = 'splitter'; sp.style[d[2] > 0 ? 'right' : 'left'] = '-3px'; el.style.position = 'relative'; el.appendChild(sp);\n    sp.addEventListener('pointerdown', function (e) {\n      sp.setPointerCapture(e.pointerId);\n      var mv = function (ev) { var w = d[2] > 0 ? ev.clientX : window.innerWidth - ev.clientX; $('#app').style.setProperty('--' + d[1], Math.max(250, Math.min(620, w)) + 'px'); if (S.vb) applyVB(); };\n      var up = function () { sp.removeEventListener('pointermove', mv); sp.removeEventListener('pointerup', up); };\n      sp.addEventListener('pointermove', mv); sp.addEventListener('pointerup', up);\n    });\n  });\n}\n\nfunction act(a) {\n  var c = col();\n  if (a === 'applyTyp') { CD.applyTypical(c); drawLeft(true); scheduleRender(); toast('Typical section applied to all storeys'); }\n  else if (a === 'proPreset') { CD.applyProPreset(S.P, c); drawLeft(true); scheduleRender(); toast('DETAIL_PRO preset applied'); }\n  else if (a === 'proExample') { S.P = CD.detailProExample(); S.P.sheet.theme = document.documentElement.dataset.theme || 'dark'; refreshAll(); renderSheet(true); toast('DETAIL_PRO example loaded'); }\n  else if (a === 'applyH') { c.st.forEach(function (s) { s.H = c.defH; }); drawLeft(true); scheduleRender(); }\n  else if (a === 'propose') {\n    var r = CD.proposeBars(S.P, c.shape, c.typ);\n    if (r) { c.typ.des = r.des; if (c.shape === 'circ') c.typ.n = r.n || c.typ.n; else { c.typ.nb = r.nb; c.typ.nh = r.nh; } }\n    if (!c.vary) CD.applyTypical(c);\n    drawLeft(true); scheduleRender(); toast('Proposed ' + (c.shape === 'circ' ? r.n : 2 * (r.nb + r.nh) - 4) + ' ' + CD.barLabel(S.P.code, r.des, S.P.mat.letter) + ' bars');\n  }\n  else if (a === 'addCol') { var n = S.P.cols.length + 1, nc = CD.defaultColumn(S.P.code, n); S.P.cols.push(nc); S.P.active = S.P.cols.length - 1; refreshAll(); renderSheet(true); }\n  else if (a === 'dupCol') { var d = JSON.parse(JSON.stringify(c)); d.mark = c.mark + '-A'; S.P.cols.push(d); S.P.active = S.P.cols.length - 1; refreshAll(); renderSheet(true); }\n  else if (a === 'delCol') { if (S.P.cols.length < 2) return toast('At least one column is required'); S.P.cols.splice(S.P.active, 1); S.P.active = 0; refreshAll(); renderSheet(true); }\n  else if (a === 'copyAll') {\n    S.P.cols.forEach(function (o) { if (o === c) return; ['cover', 'link', 'kicker', 'lapOpt', 'crankOpt', 'starter', 'top'].forEach(function (k) { o[k] = JSON.parse(JSON.stringify(c[k])); }); o.footingStarterTol = c.footingStarterTol; });\n    toast('Settings copied to ' + (S.P.cols.length - 1) + ' other column(s)'); autosave();\n  }\n}\n\n/* ------------------------------------------------------------ commands --- */\nfunction command(t) {\n  var p = t.trim().split(/\\s+/), k = p[0].toUpperCase();\n  if (k === 'HELP' || k === '?') log('ZE zoom extents · Z+ / Z- · DIST measure · DETAIL (start detailing) · DXF · DXF1 (1:1) · SVG · PNG · PLOT · CSV · SAVE · OPEN · IMPORT · THEME · GRID · LAYER <name> on|off · NEXT / PREV column · START (home)', 'o');\n  else if (k === 'ZE' || k === 'ZOOM' || k === 'Z') zoomExt();\n  else if (k === 'Z+') zoomAt(1 / 1.4); else if (k === 'Z-') zoomAt(1.4);\n  else if (k === 'DIST' || k === 'DI') startMeasure();\n  else if (k === 'DETAIL' || k === 'GO') $('#goBtn').click();\n  else if (k === 'DXF') exportDXF(false); else if (k === 'DXF1') exportDXF(true);\n  else if (k === 'SVG') exportSVG(); else if (k === 'PNG') exportPNG(); else if (k === 'PLOT' || k === 'PRINT') doPrint(); else if (k === 'CSV') exportCSV();\n  else if (k === 'SAVE') saveProject(); else if (k === 'OPEN') $('#fileOpen').click(); else if (k === 'IMPORT') openImport('grouped', false);\n  else if (k === 'THEME') $('#bTheme').click(); else if (k === 'GRID') $('#zG').click(); else if (k === 'START' || k === 'HOME') showStart();\n  else if (k === 'NEXT' || k === 'PREV') { var n = S.P.cols.length; S.P.active = (S.P.active + (k === 'NEXT' ? 1 : n - 1)) % n; refreshAll(); renderSheet(true); }\n  else if (k === 'LAYER' && p.length >= 3) {\n    var nm = p[1].toUpperCase(), on = /^on$/i.test(p[2]);\n    if (!CD.LAYERS.some(function (l) { return l.n === nm; })) log('Unknown layer ' + nm, 'e'); else { S.hidden[nm] = !on; drawSVG(false); drawRight(); log('Layer ' + nm + (on ? ' on' : ' off'), 'o'); }\n  }\n  else log('Unknown command \"' + t + '\" — type HELP', 'e');\n}\n\n/* ------------------------------------------------------------- exports --- */\nfunction ensureSheet() { if (!S.sheet || S.stale) renderSheet(false); return !!S.sheet; }\nfunction exportDXF(model) {\n  if (!ensureSheet()) return;\n  var sh = S.sheet, d = model ? CD.writeDXF(CD.scaleEnts(sh.ents, sh.scale), {scale: sh.scale}) : CD.writeDXF(sh.ents, {scale: 1});\n  download(fname(model ? '_1to1.dxf' : '_sheet.dxf'), d, 'application/dxf');\n  log('DXF written (' + (model ? 'model space 1:1, units mm' : 'paper space, 1:' + sh.scale + ' sheet, units mm') + ', R12).', 'o');\n}\nfunction sheetSVG() { var sh = S.sheet, st = S.P.style; return CD.svgDoc(sh.ents, sh.W, sh.H, {theme: 'light', mode: 'print', mono: !!(st && st.mode === 'pro' && st.mono)}); }\nfunction exportSVG() { if (!ensureSheet()) return; download(fname('.svg'), sheetSVG(), 'image/svg+xml'); }\nfunction exportPNG() {\n  if (!ensureSheet()) return;\n  var sh = S.sheet, ppm = Math.min(5, 9000 / Math.max(sh.W, sh.H)), img = new Image();\n  var blob = new Blob([sheetSVG()], {type: 'image/svg+xml'}), url = URL.createObjectURL(blob);\n  img.onload = function () {\n    var cv = document.createElement('canvas'); cv.width = Math.round(sh.W * ppm); cv.height = Math.round(sh.H * ppm);\n    var g = cv.getContext('2d'); g.fillStyle = '#fff'; g.fillRect(0, 0, cv.width, cv.height); g.drawImage(img, 0, 0, cv.width, cv.height);\n    cv.toBlob(function (b) { download(fname('.png'), b); URL.revokeObjectURL(url); });\n  };\n  img.src = url;\n}\nfunction doPrint() {\n  if (!ensureSheet()) return;\n  var sh = S.sheet, f = document.createElement('iframe'); f.style.cssText = 'position:fixed;width:0;height:0;border:0;right:0;bottom:0';\n  document.body.appendChild(f);\n  var d = f.contentDocument; d.open();\n  d.write('<!doctype html><title>' + esc(S.P.meta.job) + '</title><style>@page{size:' + sh.W + 'mm ' + sh.H + 'mm;margin:0}html,body{margin:0}svg{display:block;width:' + sh.W + 'mm;height:' + sh.H + 'mm}</style>' + sheetSVG());\n  d.close(); setTimeout(function () { f.contentWindow.focus(); f.contentWindow.print(); setTimeout(function () { f.remove(); }, 2000); }, 300);\n  log('Print dialog opened — choose “Save as PDF” for a PDF at ' + sh.sheet + '.', 'o');\n}\nfunction csvCell(v) { v = String(v == null ? '' : v); return /[\",\\n]/.test(v) ? '\"' + v.replace(/\"/g, '\"\"') + '\"' : v; }\nfunction exportCSV() {\n  var rows = [['Column', 'Qty', 'Mark', 'Bar', 'No. per column', 'Shape', 'A', 'B', 'C', 'Length mm', 'Total m', 'Mass kg per column', 'Mass kg all', 'Location']];\n  S.P.cols.forEach(function (c) {\n    var M; try { M = CD.compute(S.P, c); } catch (e) { return; }\n    M.bars.forEach(function (b) { var d = b.dims || {}; rows.push([c.mark, c.qty, b.mark, b.text, b.no, b.shape, d.A, d.B, d.C, b.len, CD.fmt(b.total, 2), CD.fmt(b.massTot, 1), CD.fmt(b.massTot * c.qty, 1), (b.locs || []).join('; ')]); });\n  });\n  download((S.P.meta.job || 'project').replace(/[^\\w\\-]+/g, '_') + '_BBS.csv', rows.map(function (r) { return r.map(csvCell).join(','); }).join('\\r\\n'), 'text/csv');\n}\nfunction saveProject() { download((S.P.meta.job || 'project').replace(/[^\\w\\-]+/g, '_') + '.cdp.json', JSON.stringify(S.P, null, 1), 'application/json'); pushRecent(); toast('Project saved'); }\nfunction loadProjectText(t) {\n  try {\n    var P = JSON.parse(t);\n    if (!P || !P.cols || !P.cols.length || !P.code) throw new Error('not a Column Detailer project');\n    var base = CD.defaultProject(P.code), hadStyle = !!P.style;\n    P.cols.forEach(function (c) { if (c.base && c.base.belowGL == null && c.base.depth > 0) { c.base.glDepth = 450; c.base.belowGL = Math.max(0, c.base.depth - 450); } });\n    P.mat = Object.assign(base.mat, P.mat); P.sheet = Object.assign(base.sheet, P.sheet); P.opt = Object.assign(base.opt, P.opt); P.meta = Object.assign(base.meta, P.meta);\n    P.cols = P.cols.map(function (c) { var d = CD.defaultColumn(P.code, 1); return deepMerge(d, c); });\n    P.active = Math.min(P.active | 0, P.cols.length - 1);\n    CD.ensureStyle(P); if (!hadStyle) P.style.mode = 'std';\n    S.P = P; enterWorkspace(); toast('Project loaded');\n  } catch (e) { toast('Cannot open file: ' + e.message, 4000); }\n}\nfunction deepMerge(a, b) {\n  Object.keys(b).forEach(function (k) {\n    if (Array.isArray(b[k])) a[k] = b[k]; else if (b[k] && typeof b[k] === 'object' && a[k] && typeof a[k] === 'object') deepMerge(a[k], b[k]); else a[k] = b[k];\n  });\n  return a;\n}\n\n/* =============================================================== IMPORT === */\nvar IMP = null;\nfunction modal(html, cls) { var h = $('#modalHost'); h.innerHTML = '<div class=\"modal\"><div class=\"dlg ' + (cls || '') + '\">' + html + '</div></div>'; return h; }\nfunction closeModal() { $('#modalHost').innerHTML = ''; }\nvar MODE_TXT = {single: 'IMPORT SINGLE COLUMN', multiple: 'IMPORT MULTIPLE COLUMNS', grouped: 'IMPORT GROUPED COLUMNS'};\nfunction openImport(mode, fresh) {\n  IMP = {mode: mode, fresh: fresh, parsed: null, res: null, layers: null, unit: 'auto', tol: 5, pick: 0, file: ''};\n  modal('<header><b>' + MODE_TXT[mode] + '</b><button class=\"btn sm\" id=\"impX\">✕</button></header><section>' +\n    '<div class=\"drop\" id=\"drop\"><p style=\"font-size:15px;color:var(--tx)\"><b>Drop a DXF plan here</b> or choose a file</p><p>Closed rectangles / polylines / four-line boxes and circles on any layer are recognised as columns; TEXT near them (C1, C2, …) is used as the mark.</p>' +\n    '<p><button class=\"btn go\" id=\"impPick\">Choose DXF / DWG…</button> &nbsp; <button class=\"btn\" id=\"impSample\">Use built-in sample plan</button></p>' +\n    '<p style=\"font-size:11.5px\">DWG: browsers cannot read binary DWG. Save As → <b>DXF (R12–2018)</b> in AutoCAD / BricsCAD / DraftSight, or use “Convert DWG” in the desktop build (needs ODA File Converter).</p></div><div id=\"impMsg\"></div></section><footer><button class=\"btn\" id=\"impCancel\">Cancel</button></footer>');\n  $('#impX').onclick = $('#impCancel').onclick = closeModal;\n  var dz = $('#drop');\n  $('#impPick').onclick = function () { $('#fileDxf').click(); };\n  $('#fileDxf').onchange = function () { var f = this.files[0]; if (f) readImportFile(f); this.value = ''; };\n  $('#impSample').onclick = function () { IMP.file = 'sample-plan.dxf'; startAnalysis(CD.parseDXF(CD.sampleDXF())); };\n  dz.ondragover = function (e) { e.preventDefault(); dz.classList.add('hot'); }; dz.ondragleave = function () { dz.classList.remove('hot'); };\n  dz.ondrop = function (e) { e.preventDefault(); dz.classList.remove('hot'); var f = e.dataTransfer.files[0]; if (f) readImportFile(f); };\n}\nfunction readImportFile(f) {\n  IMP.file = f.name;\n  f.arrayBuffer().then(function (buf) {\n    var tag = CD.isDWG(buf);\n    if (tag) {\n      var msg = $('#impMsg');\n      msg.innerHTML = '<div class=\"sev err\"><b>✖</b><div><b>' + esc(f.name) + '</b> is a binary DWG (AutoCAD ' + CD.dwgVersion(tag) + '). It cannot be read directly in this program.<span class=\"r\">Open it in AutoCAD / BricsCAD / DraftSight → SAVEAS → “AutoCAD DXF” (any version), then import the .dxf. ' +\n        (window.cdDesktop && window.cdDesktop.dwgToDxf ? '<br><button class=\"btn sm go\" id=\"cvt\">Convert with ODA File Converter</button>' : 'The desktop build can convert automatically if ODA File Converter is installed.') + '</span></div></div>';\n      var cv = $('#cvt'); if (cv) cv.onclick = function () { window.cdDesktop.dwgToDxf(f.path).then(function (txt) { startAnalysis(CD.parseDXF(txt)); }).catch(function (e) { toast('Conversion failed: ' + e); }); };\n      return;\n    }\n    var txt = new TextDecoder('utf-8').decode(buf);\n    if (txt.indexOf('\\0') >= 0 || !/SECTION|ENTITIES/.test(txt)) { try { txt = new TextDecoder('latin1').decode(buf); } catch (e) { /* ignore */ } }\n    if (!/ENTITIES/.test(txt)) { $('#impMsg').innerHTML = '<div class=\"sev err\"><b>✖</b><div>This does not look like an ASCII DXF file (no ENTITIES section). Binary DXF is not supported — save as ASCII DXF.</div></div>'; return; }\n    startAnalysis(CD.parseDXF(txt));\n  });\n}\nfunction startAnalysis(parsed) { IMP.parsed = parsed; IMP.layers = null; analyse(); }\nfunction analyse() {\n  var res = CD.importAnalyze(IMP.parsed, {layers: IMP.layers, unit: IMP.unit, tol: IMP.tol});\n  CD.importDefaultSelection(res);\n  IMP.res = res; if (!IMP.layers) { IMP.layers = {}; Object.keys(res.layers).forEach(function (l) { IMP.layers[l] = true; }); }\n  if (IMP.mode === 'single') IMP.pick = res.groups.length ? 0 : -1;\n  drawImport();\n}\nfunction flagPills(fl) { return fl.filter(function (f) { return f !== 'nolabel' || true; }).map(function (f) { return '<span class=\"pill' + (/wall|small|tagmismatch/.test(f) ? ' r' : '') + '\">' + ({wall: 'wall?', small: 'small', angled: 'angled', nonmodular: 'non-25', nolabel: 'no label', tagmismatch: 'size text ≠'}[f] || f) + '</span>'; }).join(''); }\nfunction drawImport() {\n  var R = IMP.res, mode = IMP.mode, h = '';\n  var lay = Object.keys(R.layers).map(function (l) {\n    var L = R.layers[l], any = L.rect || L.circ || L.text;\n    return '<label style=\"display:inline-flex;gap:4px;margin:0 10px 4px 0;opacity:' + (any ? 1 : .55) + '\"><input type=\"checkbox\" data-il=\"' + esc(l) + '\"' + (IMP.layers[l] !== false ? ' checked' : '') + '>' + esc(l) + ' <small style=\"color:var(--mu)\">(' + L.rect + '▭ ' + L.circ + '○ ' + L.text + 'T)</small></label>';\n  }).join('');\n  var rows = '';\n  if (mode === 'multiple') {\n    rows = '<table class=\"t\"><tr><th></th><th>#</th><th>Mark</th><th>Size</th><th>Notes</th></tr>' + R.cands.map(function (c) {\n      return '<tr><td><input type=\"checkbox\" data-ci=\"' + c.id + '\"' + (c.include !== false ? ' checked' : '') + '></td><td>' + c.id + '</td><td><input type=\"text\" data-cl=\"' + c.id + '\" value=\"' + esc(c.label || '') + '\" placeholder=\"auto\"></td><td>' + (c.shape === 'circ' ? 'Ø' + Math.round(c.D) : Math.round(c.b) + '×' + Math.round(c.h)) + '</td><td>' + flagPills(c.flags) + '</td></tr>';\n    }).join('') + '</table>';\n  } else {\n    rows = '<table class=\"t\"><tr><th>' + (mode === 'single' ? '●' : '✓') + '</th><th>Mark</th><th>Size</th><th class=\"n\">Nos</th><th>Labels / notes</th></tr>' + R.groups.map(function (g, i) {\n      var fl = Object.keys(g.flags);\n      return '<tr><td><input type=\"' + (mode === 'single' ? 'radio' : 'checkbox') + '\" name=\"gp\" data-gi=\"' + i + '\"' + (mode === 'single' ? (IMP.pick === i ? ' checked' : '') : (g.include && g.qty ? ' checked' : '')) + '></td><td><input type=\"text\" data-gm=\"' + i + '\" value=\"' + esc(g.mark) + '\"></td><td>' + (g.shape === 'circ' ? 'Ø' + Math.round(g.D) : Math.round(g.b) + '×' + Math.round(g.h)) + '</td><td class=\"n\"><b>' + g.qty + '</b></td><td>' + (g.labelList.length > 1 ? '<span class=\"pill r\">' + g.labelList.join('/') + '</span>' : '') + flagPills(fl) + '</td></tr>';\n    }).join('') + '</table>';\n  }\n  var ck = R.checks.map(function (c) { return '<div class=\"sev ' + c.level + '\"><b>' + ({err: '✖', warn: '▲', info: 'ℹ', ok: '✔'}[c.level]) + '</b><div>' + esc(c.msg) + '</div></div>'; }).join('');\n  var nSel = mode === 'single' ? (IMP.pick >= 0 ? 1 : 0) : (mode === 'multiple' ? R.cands.filter(function (c) { return c.include !== false; }).length : R.groups.filter(function (g) { return g.include && g.qty; }).length);\n  $('#modalHost .dlg').innerHTML = '<header><b>' + MODE_TXT[mode] + ' — ' + esc(IMP.file) + '</b><button class=\"btn sm\" id=\"impX\">✕</button></header><section>' +\n    '<div style=\"display:flex;gap:18px;flex-wrap:wrap;margin-bottom:10px\"><div><small style=\"color:var(--mu)\">FOUND</small><br><b style=\"font-size:18px\">' + R.cands.length + '</b> columns in <b style=\"font-size:18px\">' + R.groups.length + '</b> group(s)</div>' +\n    '<div><small style=\"color:var(--mu)\">UNIT</small><br><select id=\"impUnit\" style=\"width:120px\"><option value=\"auto\">Auto (' + ({1: 'inch', 2: 'ft', 4: 'mm', 5: 'cm', 6: 'm'}[R.unit]) + ')</option><option value=\"4\">mm</option><option value=\"5\">cm</option><option value=\"6\">m</option><option value=\"1\">inch</option></select></div>' +\n    '<div><small style=\"color:var(--mu)\">GROUP TOLERANCE</small><br><input type=\"number\" id=\"impTol\" value=\"' + IMP.tol + '\" style=\"width:80px\"> mm</div></div>' +\n    '<div style=\"margin-bottom:10px\"><small style=\"color:var(--mu)\">LAYERS TO SCAN</small><br>' + lay + '</div>' +\n    '<div class=\"imp\"><div><div class=\"pv\">' + CD.importPreviewSVG(R, 640, 380) + '</div><div style=\"margin-top:10px\">' + ck + '</div></div><div style=\"max-height:56vh;overflow:auto\">' + rows + '</div></div></section>' +\n    '<footer><span style=\"margin-right:auto;color:var(--mu);font-size:12px\">' + (mode === 'single' ? 'Select the column to detail.' : mode === 'multiple' ? 'Each ticked column becomes its own mark.' : 'Ticked groups become one mark each with the counted quantity.') + (IMP.fresh ? '' : ' Columns are added to the current project.') + '</span><button class=\"btn\" id=\"impCancel\">Cancel</button><button class=\"btn go\" id=\"impGo\"' + (nSel ? '' : ' disabled') + '>Import ' + nSel + ' column mark' + (nSel === 1 ? '' : 's') + ' ▶</button></footer>';\n  $('#impUnit').value = IMP.unit;\n  $('#impX').onclick = $('#impCancel').onclick = closeModal;\n  $('#impGo').onclick = doImport;\n}\nfunction wireImportEvents() {\n  var host = $('#modalHost');\n  host.addEventListener('change', function (e) {\n    var t = e.target; if (!IMP || !IMP.res) return;\n    if (t.dataset.il != null) { IMP.layers[t.dataset.il] = t.checked; analyse(); }\n    else if (t.id === 'impUnit') { IMP.unit = t.value; analyse(); }\n    else if (t.id === 'impTol') { IMP.tol = Math.max(0, +t.value || 5); analyse(); }\n    else if (t.dataset.ci != null) { IMP.res.cands.filter(function (c) { return c.id === +t.dataset.ci; })[0].include = t.checked; CD.importRegroup(IMP.res); drawImport(); }\n    else if (t.dataset.cl != null) { IMP.res.cands.filter(function (c) { return c.id === +t.dataset.cl; })[0].label = t.value.trim().toUpperCase() || undefined; }\n    else if (t.dataset.gi != null) { var i = +t.dataset.gi; if (IMP.mode === 'single') IMP.pick = i; else IMP.res.groups[i].include = t.checked; drawImport(); }\n    else if (t.dataset.gm != null) { IMP.res.groups[+t.dataset.gm].mark = t.value.trim() || IMP.res.groups[+t.dataset.gm].mark; }\n  });\n}\nfunction doImport() {\n  var R = IMP.res, P = S.P || CD.defaultProject(S.startCode), made;\n  if (IMP.mode === 'single') {\n    var g = R.groups[IMP.pick], m = g && g.members.filter(function (c) { return c.include !== false; })[0] || (g && g.members[0]);\n    if (!m) return;\n    made = CD.importBuild(P, R, 'single', {pick: m.id}); if (made[0]) made[0].mark = g.mark;\n  } else made = CD.importBuild(P, R, IMP.mode, {});\n  if (!made.length) return toast('Nothing selected');\n  var used = {}; (IMP.fresh ? [] : P.cols).forEach(function (c) { used[c.mark] = 1; });\n  made.forEach(function (c) { var m = c.mark, n = 2; while (used[m]) m = c.mark + '-' + (n++); c.mark = m; used[m] = 1; });\n  if (IMP.fresh) { P.cols = made; P.active = 0; if (IMP.file) P.meta.job = IMP.file.replace(/\\.[^.]+$/, '').toUpperCase(); } else { P.cols = P.cols.concat(made); P.active = P.cols.length - made.length; }\n  S.P = P; closeModal();\n  if (IMP.fresh) enterWorkspace(); else { refreshAll(); renderSheet(true); }\n  toast('Imported ' + made.length + ' column mark(s) — check bars, storeys and footing before issuing.', 4500);\n}\n\n/* ============================================================ START / BOOT = */\nfunction showStart() {\n  $('#app').classList.add('hide'); $('#start').classList.remove('hide');\n  var r = lsGet('cdp.recent') || [];\n  $('#recent').innerHTML = r.length ? r.map(function (x, i) { return '<div class=\"recent\" data-r=\"' + i + '\"><span>' + esc(x.name) + ' <small>' + (x.code === 'ACI' ? 'ACI' : 'IStructE') + ' · ' + (x.n || 1) + ' col</small></span><small>' + new Date(x.t).toLocaleDateString() + '</small></div>'; }).join('') : '<small style=\"color:var(--mu)\">No recent projects yet.</small>';\n}\nfunction newProject(code) { S.P = CD.defaultProject(code); S.P.sheet.theme = document.documentElement.dataset.theme || 'dark'; }\nfunction sampleProject() {\n  if (S.startCode !== 'ACI') return CD.detailProExample();\n  var P = CD.defaultProject(S.startCode), c = P.cols[0];\n  P.meta.job = 'EXAMPLE BUILDING'; P.meta.client = 'DEMO'; P.meta.location = '';\n  c.mark = 'C1'; c.qty = 24; c.typ.b = 250; c.typ.h = 250; c.typ.nb = 3; c.typ.nh = 3; c.typ.des = S.startCode === 'ACI' ? 16 : 16; c.typ.n = 8; c.nSt = 3; CD.resizeStoreys(c, P.code); CD.applyTypical(c);\n  c.base.ftg.B = c.base.ftg.L = 1800; c.base.ftg.T = 500; c.base.depth = 1500;\n  return P;\n}\nfunction bootStart() {\n  var cs = $('#codeSel');\n  cs.addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; S.startCode = b.dataset.c; $$('#codeSel button').forEach(function (x) { x.classList.toggle('on', x === b); }); });\n  $$('.card').forEach(function (b) {\n    b.onclick = function () {\n      newProject(S.startCode);\n      if (b.dataset.m === 'manual') { enterWorkspace(false); toast('Enter the inputs, then press START DETAILING'); }\n      else openImport(b.dataset.m, true);\n    };\n  });\n  $('#stOpen').onclick = function () { $('#fileOpen').click(); };\n  $('#stSample').onclick = function () { S.P = sampleProject(); enterWorkspace(); };\n  $('#stSampleDxf').onclick = function () { download('sample_column_plan.dxf', CD.sampleDXF(), 'application/dxf'); };\n  $('#recent').onclick = function (e) { var r = e.target.closest('[data-r]'); if (!r) return; var x = (lsGet('cdp.recent') || [])[+r.dataset.r]; if (x) loadProjectText(JSON.stringify(x.data)); };\n}\nfunction runSplash() {\n  $('#spVer').textContent = CD.VERSION + ' (' + CD.BUILD + ')';\n  var steps = [\n    [8, 'Initialising detailing kernel…'], [22, 'Loading IStructE SMDSC rule base — sections 4, 5, 6.4, MC1–MC6…'], [40, 'Loading BS 8666 shape codes and Table B.1 bend data…'],\n    [58, 'Loading ACI 315-99 rule base — Figs. 4–14, Table 1 hooks, ACI 318M laps…'], [74, 'Preparing CAD viewport, layers and DXF writer…'], [90, 'Starting user interface…'], [100, 'Ready']\n  ], i = 0, bar = $('#spBar'), msg = $('#spMsg');\n  (function next() {\n    if (i >= steps.length) { setTimeout(function () { $('#splash').classList.add('out'); setTimeout(function () { $('#splash').remove(); }, 700); showStart(); }, 350); return; }\n    bar.style.transition = 'width .45s ease'; bar.style.width = steps[i][0] + '%'; msg.textContent = steps[i][1]; i++;\n    setTimeout(next, 420 + (i % 2) * 160);\n  })();\n}\nCD.boot = function () {\n  bindEvents(); setupViewer(); bootStart(); wireImportEvents();\n  var q = /[?&]nosplash/.test(location.search);\n  if (q) { $('#splash').remove(); showStart(); } else runSplash();\n};\nwindow.addEventListener('DOMContentLoaded', function () { CD.boot(); });\nwindow.addEventListener('error', function (e) { try { log('JS error: ' + e.message, 'e'); } catch (x) { /* ignore */ } });\n})();\n\n/* ==== 50-update.js ==== */\n/* ==========================================================================\n   SOFTWARE UPDATE : check / download / verify / install  +  developer publishing\n   Update server = any web host serving update.json + the release .html files\n   (or tools/update-server.js which also accepts publishing).\n   ========================================================================== */\n(function () {\n'use strict';\nvar U = CD.Update = {tab: 'upd', res: {state: 'idle'}, run: null, dev: {}, open: false};\nvar KEY = 'cdp.upd';\nfunction $(s) { return document.querySelector(s); }\nfunction esc(s) { return String(s == null ? '' : s).replace(/[&<>\"]/g, function (c) { return {'&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;'}[c]; }); }\nfunction ls(k, v) { try { if (v === undefined) return JSON.parse(localStorage.getItem(k)); localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} return null; }\nfunction toast(m) { var t = $('#toast'); if (!t) return; t.textContent = m; t.style.display = 'block'; clearTimeout(toast.h); toast.h = setTimeout(function () { t.style.display = 'none'; }, 3200); }\n\n/* ---------------------------------------------------------- settings --- */\nU.cfg = function () {\n  var c = Object.assign({url: CD.UPDATE_DEFAULT_URL || '', auto: true, every: 'startup', channel: 'stable', last: 0, skip: '', devHash: '', pubUrl: '', token: '', gh: null}, ls(KEY) || {});\n  return c;\n};\nU.save = function (c) { ls(KEY, c); };\n\n/* ----------------------------------------------------------- helpers --- */\nU.cmp = function (a, b) {\n  var x = String(a).split('.').map(Number), y = String(b).split('.').map(Number);\n  for (var i = 0; i < 3; i++) { var d = (x[i] || 0) - (y[i] || 0); if (d) return d > 0 ? 1 : -1; }\n  return 0;\n};\nU.validVer = function (v) { return /^\\d+\\.\\d+\\.\\d+$/.test(v); };\nfunction sha256js(bytes) {      // fallback when crypto.subtle is unavailable\n  var K = [], p = 2, n = 0, i, j;\n  function isP(x) { for (var k = 2; k * k <= x; k++) if (x % k === 0) return false; return true; }\n  while (n < 64) { if (isP(p)) { K[n++] = (Math.pow(p, 1 / 3) % 1) * 4294967296 | 0; } p++; }\n  var H = [], q = 2; n = 0; while (n < 8) { if (isP(q)) { H[n++] = (Math.sqrt(q) % 1) * 4294967296 | 0; } q++; }\n  var l = bytes.length, nb = ((l + 9 + 63) >> 6) << 6, m = new Uint8Array(nb);\n  m.set(bytes); m[l] = 0x80;\n  var dv = new DataView(m.buffer); dv.setUint32(nb - 4, (l * 8) >>> 0); dv.setUint32(nb - 8, Math.floor(l / 536870912));\n  var w = new Array(64);\n  function rr(x, r) { return (x >>> r) | (x << (32 - r)); }\n  for (var o = 0; o < nb; o += 64) {\n    for (i = 0; i < 16; i++) w[i] = dv.getUint32(o + i * 4);\n    for (i = 16; i < 64; i++) { var s0 = rr(w[i - 15], 7) ^ rr(w[i - 15], 18) ^ (w[i - 15] >>> 3), s1 = rr(w[i - 2], 17) ^ rr(w[i - 2], 19) ^ (w[i - 2] >>> 10); w[i] = (w[i - 16] + s0 + w[i - 7] + s1) | 0; }\n    var a = H.slice();\n    for (i = 0; i < 64; i++) {\n      var S1 = rr(a[4], 6) ^ rr(a[4], 11) ^ rr(a[4], 25), ch = (a[4] & a[5]) ^ (~a[4] & a[6]), t1 = (a[7] + S1 + ch + K[i] + w[i]) | 0;\n      var S0 = rr(a[0], 2) ^ rr(a[0], 13) ^ rr(a[0], 22), mj = (a[0] & a[1]) ^ (a[0] & a[2]) ^ (a[1] & a[2]), t2 = (S0 + mj) | 0;\n      a = [(t1 + t2) | 0, a[0], a[1], a[2], (a[3] + t1) | 0, a[4], a[5], a[6]];\n    }\n    for (j = 0; j < 8; j++) H[j] = (H[j] + a[j]) | 0;\n  }\n  return H.map(function (x) { return ('00000000' + (x >>> 0).toString(16)).slice(-8); }).join('');\n}\nU.sha256 = function (buf) {\n  var bytes = buf instanceof Uint8Array ? buf : new Uint8Array(buf);\n  if (window.crypto && crypto.subtle && crypto.subtle.digest) {\n    return crypto.subtle.digest('SHA-256', bytes).then(function (d) { return Array.prototype.map.call(new Uint8Array(d), function (b) { return ('0' + b.toString(16)).slice(-2); }).join(''); });\n  }\n  return Promise.resolve(sha256js(bytes));\n};\nfunction base(url) { url = (url || '').trim(); if (!url) return ''; return url.replace(/update\\.json.*$/, '').replace(/\\/?$/, '/'); }\nfunction fmtDate(t) { return t ? new Date(t).toLocaleString() : 'never'; }\nfunction fmtSize(n) { return n > 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.round(n / 1024) + ' KB'; }\n\n/* ------------------------------------------------------------- check --- */\nU.check = function (silent) {\n  var c = U.cfg(), b = base(c.url);\n  if (!b) { U.res = {state: 'error', err: 'No update server is set. Open Settings and enter the update server address (given by the software developer).'}; if (!silent) render(); return Promise.resolve(U.res); }\n  U.res = {state: 'checking'}; if (U.open) render();\n  var ctl = typeof AbortController !== 'undefined' ? new AbortController() : null, to = setTimeout(function () { if (ctl) ctl.abort(); }, 12000);\n  return fetch(b + 'update.json?t=' + Date.now(), {cache: 'no-store', signal: ctl ? ctl.signal : undefined}).then(function (r) {\n    if (r.status === 404 && /githubusercontent|github\\.io/.test(b)) return {app: 'ColumnDetailerPro', latest: {}, history: []};   // repository exists, nothing released yet\n    if (!r.ok) throw new Error('Server answered HTTP ' + r.status);\n    return r.json();\n  }).then(function (m) {\n    clearTimeout(to);\n    if (!m || m.app !== 'ColumnDetailerPro' || !m.latest) throw new Error('Not a Column Detailer Pro update feed.');\n    U.manifest = m;\n    var e = m.latest[c.channel] || (c.channel === 'beta' ? m.latest.stable : null);\n    c.last = Date.now(); U.save(c);\n    if (e && e.version && U.cmp(e.version, CD.VERSION) > 0 && !(c.skip === e.version && !e.mandatory)) U.res = {state: 'available', entry: e, base: b, ts: c.last};\n    else U.res = {state: 'uptodate', entry: e, ts: c.last};\n    U.afterCheck(); if (U.open || !silent) render(); return U.res;\n  }).catch(function (err) {\n    clearTimeout(to);\n    U.res = {state: 'error', err: (err && err.name === 'AbortError') ? 'The update server did not answer (timeout).' : 'Cannot reach the update server: ' + (err && err.message || err)};\n    if (U.open || !silent) render(); return U.res;\n  });\n};\nU.afterCheck = function () {\n  var av = U.res.state === 'available', e = U.res.entry;\n  document.querySelectorAll('.updDot').forEach(function (d) { d.classList.toggle('hide', !av); });\n  var s = $('#stUpdSub'); if (s) s.textContent = av ? 'Update ' + e.version + ' available' : 'v' + CD.VERSION;\n  document.querySelectorAll('.updBtn').forEach(function (b) { b.classList.toggle('has', av); });\n  if (av && !U.announced) { U.announced = true; toast('Software update ' + e.version + ' is available'); if (e.mandatory && !U.open) U.show('upd'); }\n};\nU.autoCheck = function () {\n  var c = U.cfg(); if (!c.auto || !base(c.url)) return;\n  var gap = {startup: 0, daily: 86400000, weekly: 604800000}[c.every] || 0;\n  if (Date.now() - (c.last || 0) < gap) return;\n  U.check(true);\n};\n\n/* ----------------------------------------------------------- install --- */\nfunction setStep(i, st, msg) { U.run.steps[i] = st; if (msg) U.run.msg = msg; if (U.open) render(); }\nU.install = function () {\n  var e = U.res.entry, b = U.res.base; if (!e) return;\n  var url = /^https?:/.test(e.file) ? e.file : b + e.file;\n  U.run = {steps: ['run', 'wait', 'wait'], msg: 'Downloading ' + e.file + '…', pct: 0, done: false, html: null};\n  render();\n  fetch(url, {cache: 'no-store'}).then(function (r) {\n    if (!r.ok) throw new Error('Download failed (HTTP ' + r.status + ')');\n    var total = +r.headers.get('content-length') || e.size || 0;\n    if (!r.body || !r.body.getReader) return r.arrayBuffer();\n    var rd = r.body.getReader(), chunks = [], got = 0;\n    return (function pump() {\n      return rd.read().then(function (x) {\n        if (x.done) { var out = new Uint8Array(got), o = 0; chunks.forEach(function (c) { out.set(c, o); o += c.length; }); return out; }\n        chunks.push(x.value); got += x.value.length; U.run.pct = total ? Math.min(99, got / total * 100) : 50; if (U.open) renderProgress(); return pump();\n      });\n    })();\n  }).then(function (buf) {\n    var bytes = buf instanceof Uint8Array ? buf : new Uint8Array(buf);\n    U.run.pct = 100; setStep(0, 'ok'); setStep(1, 'run', 'Verifying integrity (SHA-256)…');\n    return U.sha256(bytes).then(function (h) {\n      if (e.sha256 && h !== e.sha256) throw new Error('Integrity check failed - the downloaded file does not match the published checksum. Nothing was installed.');\n      var txt = new TextDecoder('utf-8').decode(bytes);\n      if (txt.indexOf('ColumnDetailerPro') < 0 || txt.indexOf(\"CD.VERSION = '\" + e.version + \"'\") < 0) throw new Error('The file is not Column Detailer Pro ' + e.version + '. Nothing was installed.');\n      setStep(1, 'ok'); setStep(2, 'run', 'Installing…');\n      return U.apply(txt, e, bytes);\n    });\n  }).catch(function (err) {\n    U.run.error = err.message || String(err); U.run.msg = U.run.error; var i = U.run.steps.indexOf('run'); if (i >= 0) U.run.steps[i] = 'err'; render();\n  });\n};\nU.apply = function (txt, e, bytes) {\n  U.run.html = txt;\n  if (window.cdDesktop && cdDesktop.installUpdate) {\n    return cdDesktop.installUpdate(txt, e.version, e.sha256).then(function () { setStep(2, 'ok', 'Update installed. Restarting Column Detailer Pro…'); U.run.done = true; U.run.desktop = true; render(); }).catch(function (er) { throw new Error('Install failed: ' + er); });\n  }\n  var blob = new Blob([bytes], {type: 'text/html'}), a = document.createElement('a');\n  a.href = URL.createObjectURL(blob); a.download = 'ColumnDetailerPro.html'; document.body.appendChild(a); a.click();\n  setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 800);\n  U.run.done = true; setStep(2, 'ok', 'Update ' + e.version + ' downloaded and verified.'); return null;\n};\nU.relaunch = function () {   // switch this window to the downloaded version immediately\n  if (U.run && U.run.desktop && window.cdDesktop && cdDesktop.relaunch) return cdDesktop.relaunch();\n  if (U.run && U.run.html) { document.open(); document.write(U.run.html); document.close(); }\n};\nU.installPackage = function (file) {\n  file.text().then(function (t) {\n    var p = JSON.parse(t);\n    if (p.format !== 'cdupdate/1' || !p.entry || typeof p.html !== 'string') throw new Error('Not a Column Detailer update package.');\n    var bytes = new TextEncoder().encode(p.html);\n    return U.sha256(bytes).then(function (h) {\n      if (h !== p.entry.sha256) throw new Error('Package is corrupted (checksum mismatch).');\n      if (U.cmp(p.entry.version, CD.VERSION) <= 0) throw new Error('Package version ' + p.entry.version + ' is not newer than the installed ' + CD.VERSION + '.');\n      U.res = {state: 'available', entry: p.entry, base: ''}; U.tab = 'upd'; U.run = {steps: ['ok', 'ok', 'run'], msg: 'Installing…', pct: 100};\n      return U.apply(p.html, p.entry, bytes).then(function () { setStep(2, 'ok', 'Update ' + p.entry.version + ' (offline package) verified and ready.'); render(); });\n    });\n  }).catch(function (e) { U.res = {state: 'error', err: e.message}; U.run = null; render(); });\n};\n\n/* ---------------------------------------------------------- developer --- */\nU.devLoad = function (file) {\n  file.arrayBuffer().then(function (buf) {\n    var bytes = new Uint8Array(buf), txt = new TextDecoder('utf-8').decode(bytes), m = /CD\\.VERSION = '([^']+)'/.exec(txt), d = U.dev;\n    if (txt.indexOf('ColumnDetailerPro') < 0 || !m) { d.err = 'This is not a Column Detailer Pro build (run node build.js and pick dist/ColumnDetailerPro.html).'; d.file = null; return render(); }\n    return U.sha256(bytes).then(function (h) {\n      d.err = ''; d.file = {name: file.name, size: bytes.length, sha: h, ver: m[1], txt: txt};\n      d.version = m[1]; d.title = d.title || '';\n      var rel = (CD.RELEASES || []).filter(function (r) { return r.v === m[1]; })[0];   // only when the loaded build is the one running\n      if (m[1] === CD.VERSION && rel && !(d.notes && d.notes.length)) { d.notes = rel.items.map(function (i) { return {t: i.t, x: i.x}; }); d.title = d.title || rel.title; }\n      render();\n    });\n  });\n};\nU.devEntry = function () {\n  var d = U.dev, f = d.file;\n  return {version: d.version, channel: d.channel || 'stable', date: new Date().toISOString().slice(0, 10), title: d.title || '', notes: (d.notes || []).filter(function (n) { return n.x && n.x.trim(); }),\n    file: 'ColumnDetailerPro-' + d.version + '.html', size: f.size, sha256: f.sha, mandatory: !!d.mandatory, minVersion: d.minVersion || ''};\n};\nU.devValidate = function () {\n  var d = U.dev; if (!d.file) return 'Choose the built ColumnDetailerPro.html first.';\n  if (!U.validVer(d.version || '')) return 'Version must look like 1.2.0.';\n  if (d.version !== d.file.ver) return 'Version must equal the CD.VERSION inside the build (' + d.file.ver + ').';\n  if (!(d.notes || []).some(function (n) { return n.x && n.x.trim(); })) return 'Add at least one release-note line - users see this list.';\n  return '';\n};\nU.devPublish = function () {\n  var er = U.devValidate(), c = U.cfg(), d = U.dev; if (er) { d.msg = {bad: 1, t: er}; return render(); }\n  var pb = base(d.pubUrl != null ? d.pubUrl : c.pubUrl), tok = d.token != null ? d.token : c.token;\n  if (!pb) { d.msg = {bad: 1, t: 'No publish server set. With GitHub hosting use \"Export files for GitHub\" and upload the two files on github.com.'}; return render(); }\n  if (/githubusercontent|github\\.io|github\\.com/.test(pb)) { d.msg = {bad: 1, t: 'GitHub cannot receive uploads from this button. Use \"Export files for GitHub\", then upload update.json and the .html on github.com (Add file > Upload files).'}; return render(); }\n  c.pubUrl = pb; c.token = tok; U.save(c);\n  d.msg = {t: 'Uploading ' + fmtSize(d.file.size) + '…'}; d.busy = 1; render();\n  var entry = U.devEntry();\n  fetch(pb + 'publish', {method: 'POST', headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + tok}, body: JSON.stringify({entry: entry, html: d.file.txt})}).then(function (r) {\n    return r.json().catch(function () { return {}; }).then(function (j) { if (!r.ok) throw new Error(j.error || ('HTTP ' + r.status)); return j; });\n  }).then(function (j) {\n    d.busy = 0; d.msg = {ok: 1, t: 'Published ' + entry.version + ' to ' + entry.channel + ' channel. Users are notified on their next check.' + (j.note ? ' ' + j.note : '')};\n    d.published = entry; render();\n  }).catch(function (e) { d.busy = 0; d.msg = {bad: 1, t: 'Publish failed: ' + (e.message || e)}; render(); });\n};\n\n/* ---- publish straight to a GitHub repository through the GitHub REST API ---- */\nfunction b64(bytes) { var s = '', i, ch = 0x8000; for (i = 0; i < bytes.length; i += ch) s += String.fromCharCode.apply(null, bytes.subarray(i, i + ch)); return btoa(s); }\nfunction unb64(t) { var bin = atob(String(t).replace(/\\s/g, '')), a = new Uint8Array(bin.length); for (var i = 0; i < bin.length; i++) a[i] = bin.charCodeAt(i); return new TextDecoder('utf-8').decode(a); }\nU.ghDefaults = function () {\n  var c = U.cfg(), m = /githubusercontent\\.com\\/([^\\/]+)\\/([^\\/]+)\\/([^\\/]+)/.exec(c.url || ''), g = c.gh || {};\n  return {owner: g.owner || (m ? m[1] : ''), repo: g.repo || (m ? m[2] : ''), branch: g.branch || (m ? m[3] : 'main'), token: g.token || '', api: g.api || ''};\n};\nfunction ghReq(g, method, path, body) {\n  var url = (g.api || 'https://api.github.com') + '/repos/' + encodeURIComponent(g.owner) + '/' + encodeURIComponent(g.repo) + '/contents/' + path + (method === 'GET' ? '?ref=' + encodeURIComponent(g.branch) + '&t=' + Date.now() : '');\n  var h = {'Authorization': 'Bearer ' + g.token, 'Accept': 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28'};\n  if (body) h['Content-Type'] = 'application/json';\n  return fetch(url, {method: method, headers: h, body: body ? JSON.stringify(body) : undefined, cache: 'no-store'}).then(function (r) {\n    return r.json().catch(function () { return {}; }).then(function (j) { return {ok: r.ok, status: r.status, j: j}; });\n  });\n}\nfunction ghFail(r, what) {\n  if (r.status === 401) return 'GitHub rejected the token (401). Create a new token and paste it again.';\n  if (r.status === 403) return 'GitHub refused (403). The token needs \"Contents: Read and write\" permission on this repository' + (r.j && r.j.message ? ' - ' + r.j.message : '') + '.';\n  if (r.status === 404) return 'GitHub answered \"not found\" (404) while ' + what + '. Check the username, repository name and branch - and that the token can access this repository.';\n  return 'GitHub error ' + r.status + (r.j && r.j.message ? ': ' + r.j.message : '') + ' while ' + what + '.';\n}\nU.devGitHub = function () {\n  var er = U.devValidate(), d = U.dev; if (er) { d.msg = {bad: 1, t: er}; return render(); }\n  var g = Object.assign(U.ghDefaults(), d.gh || {});\n  if (!g.owner || !g.repo || !g.branch || !g.token) { d.msg = {bad: 1, t: 'Fill in GitHub username, repository, branch and token.'}; return render(); }\n  var c = U.cfg(); c.gh = g; U.save(c);\n  var entry = U.devEntry(), bytes = new TextEncoder().encode(d.file.txt), sha0 = null, man = null, manSha = null;\n  d.busy = 1; d.msg = {t: 'Reading the current release list from GitHub…'}; render();\n  function say(t) { d.msg = {t: t}; render(); }\n  ghReq(g, 'GET', 'update.json').then(function (r) {\n    if (r.status === 200) { try { man = JSON.parse(unb64(r.j.content)); manSha = r.j.sha; } catch (e) { throw new Error('update.json in the repository is damaged. Delete it on github.com and try again.'); } }\n    else if (r.status !== 404) throw new Error(ghFail(r, 'reading update.json'));\n    var cur = man && man.latest && man.latest[entry.channel];\n    if (cur && U.cmp(entry.version, cur.version) <= 0) throw new Error('Version ' + entry.version + ' is not newer than the published ' + cur.version + '. Raise the version number first.');\n    say('Uploading ' + entry.file + ' (' + fmtSize(bytes.length) + ')…');\n    return ghReq(g, 'GET', entry.file);\n  }).then(function (r) {\n    if (r.status === 200) sha0 = r.j.sha; else if (r.status !== 404) throw new Error(ghFail(r, 'checking ' + entry.file));\n    var body = {message: 'Release ' + entry.version + ' - build', content: b64(bytes), branch: g.branch}; if (sha0) body.sha = sha0;\n    return ghReq(g, 'PUT', entry.file, body);\n  }).then(function (r) {\n    if (!r.ok) throw new Error(ghFail(r, 'uploading ' + entry.file));\n    say('Updating the release list (update.json)…');\n    var m = man && man.app === 'ColumnDetailerPro' ? man : {app: 'ColumnDetailerPro', latest: {}, history: []};\n    m.latest = m.latest || {}; m.latest[entry.channel] = entry;\n    m.history = [entry].concat((m.history || []).filter(function (h) { return !(h.version === entry.version && (h.channel || 'stable') === entry.channel); })); m.updated = new Date().toISOString();\n    var body = {message: 'Release ' + entry.version + ' - notes', content: b64(new TextEncoder().encode(JSON.stringify(m, null, 1))), branch: g.branch}; if (manSha) body.sha = manSha;\n    return ghReq(g, 'PUT', 'update.json', body);\n  }).then(function (r) {\n    if (!r.ok) throw new Error(ghFail(r, 'uploading update.json'));\n    d.busy = 0; d.msg = {ok: 1, t: 'Published ' + entry.version + ' to GitHub (' + g.owner + '/' + g.repo + '). Users are notified at their next check - GitHub can take up to about 5 minutes to show it.'}; render();\n  }).catch(function (e) { d.busy = 0; d.msg = {bad: 1, t: (e && e.message) || String(e)}; render(); });\n};\nfunction dl(name, data, type) {\n  var b = new Blob([data], {type: type}), a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = name; document.body.appendChild(a); a.click(); setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 600);\n}\nU.devExport = function () {\n  var er = U.devValidate(), d = U.dev; if (er) { d.msg = {bad: 1, t: er}; return render(); }\n  var e = U.devEntry(), m = U.manifest && U.manifest.app ? JSON.parse(JSON.stringify(U.manifest)) : {app: 'ColumnDetailerPro', latest: {}, history: []};\n  m.latest[e.channel] = e; m.history = [e].concat((m.history || []).filter(function (h) { return h.version !== e.version || h.channel !== e.channel; })); m.updated = new Date().toISOString();\n  dl('update.json', JSON.stringify(m, null, 1), 'application/json');\n  setTimeout(function () { dl(e.file, d.file.txt, 'text/html'); }, 400);\n  setTimeout(function () { dl('ColumnDetailerPro-' + e.version + '.cdupdate', JSON.stringify({format: 'cdupdate/1', entry: e, html: d.file.txt}), 'application/json'); }, 800);\n  d.msg = {ok: 1, t: 'Exported update.json, ' + e.file + ' and an offline .cdupdate package. Upload the first two to your web host (same folder) or send the .cdupdate file to users.'}; render();\n};\n\n/* -------------------------------------------------------------- views --- */\nvar TAGS = {new: ['NEW', 'n'], imp: ['IMPROVED', 'i'], fix: ['FIXED', 'f']};\nfunction notesHTML(items) {\n  var order = ['new', 'imp', 'fix'], h = '';\n  order.forEach(function (k) {\n    var L = (items || []).filter(function (i) { return i.t === k; }); if (!L.length) return;\n    h += L.map(function (i) { return '<li><span class=\"tg ' + TAGS[k][1] + '\">' + TAGS[k][0] + '</span><span>' + esc(i.x) + '</span></li>'; }).join('');\n  });\n  return '<ul class=\"up-notes\">' + h + '</ul>';\n}\nfunction viewUpd() {\n  var r = U.res, c = U.cfg(), h = '', ring, title, sub, act = '';\n  if (r.state === 'checking') { ring = 'spin'; title = 'Checking for updates…'; sub = 'Contacting ' + esc(base(c.url)); }\n  else if (r.state === 'available') { ring = 'new'; title = 'Update ' + esc(r.entry.version) + ' is available'; sub = 'You have ' + CD.VERSION + ' · released ' + esc(r.entry.date || '') + ' · ' + fmtSize(r.entry.size || 0) + (r.entry.mandatory ? ' · required' : ''); }\n  else if (r.state === 'uptodate') { ring = 'ok'; title = 'You are up to date'; sub = 'Column Detailer Pro ' + CD.VERSION + ' is the latest ' + esc(c.channel) + ' version · checked ' + fmtDate(r.ts); }\n  else if (r.state === 'error') { ring = 'err'; title = 'Could not check for updates'; sub = esc(r.err); }\n  else { ring = 'idle'; title = 'Software update'; sub = 'Installed version ' + CD.VERSION + ' (' + CD.BUILD + ') · last checked ' + fmtDate(c.last); }\n  if (U.run) act = '';\n  else if (r.state === 'available') act = '<button class=\"up-b pri\" data-u=\"install\">⭳ Download &amp; install</button>' + (r.entry.mandatory ? '' : '<button class=\"up-b\" data-u=\"skip\">Skip this version</button><button class=\"up-b\" data-u=\"later\">Remind me later</button>');\n  else act = '<button class=\"up-b pri\" data-u=\"check\"' + (r.state === 'checking' ? ' disabled' : '') + '>⟳ Check for updates</button>';\n  h += '<div class=\"up-card\"><div class=\"up-ring ' + ring + '\"><i></i></div><div class=\"up-ct\"><b>' + title + '</b><span>' + sub + '</span><div class=\"up-act\">' + act + '</div></div></div>';\n  if (U.run) h += runHTML();\n  if (r.state === 'available' && r.entry && !U.run) {\n    h += '<h4 class=\"up-h\">WHAT HAS BEEN IMPROVED IN ' + esc(r.entry.version) + (r.entry.title ? ' — ' + esc(r.entry.title) : '') + '</h4>' + notesHTML(r.entry.notes);\n    var skipped = (U.manifest && U.manifest.history || []).filter(function (x) { return U.cmp(x.version, CD.VERSION) > 0 && x.version !== r.entry.version && (x.channel || 'stable') === (r.entry.channel || 'stable'); });\n    if (skipped.length) h += '<h4 class=\"up-h\">ALSO INCLUDED FROM EARLIER RELEASES</h4>' + skipped.map(function (x) { return '<div class=\"up-sub\">' + esc(x.version) + ' <small>' + esc(x.date || '') + '</small></div>' + notesHTML(x.notes); }).join('');\n  } else if (!U.run) {\n    var cur = (CD.RELEASES || [])[0];\n    if (cur) h += '<h4 class=\"up-h\">INSTALLED: ' + esc(cur.v) + ' — ' + esc(cur.title) + '</h4>' + notesHTML(cur.items);\n  }\n  h += '<div class=\"up-foot\"><button class=\"up-l\" data-u=\"pkg\">Install from an update package (.cdupdate)…</button><input type=\"file\" id=\"upPkg\" accept=\".cdupdate,.json\" class=\"hide\"></div>';\n  return h;\n}\nfunction runHTML() {\n  var R = U.run, names = ['Download', 'Verify', 'Install'];\n  var h = '<div class=\"up-run\"><div class=\"up-steps\">' + names.map(function (n, i) {\n    var s = R.steps[i]; return '<div class=\"st ' + s + '\"><i>' + ({ok: '✓', run: '', wait: i + 1, err: '✕'}[s]) + '</i><span>' + n + '</span></div>';\n  }).join('<hr>') + '</div><div class=\"up-bar\"><i id=\"upBar\" style=\"width:' + (R.pct || 0) + '%\"></i></div><div class=\"up-msg ' + (R.error ? 'bad' : '') + '\">' + esc(R.msg) + '</div>';\n  if (R.done && !R.desktop) h += '<div class=\"up-act\"><button class=\"up-b pri\" data-u=\"relaunch\">↻ Open the new version now</button><button class=\"up-b\" data-u=\"resave\">Save the file again</button></div><div class=\"up-hint\">The file ColumnDetailerPro.html was saved to your Downloads folder. Replace your installed copy with it (or run it instead) so the new version opens next time. Projects saved as .cdp.json open in the new version unchanged.</div>';\n  if (R.done && R.desktop) h += '<div class=\"up-act\"><button class=\"up-b pri\" data-u=\"relaunch\">↻ Restart now</button></div>';\n  if (R.error) h += '<div class=\"up-act\"><button class=\"up-b\" data-u=\"dismiss\">Close</button><button class=\"up-b pri\" data-u=\"install\">Try again</button></div>';\n  return h + '</div>';\n}\nfunction renderProgress() { var b = $('#upBar'); if (b && U.run) b.style.width = (U.run.pct || 0) + '%'; }\nfunction viewRel() {\n  var rel = (U.manifest && U.manifest.history && U.manifest.history.length) ? U.manifest.history.map(function (x) { return {v: x.version, date: x.date, title: x.title, items: x.notes, ch: x.channel}; }) : [];\n  var local = (CD.RELEASES || []).filter(function (r) { return !rel.some(function (x) { return x.v === r.v; }); });\n  var all = rel.concat(local).sort(function (a, b) { return U.cmp(b.v, a.v); });\n  return '<h4 class=\"up-h\">RELEASE HISTORY</h4>' + all.map(function (r) {\n    return '<div class=\"up-rel\"><div class=\"up-sub\"><b>' + esc(r.v) + '</b>' + (r.v === CD.VERSION ? ' <span class=\"chip\">installed</span>' : '') + (r.ch && r.ch !== 'stable' ? ' <span class=\"chip b\">' + esc(r.ch) + '</span>' : '') + ' <small>' + esc(r.date || '') + '</small> ' + esc(r.title || '') + '</div>' + notesHTML(r.items) + '</div>';\n  }).join('');\n}\nfunction viewSet() {\n  var c = U.cfg();\n  return '<h4 class=\"up-h\">UPDATE SERVER</h4><div class=\"up-form\">' +\n    '<label>Update server address<input type=\"text\" id=\"upUrl\" value=\"' + esc(c.url) + '\" placeholder=\"https://updates.example.com/cdp/\"></label>' +\n    '<div class=\"up-hint\">The address of the folder that holds <code>update.json</code>. Your software developer gives you this address.</div>' +\n    '<label class=\"chk\"><input type=\"checkbox\" id=\"upAuto\"' + (c.auto ? ' checked' : '') + '> Check for updates automatically</label>' +\n    '<label>How often<select id=\"upEvery\"><option value=\"startup\"' + (c.every === 'startup' ? ' selected' : '') + '>Every time the program starts</option><option value=\"daily\"' + (c.every === 'daily' ? ' selected' : '') + '>Once a day</option><option value=\"weekly\"' + (c.every === 'weekly' ? ' selected' : '') + '>Once a week</option></select></label>' +\n    '<label>Update channel<select id=\"upCh\"><option value=\"stable\"' + (c.channel === 'stable' ? ' selected' : '') + '>Stable — tested releases</option><option value=\"beta\"' + (c.channel === 'beta' ? ' selected' : '') + '>Beta — early access</option></select></label>' +\n    '<div class=\"up-act\"><button class=\"up-b pri\" data-u=\"saveset\">Save &amp; test connection</button>' + (c.skip ? '<button class=\"up-b\" data-u=\"unskip\">Stop skipping ' + esc(c.skip) + '</button>' : '') + '</div>' +\n    '<div class=\"up-hint\">Installed: ' + CD.VERSION + ' (' + CD.BUILD + ') · last checked: ' + fmtDate(c.last) + '</div></div>';\n}\nfunction viewDev() {\n  var c = U.cfg(), d = U.dev;\n  if (!U.devOK) {\n    var first = !c.devHash;\n    return '<h4 class=\"up-h\">DEVELOPER CONSOLE</h4><div class=\"up-lock\"><div class=\"up-key\">🔒</div><b>' + (first ? 'Create a developer passcode' : 'Developer passcode') + '</b><span>' + (first ? 'This keeps users from opening the publishing tools by accident. Real protection is the publish token held by your update server.' : 'Enter the passcode to publish releases.') + '</span>' +\n      '<input type=\"password\" id=\"upPass\" placeholder=\"passcode\"' + '><div class=\"up-act\"><button class=\"up-b pri\" data-u=\"devunlock\">' + (first ? 'Set passcode' : 'Unlock') + '</button></div><div class=\"up-msg bad\">' + esc(d.lockErr || '') + '</div></div>';\n  }\n  var f = d.file, notes = d.notes || [], h = '<h4 class=\"up-h\">1 · SELECT THE NEW BUILD</h4><div class=\"up-form\">' +\n    '<div class=\"up-hint\">After editing the source run <code>node build.js</code>, then choose <code>dist/ColumnDetailerPro.html</code>. Bump <code>CD.VERSION</code> in <code>00-data.js</code> and add the release to <code>05-release.js</code> first.</div>' +\n    '<div class=\"up-act\"><button class=\"up-b\" data-u=\"devfile\">Choose build file…</button><input type=\"file\" id=\"upBuild\" accept=\".html\" class=\"hide\">' + (f ? '<span class=\"up-file\"><b>' + esc(f.name) + '</b> · v' + esc(f.ver) + ' · ' + fmtSize(f.size) + ' · SHA-256 ' + f.sha.slice(0, 12) + '…</span>' : '') + '</div>' + (d.err ? '<div class=\"up-msg bad\">' + esc(d.err) + '</div>' : '') + '</div>';\n  h += '<h4 class=\"up-h\">2 · DESCRIBE THE RELEASE</h4><div class=\"up-form\"><div class=\"up-two\">' +\n    '<label>Version<input type=\"text\" id=\"dVer\" value=\"' + esc(d.version || '') + '\" placeholder=\"1.2.0\"></label>' +\n    '<label>Channel<select id=\"dCh\"><option value=\"stable\"' + (d.channel !== 'beta' ? ' selected' : '') + '>Stable</option><option value=\"beta\"' + (d.channel === 'beta' ? ' selected' : '') + '>Beta</option></select></label></div>' +\n    '<label>Release title<input type=\"text\" id=\"dTitle\" value=\"' + esc(d.title || '') + '\" placeholder=\"Short headline\"></label>' +\n    '<div class=\"up-notes-ed\">' + notes.map(function (n, i) {\n      return '<div class=\"nr\"><select data-n=\"' + i + '\" data-k=\"t\"><option value=\"new\"' + (n.t === 'new' ? ' selected' : '') + '>NEW</option><option value=\"imp\"' + (n.t === 'imp' ? ' selected' : '') + '>IMPROVED</option><option value=\"fix\"' + (n.t === 'fix' ? ' selected' : '') + '>FIXED</option></select><input type=\"text\" data-n=\"' + i + '\" data-k=\"x\" value=\"' + esc(n.x) + '\" placeholder=\"What changed, in plain words\"><button class=\"up-b sm\" data-u=\"delnote\" data-i=\"' + i + '\">✕</button></div>';\n    }).join('') + '<button class=\"up-b sm\" data-u=\"addnote\">+ Add line</button></div>' +\n    '<label class=\"chk\"><input type=\"checkbox\" id=\"dMand\"' + (d.mandatory ? ' checked' : '') + '> Required update (users are prompted immediately and cannot skip)</label></div>';\n  var pb = d.pubUrl != null ? d.pubUrl : c.pubUrl, tk = d.token != null ? d.token : c.token;\n  var G = Object.assign(U.ghDefaults(), d.gh || {});\n  h += '<h4 class=\"up-h\">3 · PUBLISH TO GITHUB</h4><div class=\"up-form\">' +\n    '<div class=\"up-two\"><label>GitHub username<input type=\"text\" id=\"gO\" value=\"' + esc(G.owner) + '\"></label><label>Repository<input type=\"text\" id=\"gR\" value=\"' + esc(G.repo) + '\"></label></div>' +\n    '<div class=\"up-two\"><label>Branch<input type=\"text\" id=\"gB\" value=\"' + esc(G.branch) + '\"></label><label>Access token<input type=\"password\" id=\"gT\" value=\"' + esc(G.token) + '\" placeholder=\"github_pat_…\"></label></div>' +\n    '<div class=\"up-act\"><button class=\"up-b pri\" data-u=\"devgh\"' + (d.busy ? ' disabled' : '') + '>⭱ Publish to GitHub</button><button class=\"up-b\" data-u=\"devexp\">Export files instead</button></div>' +\n    '<div class=\"up-hint\">One-time token: github.com → profile picture → Settings → Developer settings → Personal access tokens → <b>Fine-grained tokens</b> → Generate new token. Repository access: <b>Only select repositories → cdp-updates</b>. Permissions → Repository permissions → <b>Contents: Read and write</b>. Paste it above. It is stored only in this browser; anyone who has it can change that repository, so never share it. Revoke it on GitHub if lost.</div>' +\n    (d.msg && d.msg.t.indexOf('your own') < 0 ? '<div class=\"up-msg ' + (d.msg.bad ? 'bad' : (d.msg.ok ? 'good' : '')) + '\">' + esc(d.msg.t) + '</div>' : '') + '</div>';\n  h += '<h4 class=\"up-h\">ADVANCED · OWN UPDATE SERVER (optional)</h4><div class=\"up-form\">' +\n    '<div class=\"up-hint\">Only if you run <code>tools/update-server.js</code>. Not used with GitHub - leave empty.</div>' +\n    '<label>Publish server address<input type=\"text\" id=\"dPub\" value=\"' + esc(pb) + '\" placeholder=\"https://updates.example.com/cdp/\"></label>' +\n    '<label>Publish token<input type=\"password\" id=\"dTok\" value=\"' + esc(tk) + '\" placeholder=\"token from tools/update-server.js\"></label>' +\n    '<div class=\"up-act\"><button class=\"up-b\" data-u=\"devpub\"' + (d.busy ? ' disabled' : '') + '>⭱ Publish to my server</button></div>' +\n    '' + '</div>';\n  return h;\n}\nfunction render() {\n  var host = $('#upHost'); if (!host) return;\n  var tabs = [['upd', 'Updates', '⟳'], ['rel', 'Release notes', '☰'], ['set', 'Settings', '⚙'], ['dev', 'Developer', '⌘']];\n  var body = {upd: viewUpd, rel: viewRel, set: viewSet, dev: viewDev}[U.tab]();\n  var av = U.res.state === 'available';\n  host.innerHTML = '<div class=\"dlg up\"><header><div class=\"up-brand\"><svg><use href=\"#logo\"/></svg><div><b>SOFTWARE UPDATE</b><small>Column Detailer Pro · v' + CD.VERSION + ' · build ' + CD.BUILD + '</small></div></div><button class=\"btn sm\" data-u=\"close\">✕</button></header>' +\n    '<div class=\"up-main\"><nav>' + tabs.map(function (t) { return '<button data-u=\"tab\" data-t=\"' + t[0] + '\" class=\"' + (U.tab === t[0] ? 'on' : '') + '\"><i>' + t[2] + '</i>' + t[1] + (t[0] === 'upd' && av ? '<em></em>' : '') + '</button>'; }).join('') + '</nav><div class=\"up-body\">' + body + '</div></div></div>';\n}\nU.show = function (tab) {\n  var mh = $('#modalHost'); if (!mh) return;\n  U.open = true; if (tab) U.tab = tab;\n  mh.innerHTML = '<div class=\"modal\" id=\"upHost\"></div>'; render();\n  if (U.res.state === 'idle' && base(U.cfg().url)) U.check(false);\n};\nU.close = function () { U.open = false; var mh = $('#modalHost'); if (mh) mh.innerHTML = ''; };\n\nfunction onClick(e) {\n  var t = e.target.closest('[data-u]'); if (!t || !$('#upHost') || !$('#upHost').contains(t)) return;\n  var a = t.dataset.u, d = U.dev, c;\n  if (a === 'close') U.close();\n  else if (a === 'tab') { U.tab = t.dataset.t; render(); }\n  else if (a === 'check') U.check(false);\n  else if (a === 'install') U.install();\n  else if (a === 'skip') { c = U.cfg(); c.skip = U.res.entry.version; U.save(c); U.res = {state: 'uptodate', ts: c.last}; U.afterCheck(); render(); }\n  else if (a === 'unskip') { c = U.cfg(); c.skip = ''; U.save(c); U.check(false); }\n  else if (a === 'later') U.close();\n  else if (a === 'dismiss') { U.run = null; render(); }\n  else if (a === 'relaunch') U.relaunch();\n  else if (a === 'resave' && U.run && U.run.html) dl('ColumnDetailerPro.html', U.run.html, 'text/html');\n  else if (a === 'pkg') { $('#upPkg').click(); }\n  else if (a === 'saveset') {\n    c = U.cfg(); c.url = $('#upUrl').value.trim(); c.auto = $('#upAuto').checked; c.every = $('#upEvery').value; c.channel = $('#upCh').value; U.save(c);\n    U.announced = false; U.tab = 'upd'; U.check(false);\n  }\n  else if (a === 'devunlock') {\n    c = U.cfg(); var pw = $('#upPass').value; if (!pw) return;\n    U.sha256(new TextEncoder().encode('cdp-dev:' + pw)).then(function (h) {\n      if (!c.devHash) { c.devHash = h; U.save(c); U.devOK = true; d.notes = d.notes || []; }\n      else if (c.devHash === h) { U.devOK = true; d.notes = d.notes || []; } else d.lockErr = 'Wrong passcode.';\n      render();\n    });\n  }\n  else if (a === 'devfile') { $('#upBuild').click(); }\n  else if (a === 'addnote') { d.notes = (d.notes || []).concat([{t: 'imp', x: ''}]); render(); }\n  else if (a === 'delnote') { d.notes.splice(+t.dataset.i, 1); render(); }\n  else if (a === 'devpub') U.devPublish();\n  else if (a === 'devexp') U.devExport();\n  else if (a === 'devgh') U.devGitHub();\n}\nfunction onInput(e) {\n  var t = e.target; if (!$('#upHost') || !$('#upHost').contains(t)) return; var d = U.dev;\n  if (e.type === 'change' && t.files && t.files[0]) { if (t.id === 'upBuild') U.devLoad(t.files[0]); else if (t.id === 'upPkg') U.installPackage(t.files[0]); return; }\n  if (t.dataset.n != null) d.notes[+t.dataset.n][t.dataset.k] = t.value;\n  else if (t.id === 'dVer') d.version = t.value.trim();\n  else if (t.id === 'dCh') d.channel = t.value;\n  else if (t.id === 'dTitle') d.title = t.value;\n  else if (t.id === 'dMand') d.mandatory = t.checked;\n  else if (/^g[ORBT]$/.test(t.id)) { d.gh = d.gh || {}; d.gh[{gO: 'owner', gR: 'repo', gB: 'branch', gT: 'token'}[t.id]] = t.value.trim(); }\n  else if (t.id === 'dPub') d.pubUrl = t.value;\n  else if (t.id === 'dTok') d.token = t.value;\n}\ndocument.addEventListener('click', onClick);\ndocument.addEventListener('input', onInput);\ndocument.addEventListener('change', onInput);\ndocument.addEventListener('keydown', function (e) { if (e.key === 'Escape' && U.open) U.close(); if (e.key === 'Enter' && e.target && e.target.id === 'upPass') { var b = document.querySelector('[data-u=devunlock]'); if (b) b.click(); } });\n\nU.boot = function () {\n  document.querySelectorAll('.updBtn').forEach(function (b) { b.addEventListener('click', function () { U.show('upd'); }); });\n  var s = $('#stUpdSub'); if (s) s.textContent = 'v' + CD.VERSION;\n  setTimeout(U.autoCheck, 1800);\n};\nwindow.addEventListener('DOMContentLoaded', function () { U.boot(); });\n})();\n\n</script>\n</body>\n</html>\n"}