 'offset ' + Jt.faceOffset + ' mm >= ' + P.opt.offsetLimit + ' mm: lower bars cut off within 75 mm of floor top; dowels extend development length below and lap above.', 'ACI 315 2.6.3 / 3.7.7.2');\n    if (!ist && Jt.mode === 'bendDown' && !Jt.sameSize) add('info', nm + 'offset-bent bars: 3 closely spaced ties within 150 mm of the bend.', 'ACI 315 2.6.2');\n    if (ist && Jt.mode === 'splice') add('info', nm + 'section change - splice bars fixed at compression lap + 75 above floor, anchored into slab.', 'IST MC3');\n    if (seis === 'high' && Jt.seisShift != null) add('info', nm + 'High seismic: lap splice relocated to mid-height (centre half of clear column height).', 'ACI 315 2.10.6');\n    if (!ist && Jt.upS.bar.no >= 43) add('warn', nm + 'No.' + Jt.upS.bar.no + ' bars cannot be lap spliced.', 'ACI 315 2.7.3');\n    // area through the joint\n    if (Jt.lowS.As < Jt.upS.As * 0.999 && Jt.mode !== 'dowel' && Jt.mode !== 'splice' && Jt.lowS.N >= Jt.upS.N) add('warn', nm + 'bar area below (' + Math.round(Jt.lowS.As) + ' mm²) < above (' + Math.round(Jt.upS.As) + ' mm²): extra dowels needed.', 'ACI 315 2.6.3');\n  });\n  // top anchorage\n  var tl = M.topLap;\n  if (ist) {\n    add(tl.bend ? 'info' : 'ok', 'Top of column: slab depth ' + tl.avail + ' mm effective vs anchorage ' + tl.anch + ' mm' + (tl.factor > 1 ? ' (x1.4 edge/corner, Ø≥25)' : '') + (tl.bend ? ' - bars turned (bob ' + tl.B + ' mm).' : ' - bars straight.'), 'IST MC4/MC5');\n  } else {\n    add(tl.bend ? 'info' : 'ok', 'Top of column: ldh = ' + tl.ldh + ' mm, slab effective depth ' + tl.avail + ' mm' + (tl.bend ? ' - standard 90° hooks provided.' : ' - bars straight.'), 'ACI 318M 12.5');\n  }\n  // spiral checks (ACI)\n  if (aci && circ) {\n    secs.forEach(function (S, i) {\n      var pitch = lifts[Math.min(i + (M.hasFoundLift ? 1 : 0), lifts.length - 1)].pitch;\n      var cl = pitch - S.dl;\n      if (cl > 80) add('err', 'Spiral clear spacing ' + Math.round(cl) + ' mm > 80 mm.', 'ACI 315 2.6.4');\n      if (cl < 25) add('err', 'Spiral clear spacing ' + Math.round(cl) + ' mm < 25 mm.', 'ACI 315 2.6.4');\n    });\n  }\n  // beam/column concrete strength (IST)\n  if (ist && fck > 1.4 * mat.slabFck) add('warn', 'Column concrete fck ' + fck + ' > 1.4 x slab fck ' + mat.slabFck + ' - special measures for bursting.', 'IST 6.4.2');\n  // footing size\n  var s0 = secs[0];\n  if (M.ftg.B < (circ ? s0.D : s0.b) + 300) add('warn', 'Footing width small relative to column.', '');\n  if (col.base.depth < 0) add('err', 'Negative column depth.', '');\n  if (!lifts.length) add('err', 'No lifts defined.', '');\n  if (col.qty < 1) add('warn', 'Quantity < 1.', '');\n  // sort: errors first\n  var ord = {err: 0, warn: 1, info: 2, ok: 3};\n  C.sort(function (a, b) { return ord[a.level] - ord[b.level]; });\n  M.nErr = C.filter(function (c) { return c.level === 'err'; }).length;\n  M.nWarn = C.filter(function (c) { return c.level === 'warn'; }).length;\n}\n\n/* ------------------------------------------------- auto-propose bars ----- */\nCD.proposeBars = function (P, shape, s) {\n  var code = P.code, aci = code === ACI, mat = P.mat;\n  var Ac = shape === 'circ' ? Math.PI * s.D * s.D / 4 : s.b * s.h;\n  var target = aci ? 0.015 : 0.012;\n  var list = CD.barList(code).filter(function (d) { return aci ? (d >= 16 && d <= 32) : (d >= 16 && d <= 32); });\n  var best = null;\n  var cc = aci ? 40 : (mat.exposure === 'external' ? 35 : 30) + mat.dcdev;\n  var dl = aci ? 10 : 10;\n  for (var li = 0; li < list.length; li++) {\n    var des = list[li], bar = CD.bar(code, des);\n    if (shape === 'circ') {\n      for (var n = 6; n <= 24; n += 2) {\n        var As = n * bar.area;\n        if (As / Ac >= target) {\n          var R = s.D / 2 - cc - 10 - bar.d / 2, chord = 2 * R * Math.sin(Math.PI / n);\n          if (chord - bar.d >= (aci ? Math.max(1.5 * bar.d, 40) : Math.max(75, bar.d))) { return {des: des, n: n}; }\n          break;\n        }\n      }\n    } else {\n      for (var nb = 2; nb <= 9; nb++) {\n        for (var nh = 2; nh <= 9; nh++) {\n          var N = 2 * (nb + nh) - 4;\n          var As2 = N * bar.area;\n          if (As2 / Ac < target) continue;\n          var e = cc + dl + bar.d / 2, sb = (s.b - 2 * e) / (nb - 1), sh = (s.h - 2 * e) / (nh - 1);\n          var minClr = aci ? Math.max(1.5 * bar.d, 40) : Math.max(75, bar.d);\n          if (sb - bar.d < minClr || sh - bar.d < minClr) continue;\n          if (Math.max(sb, sh) > 300) continue;\n          var score = N * 1000 + Math.abs(nb - nh * (s.b / s.h));\n          if (!best || As2 < best.As || (As2 === best.As && score < best.score)) {\n            if (!best || As2 < best.As) best = {des: des, nb: nb, nh: nh, As: As2, score: score};\n          }\n        }\n      }\n      if (best) return {des: best.des, nb: best.nb, nh: best.nh};\n    }\n  }\n  return shape === 'circ' ? {des: list[0], n: 8} : {des: list[0], nb: 3, nh: 3};\n};\n\n})();\n\n/* ==== 20-draw.js ==== */\n/* ==========================================================================\n   DRAWING BUILDER : column detail sheet (entities in paper mm)\n   Entity types: line, pl (polyline), ci (circle, optional fill), tx (text)\n   ========================================================================== */\n(function () {\n'use strict';\n\nCD.entBounds = function (ents) {\n  var x1 = 1e18, y1 = 1e18, x2 = -1e18, y2 = -1e18;\n  function pt(x, y) { if (x < x1) x1 = x; if (x > x2) x2 = x; if (y < y1) y1 = y; if (y > y2) y2 = y; }\n  ents.forEach(function (e) {\n    if (e.t === 'line') { pt(e.x1, e.y1); pt(e.x2, e.y2); }\n    else if (e.t === 'pl' || e.t === 'so') e.pts.forEach(function (p) { pt(p[0], p[1]); });\n    else if (e.t === 'ci') { pt(e.cx - e.r, e.cy - e.r); pt(e.cx + e.r, e.cy + e.r); }\n    else if (e.t === 'tx') { var w = e.str.length * e.h * 0.62; pt(e.x, e.y); pt(e.x + w, e.y + e.h); }\n  });\n  return {x1: x1, y1: y1, x2: x2, y2: y2};\n};\n\nCD.scaleEnts = function (ents, s) {\n  return ents.map(function (e) {\n    var o = Object.assign({}, e);\n    if (e.t === 'line') { o.x1 *= s; o.y1 *= s; o.x2 *= s; o.y2 *= s; }\n    else if (e.t === 'pl' || e.t === 'so') o.pts = e.pts.map(function (p) { return [p[0] * s, p[1] * s]; });\n    else if (e.t === 'ci') { o.cx *= s; o.cy *= s; o.r *= s; }\n    else if (e.t === 'tx') { o.x *= s; o.y *= s; o.h *= s; }\n    return o;\n  });\n};\n\nCD.buildSheet = function (P, col, M, opt) {\n  opt = opt || {};\n  if (P.style && P.style.mode === 'pro' && !opt.std && CD.buildSheetPro) return CD.buildSheetPro(P, col, M, opt);\n  var code = P.code, aci = M.aci, circ = col.shape === 'circ', letter = M.letter;\n  var view = P.sheet.elevView || 'b';\n  var ents = [];\n  function ln(x1, y1, x2, y2, layer, lt) { ents.push({t: 'line', x1: x1, y1: y1, x2: x2, y2: y2, layer: layer, lt: lt || ''}); }\n  function pl(pts, closed, layer, lt, extra) { ents.push(Object.assign({t: 'pl', pts: pts, closed: !!closed, layer: layer, lt: lt || ''}, extra || {})); }\n  function ci(cx, cy, r, layer, fill) { ents.push({t: 'ci', cx: cx, cy: cy, r: r, layer: layer, fill: !!fill}); }\n  function tx(x, y, str, h, layer, o) { o = o || {}; ents.push({t: 'tx', x: x, y: y, str: String(str), h: h, layer: layer || 'TEXT', ha: o.ha || 'l', va: o.va || 'b', rot: o.rot || 0, bold: !!o.bold}); }\n  function rect(x1, y1, x2, y2, layer, lt) { pl([[x1, y1], [x2, y1], [x2, y2], [x1, y2]], true, layer, lt); }\n  function hatch(x1, y1, x2, y2, sp, layer) {\n    for (var c = x1 - y2; c < x2 - y1; c += sp) {\n      var xa = Math.max(x1, c + y1), xb = Math.min(x2, c + y2);\n      if (xb - xa > 0.2) ln(xa, xa - c, xb, xb - c, layer || 'HATCH');\n    }\n  }\n  function tick(x, y, s) { ln(x - s, y - s, x + s, y + s, 'DIMS'); }\n\n  var F = M.F, n = F.length - 1, Ft = M.levels.Ft, Fb = M.levels.Fb, Fl = M.levels.Fl;\n  var secs = M.secs, S0 = secs[0], cc = M.cc;\n  var ftg = M.ftg;\n  var Kup = M.kicker.up, Kf = M.kicker.found;\n\n  /* ------------ geometry helpers per section ------------ */\n  function wOf(S) { return circ ? S.D : (view === 'b' ? S.b : S.h); }\n  function xoOf(S) { return circ ? S.lay.R : (view === 'b' ? S.lay.xw : S.lay.yh); }\n  var wMax = Math.max.apply(null, secs.map(wOf));\n  var Lh = view === 'b' ? ftg.B : ftg.L;          // footing length along horizontal axis in the elevation\n  var xcOff = view === 'b' ? (ftg.ex || 0) : 0;   // column centre offset from footing centre\n  Lh = Math.max(Lh, wMax + 200);\n\n  /* ------------ scale / sheet selection ------------ */\n  var zBot = Fl, zTop = F[n] + 450;\n  var HreEl = zTop - zBot;\n  var maxSec = Math.max.apply(null, secs.map(function (S) { return circ ? S.D : Math.max(S.b, S.h); }));\n  var ss = P.sheet.secScale > 0 ? P.sheet.secScale : (maxSec <= 500 ? 10 : (maxSec <= 1000 ? 20 : 25));\n  var groups = M.sections;\n  var secBandH = (Math.ceil(maxSec / ss)) + 78;\n  var sheetName = P.sheet.size === 'auto' ? 'A1' : P.sheet.size;\n  var dim = CD.SHEETS[sheetName] || CD.SHEETS.A1;\n  var W = dim[0], H = dim[1];\n  var mg = 10;\n  var sc, fit = true;\n  function elevAvail(Hh) { return Hh - 2 * mg - secBandH - 8 - 32; }\n  function pickScale(Hh) {\n    for (var i = 0; i < CD.SCALES.length; i++) { if (HreEl / CD.SCALES[i] <= elevAvail(Hh)) return CD.SCALES[i]; }\n    return CD.SCALES[CD.SCALES.length - 1];\n  }\n  if (P.sheet.size === 'auto') {\n    var order = ['A2', 'A1', 'A0'];\n    for (var oi = 0; oi < order.length; oi++) {\n      var dd = CD.SHEETS[order[oi]];\n      if (HreEl / 50 <= elevAvail(dd[1]) || oi === order.length - 1) { sheetName = order[oi]; break; }\n    }\n    dim = CD.SHEETS[sheetName]; W = dim[0]; H = dim[1];\n  }\n  if (P.sheet.scale > 0) { sc = P.sheet.scale; if (HreEl / sc > elevAvail(H)) fit = false; }\n  else sc = pickScale(H);\n\n  /* ------------ layout (paper mm) ------------ */\n  var elevW = (Lh / sc) + 150;                // left tags 45 + right 105\n  var xL = mg + 6;                            // left of elevation zone\n  var yBottomEl = mg + 32;                    // bottom of elevation (below: title)\n  var cx = xL + 52 + (Lh / 2 - xcOff) / sc;   // column centre x\n  function X(x) { return cx + x / sc; }\n  function Y(z) { return yBottomEl + (z - zBot) / sc; }\n  var rightZoneX = Math.max(xL + elevW + 10, mg + 200);\n  var topBandY1 = H - mg - secBandH;          // bottom of sections band\n\n  /* ------------ border + title block ------------ */\n  rect(5, 5, W - 5, H - 5, 'BORDER');\n  rect(mg, mg, W - mg, H - mg, 'BORDER');\n  var tbW = 200, tbH = 46, tbX = W - mg - tbW, tbY = mg;\n  rect(tbX, tbY, tbX + tbW, tbY + tbH, 'BORDER');\n  ln(tbX, tbY + 30, tbX + tbW, tbY + 30, 'BORDER');\n  ln(tbX, tbY + 15, tbX + tbW, tbY + 15, 'BORDER');\n  ln(tbX + 120, tbY, tbX + 120, tbY + 30, 'BORDER');\n  ln(tbX + 160, tbY, tbX + 160, tbY + 30, 'BORDER');\n  var m0 = P.meta;\n  var title = 'COLUMN ' + col.mark + ' (' + sizeText(S0) + 'mm), ' + col.qty + ' Nos';\n  function sizeText(S) { return circ ? 'Ø' + S.D : S.b + 'x' + S.h; }\n  var sizes = [];\n  secs.forEach(function (S) { var t = sizeText(S); if (sizes.indexOf(t) < 0) sizes.push(t); });\n  var titleSizes = sizes.length > 1 ? sizes[0] + ' - ' + sizes[sizes.length - 1] : sizes[0];\n  title = 'COLUMN ' + col.mark + ' (' + titleSizes + 'mm), ' + col.qty + ' Nos';\n  tx(tbX + 3, tbY + tbH - 6, m0.job || 'PROJECT', 4, 'BORDER', {bold: true});\n  tx(tbX + 3, tbY + tbH - 11.5, (m0.client || '') + (m0.location ? '  |  ' + m0.location : ''), 2.4, 'BORDER');\n  tx(tbX + 3, tbY + 32, 'DRAWING TITLE', 1.6, 'BORDER');\n  tx(tbX + 3, tbY + 21, title, 3.4, 'BORDER', {bold: true});\n  tx(tbX + 3, tbY + 17, 'COLUMN REINFORCEMENT DETAILS  -  ' + (aci ? 'ACI 315-99' : 'IStructE / Concrete Society SMDSC'), 2, 'BORDER');\n  tx(tbX + 122, tbY + 25, 'DRG No.', 1.6, 'BORDER'); tx(tbX + 122, tbY + 19.5, m0.drawingNo || '', 3, 'BORDER', {bold: true});\n  tx(tbX + 162, tbY + 25, 'REV', 1.6, 'BORDER'); tx(tbX + 162, tbY + 19.5, m0.rev || '', 3, 'BORDER', {bold: true});\n  tx(tbX + 3, tbY + 11, 'SCALES  ELEV 1:' + sc + '  SECT 1:' + ss, 2.4, 'BORDER');\n  tx(tbX + 3, tbY + 4.5, 'SHEET ' + sheetName + '   DATE ' + (m0.date || ''), 2.2, 'BORDER');\n  tx(tbX + 103, tbY + 11, 'DRAWN  ' + (m0.drawnBy || ''), 2.2, 'BORDER');\n  tx(tbX + 103, tbY + 4.5, 'CHECKED  ' + (m0.checkedBy || ''), 2.2, 'BORDER');\n  tx(tbX + 3, tbY + 24.2, '', 1, 'BORDER');\n\n  /* ======================= ELEVATION ======================= */\n  var yTagX = X(-Lh / 2 - xcOff) - 6;   // level tag start (left of footing)\n  var leftFace = X(-Lh / 2 - xcOff);\n  var rightFace = X(Lh / 2 - xcOff);\n  // lean concrete\n  var lp = ftg.leanProj || 75;\n  rect(X(-Lh / 2 - xcOff - lp), Y(Fl), X(Lh / 2 - xcOff + lp), Y(Fb), 'FOOTING', 'dash');\n  hatch(X(-Lh / 2 - xcOff - lp), Y(Fl), X(Lh / 2 - xcOff + lp), Y(Fb), 2.2, 'HATCH');\n  // footing\n  rect(leftFace, Y(Fb), rightFace, Y(Ft), 'FOOTING');\n  // footing bars\n  var cf = M.coverFtg;\n  ['B1', 'B2', 'T1', 'T2'].forEach(function (k) {\n    var fb = M.ftgBars[k]; if (!fb) return;\n    var b = CD.bar(code, fb.des);\n    var isTop = k[0] === 'T';\n    var lyr = k[1] === '1' ? 1 : 2;\n    var d1 = CD.bar(code, col.base.lay[isTop ? 'T1' : 'B1'].des).d, d2 = CD.bar(code, col.base.lay[isTop ? 'T2' : 'B2'].des).d;\n    var z;\n    if (!isTop) z = lyr === 1 ? Fb + cf + b.d / 2 : Fb + cf + d1 + b.d / 2;\n    else z = lyr === 1 ? Ft - cf - b.d / 2 : Ft - cf - d1 - b.d / 2;\n    var asLine = (fb.dir === 'x') === (view === 'b');\n    var xa = -Lh / 2 - xcOff + cf, xb = Lh / 2 - xcOff - cf;\n    if (asLine) {\n      if (fb.bobbed) {\n        var leg = Math.min(300, ftg.T - 2 * cf - 2 * b.d);\n        pl([[X(xa), Y(z + (isTop ? -leg : leg))], [X(xa), Y(z)], [X(xb), Y(z)], [X(xb), Y(z + (isTop ? -leg : leg))]], false, 'FTG-BARS');\n      } else ln(X(xa), Y(z), X(xb), Y(z), 'FTG-BARS');\n    } else {\n      var nn = fb.n, i;\n      for (i = 0; i < nn; i++) {\n        var xx = nn > 1 ? xa + b.d / 2 + i * ((xb - xa - b.d) / (nn - 1)) : (xa + xb) / 2;\n        ci(X(xx), Y(z), Math.max(0.5, b.d / 2 / sc), 'FTG-BARS', true);\n      }\n    }\n  });\n  // starters\n  var st = M.starter, stS = st.S, stBar = stS.bar;\n  [-1, 1].forEach(function (sg) {\n    var xo = sg * xoOf(stS);\n    var zb = st.zBot, zt = st.zTop;\n    var inward = (col.starter.foot === 'out') ? sg : -sg;\n    var legL = Math.min(st.leg, Math.max(100, (Lh / 2 - cf - Math.abs(xo)) * 2));\n    pl([[X(xo + inward * legL), Y(zb + stBar.d / 2)], [X(xo), Y(zb + stBar.d / 2)], [X(xo), Y(zt)]], false, 'COL-STARTER');\n  });\n  // locating links in footing\n  if (M.locLinks.n > 0) {\n    M.locLinks.z.forEach(function (z) { ln(X(-(wOf(stS) / 2 - cc)), Y(z), X(wOf(stS) / 2 - cc), Y(z), 'COL-LINKS'); });\n  }\n\n  // column outline per lift\n  var lifts = M.lifts;\n  var prevW = null;\n  lifts.forEach(function (L) {\n    var S = L.S, w = wOf(S);\n    ln(X(-w / 2), Y(L.zLo), X(-w / 2), Y(L.zHi), 'COL-OUTLINE');\n    ln(X(w / 2), Y(L.zLo), X(w / 2), Y(L.zHi), 'COL-OUTLINE');\n    if (prevW != null && prevW.w !== w) {\n      ln(X(-Math.max(w, prevW.w) / 2), Y(L.zLo), X(-Math.min(w, prevW.w) / 2), Y(L.zLo), 'COL-OUTLINE');\n      ln(X(Math.min(w, prevW.w) / 2), Y(L.zLo), X(Math.max(w, prevW.w) / 2), Y(L.zLo), 'COL-OUTLINE');\n    }\n    prevW = {w: w};\n  });\n  // base line of column on footing and top\n  var wTop = wOf(secs[n - 1]);\n  ln(X(-wTop / 2), Y(F[n]), X(wTop / 2), Y(F[n]), 'COL-OUTLINE');\n  // construction joints (kicker) and labels\n  function jointLine(z, label) {\n    var w = wOf(S0);\n    ln(X(-wMax / 2 - 200), Y(z), X(wMax / 2 + 200), Y(z), 'HIDDEN', 'dash');\n  }\n  if (Kf > 0) { jointLine(Ft + Kf); }\n  M.joints.forEach(function (J) { if (J.k >= 0 && !J.skip && Kup > 0) jointLine(F[J.k] + Kup); });\n  if (Kup > 0 && n >= 1) {\n    var xk = X(wOf(secs[0]) / 2 + 220);\n    tx(xk + 1, Y(F[0] + Kup) + 0.6, 'KICKER ' + Kup, 1.8, 'HIDDEN');\n  }\n  if (Kf > 0) tx(X(wOf(S0) / 2 + 220) + 1, Y(Ft + Kf) + 0.6, 'KICKER ' + Kf, 1.8, 'HIDDEN');\n\n  // beams & slabs (reference stubs)\n  var stub = 380;\n  for (var fj = 1; fj <= n; fj++) {\n    var sj = col.st[fj - 1], Sj = secs[fj - 1], w = wOf(Sj);\n    var bd = sj.bd || 0, sl = sj.slab || 0;\n    [-1, 1].forEach(function (sg) {\n      var x0 = sg * w / 2, x1 = sg * (w / 2 + stub);\n      if (sl > 0) {\n        ln(X(x0), Y(F[fj]), X(x1), Y(F[fj]), 'BEAM-SLAB');\n        ln(X(x0), Y(F[fj] - sl), X(x1), Y(F[fj] - sl), 'BEAM-SLAB');\n        var xb = X(x1), yb1 = Y(F[fj]), yb2 = Y(F[fj] - sl);\n        pl([[xb, yb1], [xb + sg * 0.8, (yb1 * 2 + yb2) / 3], [xb - sg * 0.8, (yb1 + yb2 * 2) / 3], [xb, yb2]], false, 'BEAM-SLAB');\n      }\n      if (bd > sl) {\n        ln(X(x0), Y(F[fj] - bd), X(x1), Y(F[fj] - bd), 'BEAM-SLAB', 'dash');\n        ln(X(x1), Y(F[fj] - bd), X(x1), Y(F[fj] - sl), 'BEAM-SLAB', 'dash');\n      }\n    });\n  }\n  // ground beam\n  if (M.gb) {\n    var gb = M.gb, w0 = wOf(S0);\n    [-1, 1].forEach(function (sg) {\n      var x0 = sg * w0 / 2, x1 = sg * (w0 / 2 + stub);\n      ln(X(x0), Y(F[0] - gb.bd), X(x1), Y(F[0] - gb.bd), 'BEAM-SLAB', 'dash');\n      ln(X(x1), Y(F[0] - gb.bd), X(x1), Y(F[0]), 'BEAM-SLAB', 'dash');\n      ln(X(x0), Y(F[0]), X(x1), Y(F[0]), 'BEAM-SLAB', 'dash');\n    });\n  }\n\n  // main bars\n  lifts.forEach(function (L) {\n    var S = L.S, w = wOf(S), xo = xoOf(S), phi = S.phi;\n    var Jb = L.Jb, Ja = L.Ja;\n    [-1, 1].forEach(function (sg) {\n      var pts = [];\n      var xout = sg * xo;\n      var xin = function (off) { return xout - sg * off; };\n      var zb = L.zb, zt = L.zt;\n      // bottom\n      var crankBelow = Jb.mode === 'crankUp' && Jb.k >= 0;\n      if (crankBelow) {\n        pts.push([xin(Jb.off), zb]);\n        pts.push([xin(Jb.off), zb + Jb.lap]);\n        pts.push([xout, zb + Jb.lap + Jb.lc]);\n      } else {\n        pts.push([xout, zb]);\n      }\n      // top\n      if (Ja && Ja.mode === 'bendDown') {\n        // offset inwards at the top of this lift: from F - lc to F\n        var zbend = F[L.j] - Ja.lc;\n        pts.push([xout, zbend]);\n        pts.push([xin(Ja.off), F[L.j]]);\n        pts.push([xin(Ja.off), zt]);\n      } else if (!Ja && M.topLap.bend) {\n        pts.push([xout, zt]);\n        pts.push([xout - sg * Math.min(M.topLap.B, w / 2 - 20), zt - phi / 2]);\n      } else {\n        pts.push([xout, zt]);\n      }\n      pl(pts.map(function (p) { return [X(p[0]), Y(p[1])]; }), false, 'COL-BARS');\n    });\n  });\n  // splice bars / dowels\n  M.joints.forEach(function (J) {\n    if (J.skip || J.k < 0 || !J.item) return;\n    var S = J.upS, xo = xoOf(S);\n    [-1, 1].forEach(function (sg) {\n      var xi = sg * xo;\n      if (J.spl) {\n        var inward = -sg;\n        pl([[X(xi + inward * Math.min(J.spl.B, xo * 2 - 20)), Y(J.spl.zBot + S.phi / 2)], [X(xi), Y(J.spl.zBot + S.phi / 2)], [X(xi), Y(J.spl.zTop)]], false, 'COL-STARTER');\n      } else if (J.dow) {\n        var xd = xi - sg * (S.phi + 10);\n        ln(X(xd), Y(J.dow.zBot), X(xd), Y(J.dow.zTop), 'COL-STARTER');\n      }\n    });\n  });\n\n  // links\n  var r2 = function (S) { return circ ? (S.D / 2 - cc) : (wOf(S) / 2 - cc); };\n  lifts.forEach(function (L) {\n    var S = L.S, r = r2(S);\n    var all = L.pos.concat(L.extra || []);\n    all.forEach(function (z, i) {\n      if (circ && col.link.circ === 'helix' || (circ && aci)) {\n        ln(X(-r), Y(z), X(r), Y(z + Math.min(L.pitch, 200) / 2), 'COL-LINKS');\n      } else {\n        ln(X(-r), Y(z), X(r), Y(z), 'COL-LINKS');\n      }\n    });\n  });\n\n  // section cut markers\n  var secY = [];\n  for (var sj2 = 1; sj2 <= n; sj2++) {\n    var zc = (F[sj2 - 1] + F[sj2]) / 2 + 250;\n    var g = M.secOf[sj2 - 1];\n    var wS = wOf(secs[sj2 - 1]);\n    var xa = X(-wS / 2 - 320), xb = X(wS / 2 + 320), yy = Y(zc);\n    ln(xa, yy, xb, yy, 'CENTRE', 'center');\n    [[xa, 1], [xb, 1]].forEach(function (e) {\n      ln(e[0], yy, e[0], yy + 7, 'CENTRE');\n      pl([[e[0], yy + 8.6], [e[0] - 0.9, yy + 6], [e[0] + 0.9, yy + 6]], true, 'CENTRE');\n    });\n    ci(xb + 5, yy + 8, 2.6, 'CENTRE', false);\n    tx(xb + 5, yy + 8, g.id.split('-')[0], 2.8, 'CENTRE', {ha: 'c', va: 'm'});\n    ci(xa - 5, yy + 8, 2.6, 'CENTRE', false);\n    tx(xa - 5, yy + 8, g.id.split('-')[0], 2.8, 'CENTRE', {ha: 'c', va: 'm'});\n  }\n\n  // level tags (left)\n  var tagQ = [];\n  function levelTag(z, text1, text2, text3) { tagQ.push({y: Y(z), t1: text1, t2: text2, t3: text3}); }\n  function flushTags() {\n    var xe = X(-wMax / 2) - 3, xs = xe - 38;\n    tagQ.sort(function (a, b) { return b.y - a.y; });\n    var last = 1e9;\n    tagQ.forEach(function (g) {\n      var y = g.y, ly = Math.min(y, last - 8.5);\n      ln(xs, y, xe, y, 'LEVELS');\n      if (Math.abs(ly - y) > 0.1) ln(xs + 4.2, y, xs + 4.2, ly, 'LEVELS');\n      pl([[xs + 2, ly], [xs + 4.2, ly + 3], [xs + 6.4, ly]], true, 'LEVELS');\n      tx(xs + 8, ly + 0.8, g.t1, 2.6, 'LEVELS', {bold: true});\n      var used = 0;\n      if (g.t2) { tx(xs + 8, ly - 3.3, g.t2, 2, 'LEVELS'); used = 4.5; }\n      if (g.t3) { tx(xs + 8, ly - 6.1, g.t3, 1.8, 'BEAM-SLAB'); used = 7.3; }\n      last = ly - used + 1;\n    });\n  }\n  function lv(z) { return (z >= 0 ? '+' : '-') + CD.fmt(Math.abs(z) / 1000, 3); }\n  levelTag(Fl, lv(Fl), 'UNDERSIDE OF LEAN CONCRETE');\n  levelTag(Fb, lv(Fb), 'UNDERSIDE OF FOOTING');\n  levelTag(Ft, lv(Ft), 'TOP OF FOOTING');\n  levelTag(F[0], col.base.elevOverride0 || lv(F[0]), col.base.gfName, M.gb ? 'GROUND BEAM ' + M.gb.bw + 'x' + M.gb.bd : '');\n  for (var fk = 1; fk <= n; fk++) {\n    var s = col.st[fk - 1];\n    var t3 = (s.bw && s.bd) ? ('BEAM ' + s.bw + 'x' + s.bd + ' / SLAB ' + (s.slab || 0)) : '';\n    levelTag(F[fk], s.elevOverride || lv(F[fk]), s.name, t3);\n  }\n  flushTags();\n\n  // dimension chains (right)\n  var rx = X(wMax / 2 + stub) + 6;\n  var chain1 = rx + 8, chain2 = rx + 24, chain3 = rx + 40;\n  function dimV(xline, z1, z2, label, th, xext) {\n    var y1 = Y(z1), y2 = Y(z2);\n    ln(xline, y1, xline, y2, 'DIMS');\n    tick(xline, y1, 1.0); tick(xline, y2, 1.0);\n    if (xext != null) { ln(xext, y1, xline + 1.5, y1, 'DIMS'); ln(xext, y2, xline + 1.5, y2, 'DIMS'); }\n    tx(xline - 0.8, (y1 + y2) / 2, label, th || 2.2, 'DIMS', {ha: 'c', va: 'b', rot: 90});\n  }\n  var extX = X(wMax / 2 + stub) + 1.5;\n  // storey chain\n  var zs = [Fl, Fb, Ft, F[0]].concat(F.slice(1));\n  for (var di = 0; di < zs.length - 1; di++) dimV(chain3, zs[di], zs[di + 1], CD.fmt(zs[di + 1] - zs[di]), 2.4, extX);\n  dimV(chain3 + 9, Fb, F[n], 'OVERALL ' + CD.fmt(F[n] - Fb), 2.2, extX);\n  // lap / kicker / crank chain (inner)\n  var inner = X(wMax / 2) + 9;\n  M.joints.forEach(function (J) {\n    if (J.skip) return;\n    if (J.k === -1) {\n      dimV(inner, J.zs, J.zs + J.lap, 'LAP ' + J.lap, 1.9);\n      if (starter0Tol()) dimV(inner + 5, J.zs + J.lap, J.zs + J.lap + st.tol, st.tol + '', 1.8);\n      if (Kf > 0) dimV(inner, Ft, Ft + Kf, Kf + '', 1.8);\n    } else {\n      dimV(inner, J.zs, J.zs + J.lap, 'LAP ' + J.lap, 1.9);\n      if (Kup > 0) dimV(inner, F[J.k], F[J.k] + Kup, Kup + '', 1.8);\n      if (J.lc > 0 && J.mode === 'crankUp') dimV(inner + 5, J.zs + J.lap, J.zs + J.lap + J.lc, 'CRANK ' + J.lc, 1.8);\n      if (J.lc > 0 && J.mode === 'bendDown') dimV(inner + 5, F[J.k] - J.lc, F[J.k], 'OFFSET ' + J.lc, 1.8);\n    }\n  });\n  function starter0Tol() { return st.tol > 0; }\n  // link zone chain\n  lifts.forEach(function (L) {\n    L.zones.forEach(function (zn) {\n      var c = zn.cnt || 1;\n      var z2 = Math.min(zn.b, zn.a + (c) * zn.s);\n      if (zn.b - zn.a < 10) return;\n      var y1 = Y(zn.a), y2 = Y(zn.b);\n      ln(chain1, y1, chain1, y2, 'DIMS'); tick(chain1, y1, 0.8); tick(chain1, y2, 0.8);\n      var label = (c) + '@' + zn.s;\n      tx(chain1 - 0.7, (y1 + y2) / 2, label, 1.7, 'DIMS', {ha: 'c', va: 'b', rot: 90});\n    });\n  });\n\n  // callouts (right)\n  var used = [];\n  function placeY(y) { var tries = 0; while (tries++ < 60) { var clash = used.some(function (u) { return Math.abs(u - y) < 4.6; }); if (!clash) break; y -= 4.6; } used.push(y); return y; }\n  var coX = chain3 + 24;\n  function callout(xFrom, yFrom, text, layer, yText) {\n    var yt = placeY(yText != null ? yText : yFrom);\n    pl([[xFrom, yFrom], [coX - 6, yt], [coX + text.length * 1.55 + 2, yt]], false, 'CALLOUTS');\n    tx(coX - 5, yt + 0.9, text, 2.4, 'CALLOUTS');\n  }\n  // starters\n  (function () {\n    var xo = xoOf(stS), zm = (st.zBot + st.zTop) / 2;\n    var t = CD.callout(code, stS.N, stS.des, st.item.mark, '', letter) + ' STARTERS';\n    callout(X(xo), Y(zm), t, 'CALLOUTS', Y(zm));\n  })();\n  lifts.forEach(function (L) {\n    var S = L.S, xo = xoOf(S), zm = (L.zb + L.zt) / 2;\n    var cnt = L.item ? (L.itemStop ? S.N - L.itemStop.no : S.N) : S.N;\n    var items = [];\n    if (L.item) items.push([L.item, L.item.no && L.itemStop ? S.N - L.itemStop.no : S.N]);\n    var xr = X(xo);\n    var yMid = Y(zm);\n    if (L.item) callout(xr, yMid, CD.callout(code, L.itemStop ? S.N - L.itemStop.no : S.N, S.des, L.item.mark, '', letter), 'CALLOUTS', yMid + 3);\n    if (L.itemStop) callout(xr, Y(zm - 300), CD.callout(code, L.itemStop.no, S.des, L.itemStop.mark, '', letter) + ' CURTAILED', 'CALLOUTS', yMid - 3);\n    // links\n    var big = L.zones.slice().sort(function (a, b) { return (b.b - b.a) - (a.b - a.a); })[0];\n    var zl = big ? (big.a + big.b) / 2 : zm;\n    var rr = r2(S);\n    var txt = CD.callout(code, L.nLinks, S.linkDes, L.item_link ? L.item_link.mark : '--', L.pitch, letter);\n    if (circ && L.helix) txt = (aci ? 'SPIRAL ' : 'HELIX ') + CD.barLabel(code, S.linkDes, letter) + ' @' + L.pitch + ' (' + (L.item_link ? L.item_link.mark : '') + ')';\n    callout(X(rr), Y(zl), txt + (S.xt && !S.xt.none ? '' : ''), 'CALLOUTS', Y(zl) - 2);\n    if (L.xtV) callout(X(rr), Y(zl - 120), CD.callout(code, (S.xt.v.length) * L.nLinks, S.linkDes, L.xtV.mark, L.pitch, letter) + ' CROSS-TIES', 'CALLOUTS', Y(zl) - 8);\n    if (L.xtH) callout(X(rr), Y(zl - 240), CD.callout(code, (S.xt.h.length) * L.nLinks, S.linkDes, L.xtH.mark, L.pitch, letter) + ' CROSS-TIES', 'CALLOUTS', Y(zl) - 13);\n  });\n  // splice bars / dowels callouts\n  M.joints.forEach(function (J) {\n    if (J.skip || J.k < 0 || !J.item) return;\n    var S = J.upS, xo = xoOf(S);\n    var z = J.spl ? (J.spl.zBot + J.spl.zTop) / 2 : (J.dow ? (J.dow.zBot + J.dow.zTop) / 2 : F[J.k]);\n    var t = CD.callout(code, J.item.no, S.des, J.item.mark, '', letter) + (J.spl ? ' SPLICE' : ' DOWELS');\n    callout(X(xo), Y(z), t, 'CALLOUTS', Y(z));\n  });\n  // footing callouts (left under tags are crowded -> right side)\n  ['B1', 'B2', 'T1', 'T2'].forEach(function (k) {\n    var fb = M.ftgBars[k]; if (!fb) return;\n    var isTop = k[0] === 'T';\n    var z = isTop ? Ft - cf - 10 : Fb + cf + 10;\n    var t = k + ': ' + CD.callout(code, fb.n, fb.des, fb.item.mark, Math.round(fb.pitch / 5) * 5, letter);\n    callout(rightFace - 1, Y(z), t, 'CALLOUTS', Y(z) + (k === 'B2' ? -5 : (k === 'T2' ? -5 : 0)));\n  });\n  if (M.locLinks.n > 0 && M.locLinks.item) callout(X(wOf(S0) / 2 - cc), Y(M.locLinks.z[1]), CD.callout(code, M.locLinks.n, upLink(), M.locLinks.item.mark, M.locLinks.s, letter) + ' LOCATING', 'CALLOUTS', Y(M.locLinks.z[1]));\n  function upLink() { return S0.linkDes; }\n\n  // elevation title\n  var tY = mg + 18, tcx = cx;\n  tx(tcx, tY, title, 4, 'TEXT', {ha: 'c', bold: true});\n  tx(tcx, tY - 6, 'SCALE 1:' + sc, 3, 'TEXT', {ha: 'c'});\n  ln(tcx - 55, tY - 1.5, tcx + 55, tY - 1.5, 'TEXT');\n  tx(tcx, tY - 10.5, 'ELEVATION' + (circ ? '' : ' (VIEW ON ' + (view === 'b' ? 'b' : 'h') + '-FACE)'), 2.2, 'TEXT', {ha: 'c'});\n\n  /* ======================= SECTIONS ======================= */\n  var sx0 = mg + 20;\n  var bandTop = H - mg - 6;\n  groups.forEach(function (g, gi) {\n    var S = g.S;\n    var wS = circ ? S.D : S.b, hS = circ ? S.D : S.h;\n    var sw = wS / ss, sh = hS / ss;\n    var boxW = Math.max(sw + 90, 120);\n    var cxs = sx0 + boxW / 2, cys = bandTop - 24 - sh / 2;\n    drawSection(S, g, cxs, cys);\n    sx0 += boxW + 6;\n  });\n\n  function drawSection(S, g, cxs, cys) {\n    var k = 1 / ss, phi = S.phi, dl = S.dl;\n    var bars = S.lay;\n    var wS = circ ? S.D : S.b, hS = circ ? S.D : S.h;\n    // outline\n    if (circ) {\n      ci(cxs, cys, wS / 2 * k, 'COL-OUTLINE', false);\n      ci(cxs, cys, (wS / 2 - cc - dl / 2) * k, 'COL-LINKS', false);\n      ci(cxs, cys, (wS / 2 - cc - dl) * k, 'COL-LINKS', false);\n    } else {\n      rect(cxs - wS / 2 * k, cys - hS / 2 * k, cxs + wS / 2 * k, cys + hS / 2 * k, 'COL-OUTLINE');\n      var ox = (wS / 2 - cc) * k, oy = (hS / 2 - cc) * k, ix = (wS / 2 - cc - dl) * k, iy = (hS / 2 - cc - dl) * k;\n      rect(cxs - ox, cys - oy, cxs + ox, cys + oy, 'COL-LINKS');\n      rect(cxs - ix, cys - iy, cxs + ix, cys + iy, 'COL-LINKS');\n      // 135 deg hook tails at top-left corner\n      var tl = Math.max(6 * dl, 75) * k, hk = Math.SQRT1_2;\n      ln(cxs - ox, cys + oy, cxs - ox + tl * hk, cys + oy - tl * hk, 'COL-LINKS');\n      ln(cxs - ix, cys + iy, cxs - ix + tl * hk, cys + iy - tl * hk, 'COL-LINKS');\n      // cross ties\n      if (S.xt && !S.xt.none) {\n        S.xt.v.forEach(function (i) {\n          var x = cxs + bars.top[i].x * k;\n          ln(x, cys + bars.yh * k + (phi / 2) * k, x, cys - bars.yh * k - (phi / 2) * k, 'COL-LINKS');\n          ln(x, cys + bars.yh * k + (phi / 2) * k, x + 4 * dl * k * hk, cys + bars.yh * k + (phi / 2) * k - 4 * dl * k * hk, 'COL-LINKS');\n          ln(x, cys - bars.yh * k - (phi / 2) * k, x - 4 * dl * k * hk, cys - bars.yh * k - (phi / 2) * k + 4 * dl * k * hk, 'COL-LINKS');\n        });\n        S.xt.h.forEach(function (j) {\n          var y = cys + bars.lft[j - 1].y * k;\n          ln(cxs - bars.xw * k - (phi / 2) * k, y, cxs + bars.xw * k + (phi / 2) * k, y, 'COL-LINKS');\n          ln(cxs - bars.xw * k - (phi / 2) * k, y, cxs - bars.xw * k - (phi / 2) * k + 4 * dl * k * hk, y - 4 * dl * k * hk, 'COL-LINKS');\n          ln(cxs + bars.xw * k + (phi / 2) * k, y, cxs + bars.xw * k + (phi / 2) * k - 4 * dl * k * hk, y + 4 * dl * k * hk, 'COL-LINKS');\n        });\n      }\n    }\n    // bars\n    bars.pts.forEach(function (p) { ci(cxs + p.x * k, cys + p.y * k, Math.max(0.55, phi / 2 * k), 'COL-BARS', true); });\n    // dims\n    var below = cys - hS / 2 * k - 6;\n    ln(cxs - wS / 2 * k, below, cxs + wS / 2 * k, below, 'DIMS');\n    tick(cxs - wS / 2 * k, below, 1); tick(cxs + wS / 2 * k, below, 1);\n    ln(cxs - wS / 2 * k, cys - hS / 2 * k - 1, cxs - wS / 2 * k, below - 1.5, 'DIMS'); ln(cxs + wS / 2 * k, cys - hS / 2 * k - 1, cxs + wS / 2 * k, below - 1.5, 'DIMS');\n    tx(cxs, below + 1, String(wS), 2.4, 'DIMS', {ha: 'c'});\n    if (!circ) {\n      var rgt = cxs + wS / 2 * k + 6;\n      ln(rgt, cys - hS / 2 * k, rgt, cys + hS / 2 * k, 'DIMS');\n      tick(rgt, cys - hS / 2 * k, 1); tick(rgt, cys + hS / 2 * k, 1);\n      ln(cxs + wS / 2 * k + 1, cys - hS / 2 * k, rgt + 1.5, cys - hS / 2 * k, 'DIMS'); ln(cxs + wS / 2 * k + 1, cys + hS / 2 * k, rgt + 1.5, cys + hS / 2 * k, 'DIMS');\n      tx(rgt - 1, cys, String(hS), 2.4, 'DIMS', {ha: 'c', rot: 90});\n    }\n    // cover note\n    tx(cxs - wS / 2 * k, cys + hS / 2 * k + 2, 'COVER ' + cc + ' TO ' + (aci ? 'TIES' : 'LINKS'), 1.8, 'DIMS');\n    // callouts: main bars and links\n    var st0 = g.storeys[0];\n    var Lift = lifts.filter(function (L) { return L.j === st0 + 1; })[0] || lifts[0];\n    var it = Lift.item;\n    var lx = cxs + wS / 2 * k + 18;\n    var p0 = bars.pts[0];\n    var txtBars = CD.callout(code, S.N, S.des, it ? it.mark : '--', '', letter);\n    var yA = cys + hS / 2 * k - 2;\n    pl([[cxs + p0.x * k, cys + p0.y * k], [lx - 3, yA], [lx + 28, yA]], false, 'CALLOUTS');\n    tx(lx - 2, yA + 0.9, txtBars + ' MAIN BARS', 2.2, 'CALLOUTS');\n    var ltxt = circ && Lift.helix ? ((aci ? 'SPIRAL ' : 'HELIX ') + CD.barLabel(code, S.linkDes, letter) + ' @' + Lift.pitch + ' (' + (Lift.item_link ? Lift.item_link.mark : '') + ')') : (CD.barLabel(code, S.linkDes, letter) + '-' + (Lift.item_link ? Lift.item_link.mark : '') + ' ' + (aci ? 'TIES' : 'LINKS') + ' @' + Lift.pitch);\n    var yB = yA - 6;\n    var pl0 = circ ? {x: (wS / 2 - cc - dl / 2) * 0.7071, y: (wS / 2 - cc - dl / 2) * 0.7071} : {x: wS / 2 - cc - dl / 2, y: hS / 2 - cc - dl / 2};\n    pl([[cxs + pl0.x * k, cys - pl0.y * k], [lx - 3, yB], [lx + 28, yB]], false, 'CALLOUTS');\n    tx(lx - 2, yB + 0.9, ltxt, 2.2, 'CALLOUTS');\n    if (S.xt && !S.xt.none) {\n      var ct = (S.xt.v.length + S.xt.h.length) + ' No. CROSS-TIES ' + CD.barLabel(code, S.linkDes, letter) + (Lift.xtV ? '-' + Lift.xtV.mark : (Lift.xtH ? '-' + Lift.xtH.mark : '')) + ' @' + Lift.pitch;\n      tx(lx - 2, yB - 6 + 0.9, ct, 2, 'CALLOUTS');\n    }\n    // titles\n    var names = g.storeys.map(function (i) { return col.st[i].name; });\n    var rng = names.length > 1 ? names[0] + ' TO ' + names[names.length - 1] : names[0];\n    var ty = cys - hS / 2 * k - 16;\n    tx(cxs, ty, 'SECTION ' + g.id, 3.4, 'TEXT', {ha: 'c', bold: true});\n    ln(cxs - 25, ty - 1.2, cxs + 25, ty - 1.2, 'TEXT');\n    tx(cxs, ty - 5, '(' + rng + ')', 2, 'TEXT', {ha: 'c'});\n    tx(cxs, ty - 9, 'SCALE 1:' + ss, 2.2, 'TEXT', {ha: 'c'});\n  }\n\n  /* ======================= FOOTING PLAN ======================= */\n  var px = rightZoneX, pyTop = topBandY1 - 10;\n  var Bf = ftg.B, Lf = ftg.L;\n  var ps = 10; [10, 20, 25, 30, 40, 50].some(function (s) { ps = s; return Math.max(Bf, Lf) / s <= 78; });\n  var pw = Bf / ps, ph = Lf / ps;\n  var pcx = px + 50 + pw / 2, pcy = pyTop - 12 - ph / 2;\n  var fxl = pcx - pw / 2 - (view === 'b' ? 0 : 0);\n  rect(pcx - pw / 2, pcy - ph / 2, pcx + pw / 2, pcy + ph / 2, 'FOOTING');\n  rect(pcx - (Bf + 2 * lp) / ps / 2, pcy - (Lf + 2 * lp) / ps / 2, pcx + (Bf + 2 * lp) / ps / 2, pcy + (Lf + 2 * lp) / ps / 2, 'FOOTING', 'dash');\n  var cxo = (ftg.ex || 0) / ps;\n  var colW = (circ ? S0.D : S0.b) / ps, colH = (circ ? S0.D : S0.h) / ps;\n  var ccx = pcx - cxo;\n  if (circ) ci(ccx, pcy, colW / 2, 'COL-OUTLINE', false); else rect(ccx - colW / 2, pcy - colH / 2, ccx + colW / 2, pcy + colH / 2, 'COL-OUTLINE');\n  function planBars(key, dir, dash) {\n    var fb = M.ftgBars[key]; if (!fb) return;\n    var b = CD.bar(code, fb.des), c = M.coverFtg;\n    var nn = fb.n, i;\n    for (i = 0; i < nn; i++) {\n      if (dir === 'x') {\n        var yy = nn > 1 ? (-Lf / 2 + c + b.d / 2) + i * ((Lf - 2 * c - b.d) / (nn - 1)) : 0;\n        ln(pcx - (Bf / 2 - c) / ps, pcy + yy / ps, pcx + (Bf / 2 - c) / ps, pcy + yy / ps, 'FTG-BARS', dash ? 'dash' : '');\n      } else {\n        var xx = nn > 1 ? (-Bf / 2 + c + b.d / 2) + i * ((Bf - 2 * c - b.d) / (nn - 1)) : 0;\n        ln(pcx + xx / ps, pcy - (Lf / 2 - c) / ps, pcx + xx / ps, pcy + (Lf / 2 - c) / ps, 'FTG-BARS', dash ? 'dash' : '');\n      }\n    }\n  }\n  planBars('B1', 'x', false); planBars('B2', 'y', false); planBars('T1', 'x', true); planBars('T2', 'y', true);\n  // starters in plan\n  S0.lay.pts.forEach(function (p) { ci(ccx + p.x / ps, pcy + p.y / ps, Math.max(0.6, S0.phi / 2 / ps), 'COL-STARTER', true); });\n  // plan dims\n  var dy = pcy - ph / 2 - 6;\n  ln(pcx - pw / 2, dy, pcx + pw / 2, dy, 'DIMS'); tick(pcx - pw / 2, dy, 1); tick(pcx + pw / 2, dy, 1);\n  tx(pcx, dy + 1, String(Bf), 2.4, 'DIMS', {ha: 'c'});\n  var dx = pcx + pw / 2 + 6;\n  ln(dx, pcy - ph / 2, dx, pcy + ph / 2, 'DIMS'); tick(dx, pcy - ph / 2, 1); tick(dx, pcy + ph / 2, 1);\n  tx(dx - 1, pcy, String(Lf), 2.4, 'DIMS', {ha: 'c', rot: 90});\n  // plan callouts\n  var cy0 = pcy + ph / 2 - 2;\n  var lbl = [];\n  ['B1', 'B2', 'T1', 'T2'].forEach(function (k) {\n    var fb = M.ftgBars[k]; if (!fb) return;\n    lbl.push(k + ' (' + (fb.dir === 'x' ? '//X' : '//Y') + '): ' + CD.callout(code, fb.n, fb.des, fb.item.mark, Math.round(fb.pitch / 5) * 5, letter));\n  });\n  lbl.forEach(function (t, i) { tx(dx + 8, cy0 - i * 5, t, 2.3, 'CALLOUTS'); });\n  tx(pcx, pcy - ph / 2 - 16, (ftg.type === 'combined' ? 'COMBINED ' : '') + 'FOOTING PLAN', 3.2, 'TEXT', {ha: 'c', bold: true});\n  ln(pcx - 25, pcy - ph / 2 - 17.2, pcx + 25, pcy - ph / 2 - 17.2, 'TEXT');\n  tx(pcx, pcy - ph / 2 